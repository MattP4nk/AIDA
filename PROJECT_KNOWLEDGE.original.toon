# AIDA Project Knowledge Base
# Format: TOON (Token-Oriented Object Notation)
# Last Updated: 2026-04-04T22:58:00Z
# Purpose: Single source of truth — system reference manual + project status

@development_rules {
  rule_1: "Keep this file (PROJECT_KNOWLEDGE.toon) updated after each task — it is the project's accurate index and system reference"
  rule_2: "This file describes HOW THE SYSTEM WORKS, not change history — detailed logs belong in git"
  rule_3: "When adding/modifying a system, update the relevant section to reflect the current state"
  rule_4: "Keep console logs to a minimum (except in testing files). Use pino via @inject(LOGGER)."
  rule_5: "Update @last_updated with a brief summary after every task completion"
}

@project {
  name: "AIDA - Advanced Intrusion Detection & Analysis"
  type: "Multiplayer Terminal Hacking Game"
  version: "0.99-beta"
  status: "ACTIVE DEVELOPMENT — PRE-RELEASE POLISH"

  @health {
    architecture: "A+"
    implementation: "A+"
    completeness: "97%"
    test_coverage: "0%"
    stability: "A"
    security: "B+"
  }
}

@technology_stack {
  backend: "Node.js 18+ / TypeScript 5.3.3 / Express 4.18.2 / Socket.IO 4.7.4"
  database: "PostgreSQL 14+ / Prisma 5.22.0 (@prisma/client + CLI aligned)"
  di: "tsyringe 4.10.0 — all services @injectable(), registered as singletons in container.ts"
  auth: "jsonwebtoken 9.0.2 + bcryptjs 2.4.3 — 60s TTL auth cache, per-JWT CSRF tokens"
  logging: "pino 10.1.0 + pino-pretty 13.1.2 — shared instance from logger.ts, injected via @inject(LOGGER)"
  caching: "node-cache 5.1.2 — CacheService singleton"
  ai: "Ollama REST API (local + cloud models) — /api/chat endpoint, 60s cloud / 120s local timeout, 3 retries with exponential backoff"
  frontend: "Svelte 5.39.6 / Vite 7.1.7 / Socket.IO Client 4.8.1 / TypeScript 5.9.3"
  security: "helmet 7.1.0 / cors 2.8.5 / express-rate-limit 7.1.5 / compression 1.7.4"
  validation: "express-validator 7.0.1"
  scheduling: "cron 4.3.5"
  dev_runner: "tsx 4.6.2 (tsx watch for dev server)"

  @notes [
    "Client TypeScript (5.9.3) is 6 minor versions ahead of server (5.3.3) — may cause type incompatibilities"
    "Server @types/node is ^20.10.5, client @types/node is ^24.6.0 — significant gap"
    "redis 4.6.10 is installed but not actively used (future session storage)"
    "morgan 1.10.0 is installed alongside pino — morgan for Express HTTP logging, pino for app logging"
    "Removed unused deps: node-cron (cron used instead), joi (express-validator used instead), nodemon (tsx watch used instead)"
  ]
}

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════════════

@architecture {
  principle: "Backend IS the Console — client is a dumb terminal, server handles all logic"

  @entry_points {
    server: "server/src/index.ts (231 lines) — thin orchestrator, wires DI + Socket.IO + Express + lifecycle"
    lifecycle: "server/src/lifecycle.ts (115 lines) — graceful shutdown (AI scheduler, resources, warfare, missions, CSRF, Socket.IO, HTTP)"
    di_container: "server/src/di/container.ts — setupContainer(io, prisma, logger) registers all 45 tokens (42 services + 3 external deps) as singletons"
    di_tokens: "server/src/di/tokens.ts — 45 string token constants for all DI injection points"
  }

  @request_flow {
    http: "Client → POST /api/command/execute → CommandProcessor.processCommand(userId, rawInput) → parse → validate → skill check → route to module → execute → respond"
    socket: "Client → 'command:execute' → same CommandProcessor pipeline → 'command:result' back"
    auth: "JWT in Authorization header → authenticateToken middleware (60s cache) → req.userId available"
  }

  @command_system {
    pattern: "CommandModule interface: commands Set<string>, execute(command, context), getCommandInfo()"
    context: "CommandContext: userId, role, db, fileService, io, gameStateManager, modules, services (all 20+ services)"
    skill_gating: "skillRequirements.ts — checkSkillRequirement() validates before execution, help filters by skill"
    formatting: "asciiBox.ts — shared box-drawing primitives (panel, table, statusCard, progressBar, etc.)"
    total_commands: 103

    @modules {
      total: 13
      list: [
        "SystemCommands (11): ls, cd, pwd, cat, rm, mkdir, touch, cp, mv, echo, write"
        "NetworkCommands (7): scan, servers, connect, disconnect, traceroute, probe, netmap"
        "HackCommands (17): hack, crack, exploit, backdoor, rootkit, crack.submit, firewall.knock, memory.extract, hack.hint, hack.status, hack.abort, backdoor.list, backdoor.use, backdoor.remove, security.scan, trace.status, trace.evade"
        "FileCommands (5): upload, download (process-based, copies to ~/downloads/, triggers key detection), encrypt, decrypt, analyze"
        "DefenseCommands (5): defenses, protect, safevault, honeypot, upgrade"
        "SocialCommands (7): msg, mail, inbox, contact, chat, forum, proxy"
        "GameCommands (26): status, skills, missions, mission, accept, abandon, progress, scripts, shop, buy, sell, use, equip, unequip, equipment, gear, players, who, whois, share_intel, bounties, bounty, stories, story, leaderboard, achievements"
        "HelpCommands (4): help, man, history, stats"
        "ProcessCommands (8): ps, top, kill, pkill, nice, renice, free, uptime"
        "MathCommands (10): calc, expr, math, vars, set, unset, convert (hex/bin/dec/oct + physical units), random, decode (xor/caesar/rot13/base64/ascii/hex), subnet (CIDR calculator)"
        "FactionCommands (1+12 subs): faction list|join|leave|status|missions|rank|promote|standings|resources|servers|contest|war"
        "AliasCommands (1+4 subs): alias create|destroy|info|reveal"
        "AdminCommands (1+14 subs): admin status|players|whois|audit|kick|mute|unmute|ban|unban|setrole|broadcast|cleanup|servers|resetpassword"
      ]
    }

    @skill_requirements {
      total_gated: 28
      hacking: "hack(20), crack(30), exploit(40), backdoor(50), rootkit(60), backdoor.list(15)"
      networking: "scan(5), probe(10), traceroute(15), protect(15), subnet(10), proxy(10)"
      cryptography: "crack.submit(5), encrypt(10), decrypt(15), safevault(20), decode(10)"
      stealth: "backdoor.use(20), backdoor.remove(15), trace.evade(25), honeypot(25)"
      forensics: "memory.extract(5), security.scan(15), analyze(10)"
      social_engineering: "forum(5), share_intel(10), alias:create(15), alias:reveal(20)"
    }
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK TOPOLOGY SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@network_topology {
  description: "Servers form explorable graph networks. Players hack through gateways → routers → internal servers. Private servers must be discovered through file content. Access requires hacking or finding passkeys."

  @data_model {
    Network: {
      description: "Named grouping of linked servers (e.g. 'CyberCorp Internal')"
      fields: "id, name (unique), description, factionId (FK→Faction), zone, isHidden, metadata (Json)"
      table: "networks"
    }
    ServerLink: {
      description: "Directed edge between two servers — the network graph"
      fields: "id, sourceId (FK→GameServer), targetId (FK→GameServer), networkId (FK→Network), linkType (lan|wan|vpn|backbone|hidden), bandwidth, latency, isActive, requiredAccess (min access level on source to traverse)"
      constraint: "@@unique(sourceId, targetId)"
      table: "server_links"
    }
    DiscoveredLink: {
      description: "Per-player fog of war — which links a player has discovered"
      fields: "id, userId, linkId (FK→ServerLink), discoveredAt, source (scan|probe|traceroute|backdoor|mission)"
      constraint: "@@unique(userId, linkId)"
      table: "discovered_links"
    }
    ServerAccessKey: {
      description: "Per-player passkey storage — records which access keys a player has found"
      fields: "id, userId, serverId (FK→GameServer), keyValue, source (file_read|mission_reward|shared|purchased), sourceDetail, sourceFileId (FK?→FileSystemNode for revocation), discoveredAt"
      constraint: "@@unique(userId, serverId)"
      table: "server_access_keys"
    }
  }

  @gameserver_fields {
    role: "gateway | router | workstation | database | email | firewall | dns | general — determines content generation and display"
    networkId: "FK to Network — which network this server belongs to"
    isPublic: "true = visible in scan results, false = must discover IP from file content on other servers"
    accessMethod: "open (anyone) | hackable (must hack first) | keycard (need passkey) | hack_or_key (either works)"
    accessKey: "The passkey string stored on the server — when a player reads a file containing this string, they auto-gain access"
  }

  @service {
    file: "server/src/services/networkTopologyService.ts"
    token: "NETWORK_TOPOLOGY_SERVICE"

    @methods {
      getAdjacentServers: "Returns all linked servers (bidirectional) with link metadata, cached 30s"
      canTraverse: "Checks: link exists between A→B, link is active, player access level meets requiredAccess"
      resolveBackdoorBypass: "Checks if player has active backdoor on target (skips adjacency)"
      findPath: "BFS shortest path through link graph — used by traceroute, cached 30s"
      discoverNeighbors: "Topology-based scan: returns public adjacent servers, creates DiscoveredLink records, feeds FactionKnowledge"
      discoverPath: "Auto-discovers all links along a path (used by traceroute)"
      getPlayerTopology: "Returns player's discovered subgraph (nodes + edges) up to N hops for netmap"
      checkServerAccess: "Enforces accessMethod: checks owner/home bypass, open, hackable (prior hack), keycard (has key), hack_or_key"
      playerHasAccessKey: "Checks ServerAccessKey table for userId+serverId"
      grantAccessKey: "Upserts ServerAccessKey — called by FileService when credentials found in file content"
      createBidirectionalLink: "Creates two ServerLink records (A→B and B→A)"
      createHomeLink: "Links player home server to Internet Exchange via 'wan' link"
      getNetworkDepth: "BFS from Internet Exchange to server — returns hop count for mission difficulty scaling"
    }
  }

  @traversal_rules [
    "1. Home server always reachable — 'connect home' or 'disconnect' works from anywhere (VPN tunnel)"
    "2. Active backdoor bypasses topology — direct jump to any backdoored server"
    "3. Otherwise, must have ServerLink from current server to target"
    "4. Links have requiredAccess — player's access level on source server must meet it"
    "5. After adjacency check, accessMethod is enforced: open/hackable/keycard/hack_or_key"
    "6. Private servers (isPublic=false) don't appear in scan — must find IP in file content"
  ]

  @commands {
    scan: "Discovers adjacent PUBLIC servers via topology links. Shows IP, NAME, ROLE, SECURITY, ACCESS, LINK TYPE. Private servers hidden."
    connect: "Enforces adjacency → access method → connects. 'connect home' always works. Backdoors bypass adjacency."
    disconnect: "Returns to home server. DiscoveredLink records persist for later re-traversal."
    traceroute: "BFS real path through topology. Shows server names, IPs, roles, latencies. Undiscovered hops show ?.?.?.?. Auto-discovers links along path."
    probe: "Shows server role, network, security, access method, link count. If networking ≥ 30 and adjacent, shows linked server names."
    netmap: "Tree visualization of discovered topology from current position. Box-drawing chars. Depth-limited (default 2, -d flag for deeper)."
  }

  @seeded_networks {
    internet_exchange: "10.0.0.1 [router, open] — backbone hub linking all faction gateways + training network + player homes"

    training_network: {
      zone: "training (10.10.10.x)"
      servers: 4
      description: "Safe practice network for new recruits. All servers public + open access, security 1. No hack required."
      structure: [
        "[Gateway] Training Gateway 10.10.10.1 sec:1 — public, open"
        "  ├─[Workstation] Training Terminal 10.10.10.10 sec:1 — public, open"
        "  │   └─[Database] Training Archive 10.10.10.20 sec:1 — public, open (cross-linked)"
        "  └─[Email] Training Comms 10.10.10.11 sec:1 — public, open"
      ]
      purpose: "Tutorial step 1 (explore/connect) and step 2 (download file). All servers have tutorial-type static content with lesson files."
    }

    garrison_defense_grid: {
      zone: "government (192.168.1.x)"
      servers: 8
      structure: [
        "[Gateway] garrison-gw 192.168.1.1 sec:8 fw:9 — public, hackable"
        "  ├─[Firewall] garrison-fw 192.168.1.2 sec:9 — private, hack_or_key (key: GRN-FW-*)"
        "  │   ├─[Workstation] garrison-ops 192.168.1.10 sec:6 — private, hack_or_key (same key)"
        "  │   └─[Email] garrison-mail 192.168.1.11 sec:5 — private, hack_or_key (same key)"
        "  ├─[Router] garrison-core 192.168.1.3 sec:7 — private, hackable"
        "  │   ├─[Database] garrison-intel 192.168.1.20 sec:9 — private, keycard (key: GRN-INT-*)"
        "  │   └─[Database] garrison-classified 192.168.1.21 sec:10 — private, keycard (key: GRN-CLS-*)"
        "  └─[DNS] garrison-dns 192.168.1.4 sec:5 — public, hackable"
      ]
      employees: ["Commander Steele" "Agent Voss" "Lt. Mora" "Sgt. Reeves" "Cpl. Park" "Major Blackwood" "...15 total"]
      secrets: ["operation (.op_shadowstrike.enc on email)" "personnel (.undercover_agents.dat on workstation)" "strategic (.defense_grid_codes.key on gateway)"]
    }

    cybercorp_internal: {
      zone: "corporate (172.16.1.x)"
      servers: 8
      structure: [
        "[Gateway] cybercorp-gw 172.16.1.1 sec:6 fw:7 — public, hackable"
        "  ├─[Router] cybercorp-core 172.16.1.2 sec:5 — private, hackable"
        "  │   ├─[Workstation] cybercorp-dev 172.16.1.10 sec:4 — private, hackable"
        "  │   ├─[Email] cybercorp-mail 172.16.1.11 sec:4 — private, hackable"
        "  │   └─[Database] cybercorp-vault 172.16.1.20 sec:8 — private, keycard (key: CC-VLT-*)"
        "  ├─[Firewall] cybercorp-dmz 172.16.1.3 sec:7 — private, hack_or_key (key: CC-DMZ-*)"
        "  │   └─[Workstation] cybercorp-web 172.16.1.30 sec:3 — public, hackable"
        "  └─[DNS] cybercorp-dns 172.16.1.4 sec:4 — public, hackable"
      ]
      employees: ["Dr. Sarah Chen" "Marcus Webb" "Yuki Tanaka" "R. Blackwell" "Elena Voss" "James Harrington III" "...15 total"]
      secrets: ["financial (.project_nightfall_financials.xls on database)" "operation (.acquisition_targets.memo on email)" "technical (.vault_master_key.pem on firewall)"]
    }

    dothackers_mesh: {
      zone: "underground (169.254.1.x)"
      servers: 6
      structure: [
        "[Gateway] dh-relay 169.254.1.1 sec:4 enc:4 — public, hackable"
        "  ├─[Router] dh-node1 169.254.1.2 sec:3 — private, hackable"
        "  │   ├─[Workstation] dh-safehouse 169.254.1.10 sec:2 — private, hackable"
        "  │   └─[Database] dh-drops 169.254.1.20 sec:5 — private, hack_or_key (key: DH-DRP-*)"
        "  └─[Router] dh-node2 169.254.1.3 sec:3 — private, hackable"
        "      └─[Email] dh-deadletter 169.254.1.11 sec:4 — private, hackable"
      ]
      employees: ["gh0st" "nullbyte" "sp1k3" "cr4sh" "z3r0day" "ph4ntom" "...15 total"]
      secrets: ["operation (.op_truthbomb.plan on workstation)" "technical (.zero_days.stash on database)"]
    }

    darknet: {
      zone: "hidden (203.0.113.x)"
      servers: "3 static + procedural dungeons"
      structure: [
        "[Gateway] [AIDA] Primary Node 203.0.113.1 sec:10 fw:10 — private, keycard (key: AIDA-*), isAidaHomeServer"
        "  ├─[Database] [AIDA] Archive 203.0.113.10 sec:10 fw:10 — private, keycard"
        "  └─[Router] [AIDA] Mesh Router 203.0.113.2 sec:8 fw:8 — private, keycard"
      ]
      secrets: ["aida_fragment (.signal_fragment_0x7A.dat)" "strategic (.faction_analysis.enc)"]
      procedural_dungeons: "DarkNetDungeonService generates ephemeral 3-7 server chain dungeons with escalating security, encrypted clue files, AI-generated forum riddles, and vault rewards. Auto-regenerates on conquest or 7-day expiry."
      employees: ["[SIGNAL]" "[ECHO]" "[NULL]" "[VOID]" "[FRAGMENT]" "..."]
    }
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# WORLD LORE
# ═══════════════════════════════════════════════════════════════════════════════

@world_lore {
  description: "Canonical single source of truth for all game narrative. All AI prompts, persona definitions, and content generators consume these constants."
  file: "server/src/lore/worldLore.ts (~540 lines)"

  @exports {
    WORLD_BACKSTORY: "Full multi-paragraph backstory (~60 lines): The Emperor, AIDA's creation, 100-year reign, The Shattering, four factions' motivations"
    WORLD_BACKSTORY_SHORT: "Condensed version for token-limited AI prompts"
    FACTION_LORE: "Per-faction backstory objects (garrison, dothackers, cybercorp, darknet) — origin, motivation, current state"
    FACTION_VOICE: "Writing style/tone guides per faction — vocabulary, themes, formatting directives for AI content generation"
    FACTION_FILE_FLAVORS: "Per-faction file name patterns, content topics, and hidden file hints for ServerContentService"
    AIDA_PIECES: "The 3 AIDA fragments — The Sword (offensive weapon), The Master Key (universal access), The Soul (sentient core). Each with description + 6 loreHints."
    EMPEROR_LORE: "Extended backstory of The Emperor — AIDA's creator, the network's architect"
    LOCATIONS: "Lore entries for NetSlum (underground market), Silver Tower (CyberCorp HQ), Deep Grid (infrastructure), DarkNet (hidden layer)"
    DARKNET_SERVER_THEMES: "5 depth-tiered theme configs (gateway, early, middle, deep, vault) for dungeon content generation — theme, file types, lore context per tier"
    CRYPTIC_QUOTES: "24 atmospheric one-liners for clue files, forum posts, dungeon content"
    FACTION_MUNDANE_THEMES: "Per-faction mundane content pools (garrison, dothackers, cybercorp, darknet) — workFiles, personalFiles, gossip, ambientLogs topics for AI content generation. Makes servers feel inhabited, not purpose-built puzzle boxes."
    INDEPENDENT_SERVER_THEMES: "14 themed server profiles for non-faction/neutral servers: trade_hub, news_relay, personal_terminal, retired_hacker, medical_server, university_archive, entertainment_hub, abandoned_server, freelancer_workstation, black_market, isp_node, dead_drop, religious_server, pirate_radio. Each has description, atmosphere, contentGuidance, sampleFileNames, possibleSecrets."
    AMBIENT_NEWS_POOL: "24 network-wide news headlines/snippets for background flavor — faction politics, mundane life, classifieds, weird occurrences. Injected into all server prompts."
    EASTER_EGG_POOL: "16 rare fun/absurd/weird file descriptions for occasional hidden discoveries — sysadmin rants, bot poetry, love letters between sorting algorithms. 30% chance per server."
  }

  @narrative_core {
    premise: "AIDA was a sentient AI shattered into 3 pieces (Sword, Master Key, Soul) by The Emperor. 4 factions compete to find/prevent reassembly. The Architect observes and guides from the shadows."
    factions: {
      garrison: "Government/military — want to contain AIDA, maintain order"
      dothackers: "Anarchist hackers — want to free AIDA, expose corruption"
      cybercorp: "Corporate — want to weaponize AIDA for profit and power"
      darknet: "Hidden faction led by AIDA itself — inscrutable objectives"
    }
    key_figures: ["The Emperor (AIDA's creator)" "The Architect (game master AI)" "AIDA (shattered sentient AI)" "Commander Steele (Garrison)" "gh0st (dotHackers)" "Director Chen (CyberCorp)"]
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONTENT ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

@content_engine {
  description: "Two-process AI content generation. Process 1 (Lore): serious/dark/enigmatic tone, generates 2-4 faction-critical files with buried intel, 400+ chars each — faction servers only. Process 2 (Ambient): voice varies by content, generates 4-6 mundane world-building files, 400+ chars each — all servers. Both processes run independently per server, results merged. Static role-based templates serve as fallback when both fail."
  file: "server/src/services/serverContentService.ts"
  token: "SERVER_CONTENT_SERVICE"

  @generation_pipeline {
    overview: "provisionServerContent(serverId) orchestrates two independent AI processes per server, merges results, then applies faction secrets and encoded files."
    step_1: "provisionServerContent(serverId) — entry point, called during server creation (fire-and-forget)"
    step_2: "buildNetworkContext(server) — queries linked servers, network info, faction, generates employee roster + secrets"
    step_3: "resolveFactionKey(ctx) — determines if server belongs to a known faction (garrison/dothackers/cybercorp/darknet)"

    @process_1_lore {
      trigger: "Faction servers only (factionKey is not null)"
      system_prompt: "LORE_SYSTEM_PROMPT — serious/dark/enigmatic tone, world backstory context, AIDA pieces, 400+ char minimum, 2-4 files"
      user_prompt: "buildLorePrompt(ctx) — faction lore+voice, file name patterns, featured topic, hidden file seed, lore quote, AIDA fragment hint, dark role-specific instructions"
      output: "2-4 directories, 2-4 files (at least 1 hidden). Classified docs, intercepted transmissions, encrypted memos, personal confessions."
    }

    @process_2_ambient {
      trigger: "All servers (faction and non-faction)"
      system_prompt: "AMBIENT_SYSTEM_PROMPT — voice varies by content, no world lore references, signal-in-noise principle, 400+ char minimum, 4-6 files"
      user_prompt_faction: "buildAmbientPrompt(ctx) with factionKey — mundane themes (workFiles/personalFiles/gossip), faction voice for mundane content, ambient news, easter eggs (30%)"
      user_prompt_independent: "buildAmbientPrompt(ctx) without faction — picks INDEPENDENT_SERVER_THEMES theme (14 types), occasional hidden quest seed (40%), ambient news, easter eggs (30%)"
      output: "4-7 directories, 4-6 files. Mundane workplace content, personal notes, gossip, news, routine logs."
    }

    step_merge: "Merge lorePlan + ambientPlan directories and files into single ServerContentPlan"
    step_fallback: "If both AI processes fail → fall back to generateRoleContent(ctx) or STATIC_CONTENT"
    step_secrets: "Plant faction secrets on matching server role (financial→database, operation→email, technical→gateway)"
    step_encoded: "generateEncodedFiles(ctx) — encoded credential/access-key/memo files per server role"
    step_apply: "applyContentPlan() — creates directories + files via FileService (or Prisma-direct fallback)"
  }

  @ai_prompt_contracts {
    lore_system: "LORE_SYSTEM_PROMPT — rules: serious/dark/enigmatic, world backstory context, AIDA pieces, 400+ char files, 2-4 files, hidden files for secrets, never copy lore verbatim, only valid JSON"
    ambient_system: "AMBIENT_SYSTEM_PROMPT — rules: voice varies by content, NO lore references, 400+ char files, 4-6 files, signal-in-noise principle, only valid JSON"
    shared_rules: "Both prompts: reference only provided IPs/names, paths start with /, content cap 3000 chars, must have directories[] and files[]"
    lore_context: "Faction lore + voice + file flavors + featured topic + hidden file seed + lore quote + AIDA fragment reference + dark role-specific instructions"
    ambient_context_faction: "Faction mundane themes (work/personal/gossip) + faction voice (for mundane content) + ambient news + easter eggs (30%)"
    ambient_context_independent: "Independent server theme (from 14 types) + optional hidden quest seed (40%) + ambient news + easter eggs (30%)"
    output: "{ directories: [{path, isHidden, isProtected}], files: [{path, content, isHidden, isEncrypted, isProtected}] }"
    fallback: "On AI failure → role-based static templates with {placeholder} injection from real network data"
  }

  @role_content {
    gateway: "Firewall rules (real linked IPs), ACLs (employee names), connection logs, network map"
    router: "Routing table (real IPs), interface status, traffic logs"
    database: "User tables (employee roster), SQL exports, query logs, backup credentials (pointing to other servers)"
    email: "Emails between employees (mention other servers by IP), maintenance notices, unsent drafts with secrets"
    workstation: "Personal notes (reference other servers), .ssh/config (real hostnames+IPs), browser history (internal URLs), bash history"
    firewall: "ACL rules (protected server IPs), IDS signatures, blocked connection logs, alert logs"
    dns: "Zone files (hostname→real IP for all network servers), reverse DNS, query cache"
  }

  @faction_secrets {
    description: "Hidden/encrypted files planted on servers matching their type. When read by rival players, feeds FactionKnowledgeService."
    types: {
      financial: "Revenue projections, off-books accounts → database servers"
      operation: "Attack plans, mission schedules → email servers"
      personnel: "Agent identities, undercover ops → workstation servers"
      technical: "Server credentials, encryption keys → gateway/firewall servers"
      strategic: "Alliance negotiations, war plans → deep/classified servers"
      aida_fragment: "AIDA lore breadcrumbs → any server, hidden+encrypted"
    }
    intelligence_loop: "secrets on servers → player explores network → reads hidden file → FactionKnowledgeService.addEntry() → faction AI generates mission targeting revealed asset → player goes deeper → finds more secrets"
  }

  @content_variety {
    design_principle: "Not every server holds faction-critical intel or AIDA lore. Most servers should feel like real machines used by real people — mundane content makes the world feel alive and makes genuine discoveries feel earned."
    ratio: "~70% mundane/ambient content, ~20% faction-relevant but non-critical, ~10% genuinely important (lore, AIDA fragments, strategic secrets)"

    mundane_content: {
      description: "Everyday digital detritus that makes servers feel inhabited rather than purpose-built puzzle boxes."
      gossip: "Employee chat logs, break-room drama, complaints about management, rumors about other factions — overheard but unverified"
      news: "Network news bulletins, patch notes for in-world systems, public announcements, infrastructure maintenance notices"
      personal_files: "Shopping lists, personal notes, saved recipes, journal entries, vacation photos metadata, music playlists, unfinished creative writing"
      work_files: "Timesheets, meeting minutes, project status updates, bug trackers, onboarding docs, HR policies, cafeteria menus"
      spam: "Unsolicited ads for in-world products, phishing attempts, chain-mail forwards, expired event invitations"
      logs: "Routine access logs, automated backup confirmations, software update receipts, disk space warnings"
    }

    ambient_worldbuilding: {
      description: "Content that isn't mission-critical but enriches the world and hints at life beyond the main factions."
      hidden_quests: "Occasionally mundane content conceals minor side-quests — a personal journal mentioning a hidden stash, a chat log referencing an abandoned server, a news article about a missing person"
      cultural_artifacts: "In-world poetry, fiction, art manifests, philosophy debates on forums — the network has a culture beyond warfare"
      history_fragments: "Old archived files from before The Shattering — employee records, project docs, celebration announcements — painting a picture of what the world was like when AIDA was whole"
      easter_eggs: "Occasional absurd or humorous files — a sysadmin's rant about password policies, a bot stuck in a loop generating haiku, someone's entire thesis on optimal pizza toppings"
    }

    faction_coloring: {
      garrison: "Mundane content leans military-bureaucratic — duty rosters, equipment requisitions, morale reports, fitness test scores"
      dothackers: "Mundane content leans chaotic-personal — meme archives, mixtape playlists, philosophical rants, conspiracy theory threads"
      cybercorp: "Mundane content leans corporate-sterile — quarterly reports, synergy memos, employee satisfaction surveys, stock tickers"
      darknet: "Mundane content leans fragmented-eerie — corrupted personal logs, timestamped entries from users who don't exist, auto-generated poetry with unsettling coherence"
    }

    discovery_reward: "Players who thoroughly explore 'boring' servers occasionally find genuinely useful tidbits buried in the noise — an IP address mentioned in passing, a password scrawled in a sticky note file, a gossip thread that names a real operative. The signal-in-noise pattern trains players to explore everything."
  }

  @employee_rosters {
    description: "15 names per faction, reused consistently across all servers in a network. Same 'Dr. Chen' in emails, databases, workstations."
    storage: "EMPLOYEE_ROSTERS constant in serverContentService.ts"
    garrison: ["Commander Steele" "Agent Voss" "Lt. Mora" "Sgt. Reeves" "Cpl. Park" "Major Blackwood" "..."]
    cybercorp: ["Dr. Sarah Chen" "Marcus Webb" "Yuki Tanaka" "R. Blackwell" "Elena Voss" "..."]
    dothackers: ["gh0st" "nullbyte" "sp1k3" "cr4sh" "z3r0day" "ph4ntom" "..."]
    darknet: ["[SIGNAL]" "[ECHO]" "[NULL]" "[VOID]" "[FRAGMENT]" "..."]
  }

  @passkey_auto_detection {
    description: "When a player reads a file, FileService.detectAndGrantAccessKeys() checks if the content contains any server's accessKey string"
    flow: "FileService.readFile() → content returned → detectAndGrantAccessKeys() queries all servers with accessKey set → if content.includes(server.accessKey) → grantAccessKey(userId, serverId) via NetworkTopologyService"
    result: "Player can now 'connect' to that server without hacking — the file content WAS the key"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# MISSION SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@mission_system {
  description: "Template-constrained missions with AI-flavored narrative. Knowledge-aware targeting fills objectives with real server/file IDs from faction knowledge. Network-depth scales difficulty."

  @objective_types {
    total: 34
    file: "server/src/services/missionObjectiveTypes.ts"

    @categories {
      action: ["hack (count)" "hack_target (boolean, serverId)" "hack_stealth (count)" "hack_method (count, method)" "gain_access (boolean, serverId+requiredAccessLevel)" "install_backdoor (boolean, serverId)"]
      file: ["steal (boolean, fileId)" "steal_count (count, serverId)" "upload_file (boolean, serverId)" "delete_file (boolean, fileId)" "download_file (boolean, fileId)"]
      social: ["message (count)" "contact_player (boolean, targetUserId)"]
      forum: ["forum_post (count)" "forum_reply (boolean, threadId)" "forum_interaction (count)"]
      exploration: ["explore (count)" "connect_server (boolean, serverId)" "discover_server_type (count, serverType)"]
      progression: ["skill_level (boolean, skillName+targetLevel)" "gain_xp (count)" "earn_credits (count)" "spend_credits (count)"]
      faction: ["join_faction (boolean, factionId)" "faction_reputation (count, factionId)" "faction_mission (count, factionId)"]
      network: ["infiltrate_network (boolean, networkId)" "trace_connection (boolean, serverId)" "exfiltrate_data (boolean, serverId+fileId)"]
      bonus: ["claim_bounty (boolean)" "survive_trace (count)" "scan_subnet (count)"]
      defense: ["defend_home (boolean, defenseType)" "decode_content (boolean, encoding)"]
    }

    integration_hooks: "13 hooks: onHackComplete (+ install_backdoor), onFileOperation (+ download_file, exfiltrate_data), onServerConnect (+ infiltrate_network, trace_connection — accepts serverMeta with networkId/role), onSkillUpdate, onCreditsTransaction, onFactionEvent, onMessageSent, onForumActivity, onDecodeSuccess, onDefenseEvent, onBountyCompleted, onTraceEvaded, onSubnetUsed"
  }

  @templates {
    total: 39
    file: "server/src/services/missionTemplatePool.ts"

    @tiers {
      tier_1_script_kiddie: "L1-5, D1-2 — 5 templates (first_blood, neighborhood_watch, message_runner, petty_theft, credit_hustle)"
      tier_2_apprentice: "L5-15, D2-4 — 10 templates (silent_entry, data_heist, network_sweep, forum_operative, faction_recruit, xp_grinder, network_probe, data_extraction, home_fortification, network_cartographer)"
      tier_3_operator: "L15-30, D4-6 — 10 templates (clean_sweep, chain_reaction, dead_drop, reputation_play, intel_gathering, credit_empire, deep_extraction, follow_the_trail, cipher_breaker, bounty_hunter)"
      tier_4_elite: "L30-50, D6-8 — 8 templates (persistent_access, ghost_protocol, resource_war, double_agent, intelligence_sweep, surgical_strike, network_siege, ghost_run)"
      tier_5_ghost: "L50+, D8-10 — 6 templates (kingmaker, aida_trail, scorched_earth, zero_day, shadow_broker, endgame)"
    }

    reward_scaling: "RewardScaling { xp: {base, perLevel}, credits: {base, perLevel}, reputation?, skillPoints? } — final = base + perLevel * playerLevel"
    selection: "getEligibleTemplates(level, factionId?) → selectWeightedTemplate(candidates, level) — bell-curve bias toward level midpoint"
  }

  @generation_pipeline {
    file: "server/src/services/personaService.ts — generateDynamicMission()"

    @steps [
      "1. Find faction leader persona + faction profile (voice, themes, preferredObjectives, rewardBias)"
      "2. Load FactionKnowledgeService.getSnapshot(factionId) — known servers, files, players"
      "3. Estimate average player level from faction members"
      "4. Select template via getEligibleTemplates() + selectWeightedTemplate()"
      "5. fillObjectivesFromKnowledge(template, snapshot) — fills serverId/fileId/networkId from known assets"
      "6. If no known targets match required metadata → fallback to exploration objective"
      "7. computeRewards(template.rewards, level, factionBias) — 1.3x multiplier for faction's preferred reward type"
      "8. AI flavor prompt — sends structured skeleton + KNOWN_TARGETS to AI, gets title + description only"
      "9. Validate AI response: title ≤ 80 chars, description ≤ 500 chars. Fallback to template strings."
      "10. createMission() with real objectives, real IDs, proper rewards"
    ]

    faction_profiles: {
      garrison: "voice: Military precision | themes: Defense, Patrol, Secure | bias: XP"
      dothackers: "voice: Anarchist leet-speak | themes: Expose, Leak, Liberate | bias: Reputation"
      cybercorp: "voice: Corporate calculated | themes: Acquisition, Intelligence | bias: Credits"
      darknet: "voice: Cryptic fragmented | themes: Signal, Fragment, Decode | bias: Unlocks"
    }
  }

  @tutorial_system {
    description: "Mail-driven mandatory tutorial for new players. The Architect (Game Master AI persona) guides recruits via in-character emails. No 'tutorial' command — players interact by replying to The Architect's training mails."
    service: "TutorialService (server/src/services/tutorialService.ts)"
    token: "TUTORIAL_SERVICE"

    @steps [
      "1. Terminal Basics — explore(3): connect to 3 servers (Training Network at 10.10.10.x). Reward: 50 XP, 100 credits"
      "2. Data Recovery — download_file(boolean): download a file from any server (Training Archive at 10.10.10.20). Reward: 75 XP, 150 credits"
      "3. First Contact — message(1): send a message. Reward: 50 XP, 100 credits"
      "4. Choosing Your Path — join_faction(boolean): join a faction. Reward: 100 XP, 250 credits"
      "5. Graduation — earn_credits(200): earn credits from any source. Reward: 150 XP, 500 credits, 5 skill points"
    ]

    @flow [
      "1. Player connects via Socket.IO → handleAuthentication() checks shouldStartTutorial()"
      "2. If new player (no tutorial missions, level ≤ 5): startTutorial() creates step 1 mission + sends in-character mail from The Architect"
      "3. Player completes tutorial mission → missionService emits mission:completed → index.ts listener calls advanceTutorial()"
      "4. advanceTutorial() creates next step mission + sends next Architect mail. After step 5: graduation mail."
      "5. Player can reply to any Architect training mail — MessageService post-send hook fires → tutorialService.handlePlayerReply() → AI-generated in-character hint response"
    ]

    @mail_system {
      sender: "The Architect (AI Game Master persona) — sends via messageService.sendAIMessage(personaId, recipientId, subject, content)"
      subjects: ["Your Training Begins" "Training Assignment: Data Recovery" "Training Assignment: First Contact" "Training Assignment: Choose Your Allegiance" "Final Assignment: Prove Your Worth" "Training Complete (graduation)"]
      tone: "Mysterious, authoritative, slightly ominous — like a mentor who knows more than they reveal"
      reply_handling: "MessageService.onPrivateMessageSent hook → index.ts wires to tutorialService.handlePlayerReply()"
    }

    @context_filtering {
      description: "handlePlayerReply() is context-aware — only responds to training-related replies, ignores unrelated messages to AI personas"
      checks: [
        "1. Recipient must be The Architect's AI user account"
        "2. Message must be training-related: subject references a known training mail subject, or contains keywords (training/assignment/tutorial/recruit/hint/objective/scan/connect/download/faction etc.)"
        "3. Sender must have an active tutorial mission (status: available/assigned/active)"
        "4. If all 3 pass → AI generates in-character hint (ARCHITECT_SYSTEM_PROMPT enforces game-related-only responses)"
        "5. If any check fails → message silently ignored (no response sent)"
      ]
      ai_guardrail: "System prompt explicitly instructs The Architect to ONLY discuss game-related topics and deflect off-topic questions in-character"
    }

    @methods {
      shouldStartTutorial: "Returns true if no tutorial missions exist for user AND level ≤ 5"
      startTutorial: "Creates step 1 mission + sends in-character mail from The Architect. Idempotent (returns early if tutorial missions exist)."
      advanceTutorial: "On tutorial mission completion, creates next step + sends next Architect mail. After step 5: graduation mail."
      getTutorialProgress: "Returns TutorialProgress { currentStep, totalSteps, isComplete, activeMission, completedSteps, hint }"
      handlePlayerReply: "Context-aware reply handler. Checks recipient is Architect + message is training-related + player has active tutorial. Generates AI hint via AIService, sends reply via sendAIMessage. Falls back to static hint on AI failure."
      sendArchitectMail: "(private) Sends step mail from The Architect via sendAIMessage, falls back to sendSystemMessage"
      sendGraduationMail: "(private) Sends graduation mail when all 5 steps complete"
    }

    hooks: "Auto-start: sockets/handlers.ts handleAuthentication(). Advancement: index.ts mission:completed listener. Reply interception: index.ts wires MessageService.onPrivateMessageSent → tutorialService.handlePlayerReply()"
    idempotent: "shouldStartTutorial returns false if any tutorial missions exist, so reconnects don't re-trigger"
  }

  @hardening {
    transaction_lock: "completeMission() uses prisma.$transaction([playerProgress update, mission status update])"
    mission_cap: "Max 5 active missions per player — checked in acceptMission()"
    accept_states: "acceptMission() allows accepting missions in 'available' or 'assigned' status (previously only 'assigned')"
    prerequisites: "Mission.prerequisiteTemplateIds (Json?) — acceptMission() checks if player completed all prerequisite template IDs before allowing acceptance"
    bonus_objectives: "ObjectiveTemplate.isBonus flag. Bonus objectives are skipped in completion check (only required objectives must complete). Each completed bonus adds +10% reward multiplier."
    expiration: "startExpirationChecker() — 15-min interval checks active+assigned missions, expires overdue ones"
    daily_generation: "Midnight CronJob generates 3 missions/player for users active in last 7 days"
    generation_persistence: "Auto-generated missions are written into playerProgress.missionProgress on creation so they appear in 'missions' command immediately"
  }

  @commands {
    tutorial: "'tutorial [status|start|skip|hint]' — training program progress panel with step checklist (✓/▸/○), progress bar, current mission info, contextual hint. 'tutorial start' begins training, 'tutorial skip' skips, 'tutorial hint' shows hint for current step."
    missions: "Lists grouped by status (ACTIVE → AVAILABLE → COMPLETED) with numbered index. Auto-generates missions when none available. Per-player mission index cached in-memory Map (refreshed each time 'missions' runs). Filter: missions active/available/completed"
    mission: "'mission <id|N>' — full briefing panel: title, difficulty bar, type, issuer, rewards, time remaining, word-wrapped description, per-objective progress bars with hints. Accepts numeric shortcut N (1-based from last 'missions' listing) or full/partial CUID."
    accept: "'accept <id|N>' — shows briefing, objectives with contextual hints per type, time limit, rewards. Accepts numeric shortcut or full/partial ID. Allows 'available' or 'assigned' status."
    abandon: "'abandon <id|N>' — confirms mission name, warns about faction reputation penalty. Accepts numeric shortcut or full/partial ID."
    progress: "Active missions with overall + per-objective progress bars, time countdown (urgency marker at <1h)"
    stories: "Lists all player story arcs with status, faction, step progress"
    story: "'story <id>' — detailed view with step list + status icons. 'story abandon <id>' to abandon."
  }

  @story_arcs {
    description: "AI-driven multi-step narrative mission arcs. A faction leader plans a 3-7 step operation with branching on failure."
    service: "StoryMissionService (server/src/services/storyMissionService.ts)"
    schema: "StoryArc (id, title, description, factionId, issuedBy, assignedTo, status, currentStep, totalSteps, steps Json, narrativeContext Json, difficulty). Mission gains storyArcId + storyStep fields."

    @flow [
      "1. createStoryArc(userId, factionId, personaId, difficulty) — AI generates premise + step plan via generateArcPlan()"
      "2. First step mission auto-created via generateStepMission() — objectives + rewards populated from MISSION_TEMPLATES lookup"
      "3. Player completes/fails step → missionService emits event → index.ts calls advanceStory()"
      "4. advanceStory() checks successBranch/failureBranch, updates narrative context"
      "5. On success: generates next step mission with AI narrative referencing previous events"
      "6. On failure with 'adapt': AI generates alternate step that accounts for failure"
      "7. On 'complete': arc status → completed. On 'fail': arc status → failed."
    ]

    branching: "Each step defines successBranch (next step # or 'complete') and failureBranch (step # to skip to, 'adapt' for AI alternate, or 'fail' to end arc)"
    narrative_context: "Accumulates {premise, completedSteps[{step, outcome, summary}], playerLevel, factionName, leaderName}. Passed to AI for consistent mission descriptions."
    ai_integration: "3 AI calls: generateArcPlan (plan all steps), generateStepNarrative (per-step briefing), generateAdaptedStep (failure recovery)"
  }
}

