# ═══════════════════════════════════════════════════════════════════════════════
# PLAYER COMPUTER RESOURCE SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@resource_system {
  description: "Player's terminal has limited CPU, RAM, and Bandwidth. Actions like hacking, scanning, decrypting become background processes that consume resources and take real time. Passive consumers (terminals, connections, backdoors) create ongoing drain."
  file: "server/src/services/memoryService.ts"

  @computer_spec {
    description: "Derived from player level + equipped hardware items"
    base_stats: "Level 1: CPU 200, RAM 256MB, BW 100Mbps"
    scaling: "+100 CPU, +128MB RAM, +50Mbps BW per 10 levels"
    equipment: "Hardware shop items add flat bonuses (e.g. 'Quantum RAM' +256MB)"
  }

  @process_costs {
    hack_prep: "CPU 80, RAM 128MB, BW 50 — base 60s, hacking skill -1s/level, min 12s"
    scan: "CPU 40, RAM 32MB, BW 80 — base 15s, networking -0.5s/level, min 3s"
    decrypt: "CPU 100, RAM 64MB, BW 0 — base 45s, cryptography -1.5s/level, min 9s (with key: instant ~5s)"
    download: "CPU 10, RAM 64MB, BW 60 — base 10s, networking -0.3s/level, min 2s"
    backdoor_install: "CPU 60, RAM 96MB, BW 40 — base 90s, stealth -1.5s/level, min 18s"
    traceroute: "CPU 20, RAM 16MB, BW 40 — base 8s, networking -0.2s/level, min 2s"
    trace_evade: "CPU 70, RAM 64MB, BW 30 — base 30s, stealth -0.8s/level, min 6s"
  }

  @passive_consumers {
    terminal_tab: "CPU 5, RAM 16MB — each open terminal"
    server_connection: "RAM 8MB, BW 15Mbps — each active remote connection"
    active_backdoor: "CPU 5, RAM 8MB, BW 10Mbps — each backdoor you maintain"
    active_trace: "CPU 15, RAM 16MB, BW 5Mbps — when someone is tracing you"
    os_overhead: "CPU 10, RAM 24MB — always reserved"
  }

  @process_lifecycle {
    flow: "Command → canSpawnProcess() check → spawnGameProcess() → 1s tick loop updates progress → on complete fires callback + Socket.IO push"
    events: "process:started, process:progress (every 5s), process:completed, process:cancelled"
    all_process_commands: [
      "hack → hack_prep process → on complete calls hackService.initiateHackSession() → minigame pushed via Socket.IO"
      "scan → scan process → on complete calls discoverNeighbors() → results pushed"
      "decrypt → decrypt process (fast with key, slow brute force) → on complete decrypts file"
      "download → download process → copies file to ~/downloads/ + access key detection"
      "crack → decrypt process → on complete calls messageService.crackEncryption()"
      "exploit → hack_prep process → on complete calls processHackAttempt(EXPLOIT)"
      "backdoor → backdoor_install process → on complete calls processHackAttempt(BACKDOOR)"
      "rootkit → backdoor_install process (uses min of stealth/hacking skill) → on complete calls processHackAttempt(ROOTKIT)"
      "traceroute → traceroute process → on complete runs BFS path + auto-discovery + renders table"
      "trace.evade → trace_evade process → on complete calls traceService.evadeTrace()"
    ]
    instant_commands: "backdoor.use, backdoor.list, backdoor.remove, security.scan, trace.status — lightweight queries, no process needed"
  }

  @commands {
    ps: "Shows running GameProcesses with progress bars + passive consumers + resource usage summary"
    top: "Resource dashboard: CPU/RAM/BW bars with usage percentages + process list"
    kill: "Cancels a GameProcess by PID, immediately frees resources"
    free: "RAM usage breakdown with progress bar"
    uptime: "Session uptime + process count + resource summary"
  }

  @hardware_shop_items {
    tier_1: "RAM Module Mk1 (+64MB, 500c), CPU Fan (+50 CPU, 750c), Network Card Mk1 (+25 BW, 600c)"
    tier_2: "RAM Module Mk2 (+128MB, 2000c), CPU Overclock (+100 CPU, 2500c), Fiber Uplink (+100 BW, 2200c)"
    tier_3: "Quantum RAM (+256MB, 7500c), Neural Coprocessor (+200 CPU, 8000c), Darknet Relay (+200 BW, 9000c)"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# SERVICES REFERENCE
# ═══════════════════════════════════════════════════════════════════════════════

@services {
  total: 43
  pattern: "@injectable() class, constructor with @inject() deps, registered as singleton in container.ts"
  di_tokens_total: 46
  di_registrations: "43 registerSingleton + 3 registerInstance (Logger, SocketIO, PrismaClient) = 46 total"

  @tutorial {
    TutorialService: "Mail-driven mandatory tutorial for new players. The Architect sends in-character training mails. Players reply for AI-generated hints (context-filtered: only training-related replies trigger responses). Injects AIService for hint generation. Methods: shouldStartTutorial, startTutorial, advanceTutorial, getTutorialProgress, handlePlayerReply."
  }

  @helper_files_not_in_di {
    hackMinigameGenerator: "server/src/services/hackMinigameGenerator.ts — internal utility used by HackService"
    missionObjectiveTypes: "server/src/services/missionObjectiveTypes.ts — type/data definitions (34 objective types)"
    missionTemplatePool: "server/src/services/missionTemplatePool.ts — data/config pool (39 templates)"
    tokenConsumption: "server/src/utils/tokenConsumption.ts — Token-gated AI persona messaging utility. AI_PERSONA_NAMES constant. isAIPersonaUsername/resolvePersonaName for persona lookup. findPersonaToken/consumeToken/checkAndConsumeToken for transactional token inventory management. shouldRequireToken routing decision (tutorial bypass for Architect). hasActiveTutorial check."
  }

  @core {
    GameStateManager: "Session management (in-memory Maps), game state sync, player↔server connection tracking"
    ProgressService: "Auto-save player progress on interval"
    EventService: "Game event pub/sub (EventEmitter-based), subscription cleanup every 5min"
    IPService: "IP allocation per zone (PLAYER 10.x, CORPORATE 172.16.x, GOVERNMENT 192.168.x, UNDERGROUND 169.254.x), player /16 subnet isolation"
    CommandProcessor: "Command parsing → validation → skill gating → module routing → execution. Rate limited (10 cmd/s)."
    CacheService: "In-memory key-value cache with TTL"
  }

  @network_and_content {
    ServerService: "Server CRUD, connectToServer (resolves IP or ID), discoverServers (subnet scan), security alerts, audit logging. Injects ServerContentService + MissionIntegrationService + FactionKnowledgeService."
    ServerContentService: "AI-first content generation with network context. provisionServerContent(), provisionAllNetworkServers(), provisionMissionInfrastructure(). Builds NetworkContext from linked servers, generates role-based content, plants faction secrets. Uses constructor-injected AIService (replaced dynamic getService<any>() pattern)."
    NetworkTopologyService: "Graph traversal, adjacency enforcement, BFS pathfinding, fog of war discovery, access control (open/hackable/keycard/hack_or_key), passkey management."
    FileService: "Virtual filesystem CRUD, encryption/decryption (AES-256-CBC), permission checking (bitmask), path traversal sandboxing. detectAndGrantAccessKeys() — public method, called on download (not cat/read), links discovered keys to source file via sourceFileId for revocation. deleteNode() handles access key revocation + honeypot alerts. Injects MissionIntegrationService + FactionKnowledgeService + NetworkTopologyService."
    DynamicContentService: "Event-driven content injection into server filesystems. 9 default hooks: hack:detected→security.log, hack:attempt→access.log, bounty:posted→wanted.txt, ids_alert→ids.log, honeypot:triggered→honeypot.log, war:declared→war_bulletin.txt, war:ended→war_bulletin.txt, mission:completed→operations.log, contest:resolved→territory.txt. Uses ContentEncoder for optional encoding. registerHook(event, generator) for extensibility. War hooks wired from warfareService, contest hook from contestService, mission hook from index.ts."
  }

  @utilities {
    ContentEncoder: "Pure utility (server/src/utils/contentEncoder.ts). Encodes text as base64/caesar/rot13/xor/hex/reverse/ascii. encodeWithMetadata() returns encoded string + hint + decode command. Template wrappers: credentialFile(), accessKeyFile(), logWithEncodedIP(), memoWithSecret(). randomEncoding(difficulty) for procedural content generation."
  }

  @utils_directory {
    description: "server/src/utils/ — 8 utility files"
    files: [
      "asciiAvatars.ts — Server-side avatar generation (single source of truth). 16 ASCII art templates (hacker1/2, elite, anonymous, default, corporate, security, scientist, bot, aida, system, garrison, dothackers, cybercorp, darknet, faction_leader). 16-entry color map. Deterministic selection via hashCode(name). AvatarData interface (server-internal). Functions: generateAvatar (decision tree: ai→system→npc→player with faction overrides), getCompactAvatar (first 5 lines), getInlineGlyph (faction-aware: [★_★] garrison, [#_#] dothackers, [$_$] cybercorp, [░◈░] darknet), formatAvatarBlock, renderAvatarWithInfo (side-by-side layout), renderMessageHeader, renderProfileCard, renderNotificationBadge. Used by MessageService (avatar payloads in message:received/new_mail), gameCommands (status/whois/players glyphs), socialCommands (msg/mail/forum glyphs)."
      "auth.ts — authentication utilities"
      "contentEncoder.ts — encoding/decoding (base64/caesar/rot13/xor/hex/reverse/ascii)"
      "expressionEngine.ts — math expression evaluation engine (for calc/expr commands)"
      "ipUtils.ts — IP address utilities"
      "pathSanitizer.ts — path sanitization/security"
      "validators.ts — input validation helpers"
      "tokenConsumption.ts — token-gated AI persona messaging (5 canonical personas, token inventory lookup, transactional consume, tutorial bypass)"
    ]
  }

  @missions {
    MissionService: "Mission CRUD, assignMission (with 5-active cap), acceptMission (with prerequisite check), completeMission ($transaction, bonus objective tracking), abandonMission, expireMission, grantRewards. Emits mission:completed + mission:failed (abandon/expire) for story arc progression. 15-min expiration cron."
    MissionGeneratorService: "Procedural generation from 39 templates. selectTemplate() with deduplication, generateFromTemplate() with RewardScaling, generateAIMission() with canonical type validation. Midnight CronJob for daily generation. Provisions infrastructure via ServerContentService."
    MissionIntegrationService: "Connects game actions to objectives via 13 hooks: onHackComplete, onFileOperation (incl. download_file), onServerConnect, onSkillUpdate, onCreditsTransaction, onFactionEvent, onMessageSent, onForumActivity, onDecodeSuccess, onDefenseEvent, onBountyCompleted, onTraceEvaded, onSubnetUsed. Available in CommandContext.services.missionIntegrationService."
    FactionKnowledgeService: "Faction-scoped asset knowledge (servers, files, players). addEntry() upserts with confidence scoring. getSnapshot() cached 60s for AI prompts. serializeForPrompt() generates KNOWN_TARGETS block. expireEntries() cleanup. decayConfidence(rate=0.05, min=0.1) — time-based confidence decay, purges entries below threshold. getPlayerFactionId() helper."
    StoryMissionService: "AI-driven multi-step narrative arcs. createStoryArc() → AI plans 3-7 steps with branching. advanceStory() called on mission complete/fail events (wired in index.ts). Generates adapted steps on failure via AI. Uses StoryArc + StoryStep schema. Injects ServerContentService to provision mission infrastructure for story missions (replaced raw Prisma creation)."
  }

  @hacking {
    HackService: "Two flows: processHackAttempt (simple RNG) and initiateHackSession (3-layer interactive minigame). Session persistence to DB. Priority system affects detection (aggressive = up to +30%, stealth = up to -8%, 5% floor). Home server defense: firewall layers prepended, vault layers appended, IDS alerts on start/complete. Process cancel: 20% partial detection chance + 15s cooldown (via metadata.onCancel). Emits hack events (hack:attempt, ids_alert)."
    BackdoorService: "installBackdoor, useBackdoor, scanForBackdoors, removeBackdoor. Types: standard (24h), persistent (72h), rootkit (permanent). Detection risk increases per use."
    TraceService: "initiateTrace, progressTrace (auto-tick 60s), evadeTrace (stealth skill check). Evidence-based duration tiers: 15m/30m/1h/2h."

    @detection_consequences {
      description: "Real consequences triggered by triggerCounterMeasures() based on evidence level"
      low_evidence_0_30: "Silent logging only — HackLog entry, no active response"
      medium_evidence_31_60: "Firewall bump (+1 for 30min), server owner notified via Socket.IO"
      high_evidence_61_80: "Firewall +2 and security +1 for 1hr, faction AI alerted (FactionKnowledge entry + PersonaService.onFactionServerHacked), reputation penalty (-5), server owner notified"
      critical_evidence_81_100: "Full lockdown (firewall max for 2hr), trace initiated via TraceService (passive resource drain on attacker), access key revoked, faction AI alerted, heavy reputation penalty (-15), server owner notified, BOUNTY POSTED"
      faction_ai_reaction: "Faction leader learns attacker identity via FactionKnowledge. Can generate counter-missions targeting the attacker."
    }

    @bounty_system {
      description: "When a player is detected at critical level (81%+) on a faction server, a bounty is automatically posted"
      model: "Bounty — targetUserId, targetUsername, issuedByFactionId, reason, rewardCredits, rewardReputation, status (active|claimed|completed|expired), claimedByUserId, stolenFileIds (Json — fileSystemNode IDs of downloaded files), expiresAt (48h)"
      creation: "triggerCounterMeasures() at critical evidence → postBounty() finds files target downloaded from breached server (via metadata.sourceServerId), records their IDs in stolenFileIds, creates bounty, notifies faction via Socket.IO, posts wanted notice on faction forum via AI leader"
      reward_scaling: "Base 1000c + (evidence - 80) * 200c credits. 5 + (evidence - 80) rep."
      commands: "'bounties' lists active bounties with target, faction, reward, expiry. 'bounty claim <id>' accepts. 'bounty complete <id>' verifies hacked target home server + deletes stolen files + revokes access keys + grants rewards."
      completion: "Player must have ServerConnection with accessLevel > 0 on target's home server. On completion: deletes stolen files from target's ~/downloads/, revokes ServerAccessKeys linked to those files (via sourceFileId), notifies target via Socket.IO. Grants credits + faction reputation to hunter."
      pvp_loop: "Detection → bounty posted → faction members notified → hunter claims → hacks target's home → stolen files deleted + keys revoked → hunter collects reward. Target loses intel and access. Creates organic PvP content with real stakes."
    }

    @download_system {
      description: "Files must be downloaded to keep intel. cat/read shows content (ephemeral) but download copies to home server (persistent)."
      command: "'download <file>' — reads source file, spawns background process (CPU 10, RAM 64MB, BW 60), copies to ~/downloads/ on home server"
      access_keys: "Access key detection ONLY happens on download (moved from readFile). Keys extracted from downloaded content are linked to the file via sourceFileId on ServerAccessKey."
      metadata: "Downloaded files get FileSystemNode.metadata: { sourceServerId, sourcePath, downloadedAt, isDownloaded }. Used by bounty system to identify stolen files."
      key_revocation: "When a downloaded file is deleted (bounty completion, rm, or any deleteNode call), ServerAccessKeys with matching sourceFileId are revoked automatically in fileService.deleteNode(). Also triggers honeypot alert if decoy file deleted by non-owner."
      gameplay_loop: "Explore server (cat) → find valuable file → download it (process) → keys extracted → access new servers. Get caught → bounty posted → hunter deletes your downloads → you lose access keys. Must re-steal the files."
    }

    @home_defense_system {
      description: "Players upgrade their home server with defenses to protect stolen intel from bounty hunters and rival players."
      schema: "PlayerProgress fields: homeFirewall (0-3), homeVault (0-3), homeIds (0-3), homeHoneypot (boolean)"
      commands: "DefenseCommandsModule: defenses (status), protect <dir>, safevault [status|move|retrieve], honeypot [status|refresh], upgrade <defense> [level]"
      skill_gates: "defenses/upgrade→ungated. protect→Networking 15. safevault→Cryptography 20. honeypot→Stealth 25."

      @firewall_defense {
        levels: "L1: 2000c, L2: 5000c, L3: 12000c"
        effect: "Adds port_sequence minigame layers PREPENDED to hack session. L1→difficulty 5, L2→difficulty 7, L3→difficulty 9 + extra cipher layer."
        implementation: "homeFirewall checked in hackService.initiateHackSession(). Does NOT modify GameServer.firewallLevel (avoids double-apply with base layer generation)."
      }

      @vault_defense {
        levels: "L1: 3000c, L2: 8000c, L3: 20000c"
        effect: "Creates hidden/protected ~/.vault/ directory. Files moved inside are isProtected + isHidden."
        minigame_layers: "Vault layers APPENDED after base server layers in initiateHackSession. L1→cipher (difficulty 6). L2→cipher + memory_trace (difficulty 8). L3→cipher + memory_trace + port_sequence (difficulty 9). Attacker must solve ALL layers to get full access."
        commands: "'safevault move <file>' moves from ~/downloads/ to ~/.vault/. 'safevault retrieve <file>' moves back."
      }

      @ids_defense {
        levels: "L1: 1500c, L2: 4000c, L3: 10000c"
        effect: "Intrusion Detection System alerts via Socket.IO (emits ids_alert event, relayed by index.ts to player)"
        alert_timing: "L1→alert on hack COMPLETION. L2→alert on hack START. L3→alert on start + attacker IP/username revealed on completion."
        implementation: "Checks in hackService.initiateHackSession (L2+) and resolveHackSession (L1+). Uses emit('ids_alert') → index.ts listener → io.to(player).emit()"
      }

      @honeypot_defense {
        price: "5000c one-time"
        effect: "Generates 3-5 decoy files in ~/downloads/ with realistic names. metadata.isDecoy=true."
        detection: "fileService.readFile() checks isDecoy flag — creates honeypot_triggered GameEvent alerting server owner with attacker identity. Bounty completion tracks decoy hits separately — if all deleted files were decoys, hunter is informed no real intel was destroyed."
        commands: "'honeypot refresh' regenerates fresh decoy files."
      }

      @folder_protection {
        command: "'protect <dir>' toggles isProtected on a directory"
        effect: "Files inside protected dirs cannot be deleted, moved, or modified by attackers. Protected files are hidden from low-access intruders (accessLevel < 5 for hidden, < 7 for protected)."
        usage: "Free to use, no purchase required. Player can protect any dir on home server."
      }
    }
  }

  @factions {
    FactionService: "Faction CRUD, join/leave (with standing checks), addReputation (with clamping + cross-faction rivalry), ranks (recruit→operative→elite→council_member). Extends EventEmitter. 4 canonical factions: garrison, dothackers, cybercorp, darknet."
    ReputationEngine: "Rivalry matrix: garrison↔dothackers(-0.5), dothackers↔cybercorp(-0.6), garrison+cybercorp(+0.2), darknet vs all(-0.3). Standing thresholds: ≥30 allied, ≤-30 hostile."
    ResourceService: "5-min tick resource generation from faction-owned servers. Resource types: credits, intel, compute."
    ContestService: "Territory contests: declare, join, contribute, resolve. Layer-based challenge system."
    WarfareService: "Faction wars: declare (AI-only), surrender, war score, 2x rep multiplier, resource bleed, 14-day safety valve ceasefire."
    AliasService: "Player identity aliases: create (10k credits), destroy, reveal (skill check). 3x replacement limit."
    DarkNetDiscoveryService: "4 discovery paths: hidden_file (.aida), skill_threshold (hacking≥60+stealth≥50), censorship_flags (3+ mentions), breadcrumb_trail (3+ encrypted files). AIDA sends AI-generated recruitment DM. In-memory cache for fast sync lookups. Integrated with CensorshipService (censorship alerts), SystemCommands (cat .aida files), FactionService (hidden faction join gating). Uses direct constructor-injected AIService + MessageService."

    @share_intel_gating {
      description: "share_intel command now has dual gating: Social Engineering skill ≥ 10 (via SKILL_REQUIREMENTS) + faction rank ≥ operative (checked in handleShareIntel via factionMember query). Recruits cannot share intel."
      skill_gate: "socialEng level 10 — enforced by CommandProcessor.validateSkillRequirements()"
      rank_gate: "Must be operative, elite, or council_member — enforced in gameCommands.handleShareIntel() via factionMember.rank check"
    }
    CensorshipService: "Regex text filtering on forum posts, messages, cat output. Alerts trigger DarkNet discovery check."
  }

  @ai {
    AIService: "Ollama REST integration via /api/chat endpoint. generateResponse(prompt, systemPrompt, context?). Supports local + cloud modes (AI_API_KEY enables cloud). Dynamic timeout: 60s cloud / 120s local. 3 retries with exponential backoff (1s, 2s, 4s). Model: env AI_MODEL or OLLAMA_MODEL (default llama3.1:8b). Cloud API: set AI_API_URL=https://ollama.com + AI_API_KEY."
    PersonaService: "AI NPC management. 4 faction leaders + Game Master. Event handlers: onMemberJoined/Left, onHighRankAchieved, onServerContestResolved, onMissionCompleted, onServerHacked, onWarDeclared/Ended/ResourceBleed, onForumPostCreated. generateDynamicMission() 10-step knowledge-aware pipeline. FACTION_PROFILES constant. decideAction() for faction leaders: issue_mission, create_story_arc, send_message, forum_post. decideDirectorAction() for Game Master: trigger_event, plant_discovery (uses generateClue()), forum_post, issue_mission, send_message. executeAction() handles all types."
    AISchedulerService: "Interval scheduling: 4hr for faction leaders, 8hr for others. 3 actions/day limit. Midnight counter reset. 30-min game state check: low resources → defensive mission, contested servers → defensive mission, at war → war-support mission, power imbalance → rebalancing missions for weak factions (triggers when dominant > 1.5x avg, boosts factions < 0.8x avg). Calls FactionKnowledgeService.expireEntries() + decayConfidence()."
    StoryProgressionService: "The Architect's Staging Engine. Records significant game events to StoryLedger (recordEvent), evaluates accumulated events via AI (evaluateAndAct — fires when ≥5 unprocessed events), synthesizes world narrative state (getArchitectContext — epoch info, faction standings, key fragments, tension, themes), manages narrative epochs (transitionEpoch, initializeFirstEpoch). 4 pillars: RECORD → EVALUATE → SYNTHESIZE → EPOCH."
    ArchitectInterventionExecutor: "Executes the Architect AI's decisions. 7 intervention types: send_message, plant_clue, trigger_event, adjust_tension, create_mission, grant_token, reveal_faction. executeBatch() for processing multiple interventions. Records all executions to StoryLedger."
    DarkNetDungeonService: "Procedural dungeon generator for DarkNet. generateDungeon(difficulty) creates chain of 3-7 hidden servers with escalating security. plantClueFiles() places encrypted breadcrumb files on each hop. postForumRiddle() AI-generates cryptic forum post with gateway IP + passkey. conquerVault() grants weighted random rewards (aida_token/rare_script/credits_cache/intel_package), records to StoryLedger, auto-regenerates after 30s. ensureActiveDungeon() guarantees one active dungeon. 7-day TTL expiration."
  }

  @social {
    MessageService: "Player-to-player messaging with delivery queue. Server-side encryption key storage. Post-send hook system: onPrivateMessageSent(callback) registers callbacks fired after every successful sendPrivateMessage — used by TutorialService to intercept replies to The Architect. Methods: sendPrivateMessage, sendSystemMessage, sendAIMessage, getInbox, getSentMessages, markAsRead, deleteMessage, encryptMessage, decryptMessage, decryptMessageById, crackEncryption (skill-based), getChatHistory, getChatContacts (aggregates DB contacts + message history, unread counts via groupBy, online status via Socket.IO, avatar info), markConversationRead (batch + read receipt emit), getUnreadChatCounts, requestDecryption. Emits message:received (with avatar payload), message:new_mail (for messages with subjects), message:read_receipt, message:conversation_read. ChatContact interface exported for typed contact data with AvatarInfo."
    ForumService: "Enhanced forum system (Phase 3A+4). Post creation with censorship filtering. Replies, votes, reports. Emits forum:post_created for AI knowledge pipeline."
    PlayerPresenceService: "Online status tracking via Socket.IO connection/disconnect events."
  }

  @supporting {
    ShopService: "Item catalog, purchase (with credits check), sell (with equipped check, transaction)."
    InventoryService: "Equipment management, slot-based equipping."
    MemoryService: "Player computer resource management (CPU/RAM/BW). GameProcess lifecycle, passive consumers (terminals/connections/backdoors/traces), 1s tick loop, Socket.IO push events. Hardware shop items boost specs."
    ProcessStateService: "Command execution tracking with cleanup timers."
    LeaderboardService: "DB-backed leaderboards with 9 categories (level, credits, hacking, networking, cryptography, stealth, reputation, achievements, missions). getLeaderboard(category, limit) + getPlayerRank(). 'leaderboard' command with ASCII table."
    AchievementService: "28 achievements across 7 categories (combat, exploration, social, progression, faction, stealth, special). checkAndAward(userId) auto-checks all conditions, awards new ones, emits achievement:unlocked via Socket.IO. Hooked to mission:completed + hack:attempt events. 'achievements' command. Uses existing PlayerProgress.achievements String[] field."
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# CLIENT / UI
# ═══════════════════════════════════════════════════════════════════════════════

@client {
  description: "Svelte 5 terminal-first UI using Svelte 4 legacy patterns (export let, createEventDispatcher, onMount — NOT yet migrated to runes). Commands go to server, server returns ASCII-formatted text. Lightweight reactive overlays for real-time data."
  directory: "client/"
  architecture: "Terminal.svelte (main, ~1955 lines) + dialog components (shop, equipment, mail, chat, forum, message) + notification panel. ForumDialog is a 'forum terminal' — sends real forum commands and renders server ASCII output directly, with keyboard shortcuts (R=reply, N=new, V=vote, /=search, J=join, T=tag, !=report, M=members, :=raw cmd)."

  @components {
    Terminal: "1955 lines — full-screen terminal emulator with CRT scanline/glow effects, status bar (CPU/RAM gauges, notification badge, clock), command input with tab completion + history, hack challenge panel (sticky above input), keyboard shortcuts (Ctrl+T/W/L, Ctrl+1-9, Ctrl+Shift+←/→). Responsive CSS (1024/768/480px breakpoints + prefers-reduced-motion + high contrast)."
    TerminalTabs: "Tab bar for multi-terminal. VS Code–style tab support with per-tab output/command history."
    AuthDialog: "Login/Register modal with form validation."
    AsciiDialog: "Reusable ASCII-bordered dialog shell (╔═╗ box-drawing). Focus trap, Escape to close, scanline overlay."
    ChatDialog: "Real-time chat with server-provided avatars. Contact sidebar with avatar glyphs (color-styled), online status, unread badges. Message grouping (5-min window) with date separators. Encryption toggle button (🔒/🔓) appends --encrypt to msg commands. Typing indicators (debounced emit, 3s auto-stop). Avatar glyphs on incoming messages. Keyboard navigation (↑/↓ contacts, Enter send, Escape close)."
    ForumDialog: "Forum browser. Keyboard-driven (R/N/V/S/J/!/T/:/M/F). Breadcrumb navigation. All logic server-side."
    MailDialog: "Mail client with server-provided avatars. Inbox/Sent toggle. Category filter tabs (ALL/PRIV/SYS/MISSION/FACTION/ALERT) with per-category unread counts. Avatar glyphs in message list and read view. Decrypt button for encrypted messages (calls crack command, shows loading state, updates content inline). Real-time mail via newMailNotifications store (message:new_mail Socket.IO event). Encryption flag on compose. N/R/D/Tab/Enter/Escape keys."
    ShopDialog: "Item shop. Category filtering, search, item detail with requirements/effects, purchase validation."
    EquipmentDialog: "Inventory grid + Equipment slots (TOOL/SOFTWARE/EXPLOIT/DEFENSE/UPGRADE). Bonuses panel."
    NotificationPanel: "Persistent list with 6 types (message/chat/mail/forum/system/game). Max 50. Sound + Desktop API."
  }

  @services {
    api_ts: "REST API client (ApiClient singleton). JWT in localStorage (aida_auth_token). Auto Authorization + X-CSRF-Token headers. CSRF token fetched on page load after JWT verification; hasCsrfToken() check + auto-retry refresh on 403 CSRF errors; failed CSRF fetch triggers logout and return to login screen. Sections: auth, users, servers, files, messages, forum, missions, hacking, events, commands, health."
    socket_ts: "Socket.IO client (SocketService singleton). Exports stores: socketConnected, socketError, onlineUsers, serverActivity, liveMessages, hackAttempts, playerResources, activeProcesses, activeHackSession, typingUsers (Map<userId,username>), newMailNotifications. Emitters: emitTypingStart/Stop. Listeners: typing:start/stop → typingUsers store, message:new_mail → newMailNotifications store. Lazy-loads NotificationService to avoid circular imports."
    terminal_ts: "Terminal service. POST /api/command/execute. Normalizes output to string[]. Error message extraction with HTTP status mapping."
    terminalTabs_ts: "Multi-terminal tab state via socket events (terminal:list/create/close/switch). Per-tab output + command history."
    notifications_ts: "NotificationService + stores (notifications, unreadCounts, derived unreadNotifications/notificationsByType). Desktop Notification API + Web Audio API (800Hz sine beep)."
  }

  @stores {
    file: "client/src/stores/gameState.ts"
    writable: ["outputLines" "commandHistory" "historyIndex" "currentUser" "isAuthenticated" "authLoading" "authError" "networkAccess" "currentServer" "currentDirectory" "playerProgress" "discoveryLevel" "knownServers" "connectedServers" "fileSystemCache" "onlinePlayerCount" "recentActivity" "unreadMessages" "securityAlerts"]
    derived: ["connectionStatus (from socketConnected + authLoading)" "terminalPrompt (from user/server/directory)"]
    functions: "addOutput, addSystemOutput, addErrorOutput, addSuccessOutput, clearOutput, addToHistory, navigateHistory, registerUser, loginUser, logoutUser, verifyAuthentication, loadInitialGameData, connectToServer, disconnectFromServer, loadServerFileSystem, sendMessage, attemptHack, initializeGameState"
  }

  @client_utils {
    forumSystem_ts: "Minimal UI-only state (all logic server-side). Stores: currentForum, discoveredForums, currentPost."
    note: "asciiAvatars.ts and messagingSystem.ts DELETED — avatars are now server-generated, MessageDialog removed."
    note_lore: "World lore is server-side only (server/src/lore/worldLore.ts) — not exposed to client"
  }

  @socket_events {
    description: "Socket.IO listeners in client/src/services/socket.ts wire server events to stores and notifications"
    notification_wired: "process:completed, process:failed, mission:objective:updated, mission:completed, mission:expired, player:levelup, faction:event, discovery:made, notification (generic), game:event (critical/warning), forum:new-post, forum:new-reply, achievement:unlocked"
    store_wired: "process:started/completed/cancelled/progress → activeProcesses store. resources:update → playerResources store. command:result with session data → activeHackSession store. typing:start/stop → typingUsers store. message:new_mail → newMailNotifications store."
    silent: "rewards:xp_granted, rewards:credits_granted — shown in command output, no notification popup"
  }

  @status_bar {
    description: "Real CPU/RAM percentages from playerResources store (updated every 5s via resources:update Socket.IO event from memoryService tick loop)."
  }

  @hack_challenge_panel {
    description: "Sticky panel above terminal input. Visible when activeHackSession store has active=true. Shows: target IP, layer progress, challenge displayText, hints. Player types crack.submit/firewall.knock/memory.extract in terminal below."
    store: "activeHackSession — set when command:result contains sessionId + targetIp + challenge + totalLayers data (pushed from hackCommands on minigame start)"
  }

  @notification_panel {
    description: "Persistent list panel with 6 types (message, chat, mail, forum, system, game). Max 50 notifications. Sound on high/urgent priority. Desktop notifications via Notification API. Toggled via Ctrl+N."
    service: "NotificationService (client/src/services/notifications.ts) — add(), markAsRead(), clear()"
  }


}

# ═══════════════════════════════════════════════════════════════════════════════
# SHARED TYPES
# ═══════════════════════════════════════════════════════════════════════════════

@shared {
  file: "shared/types.ts (~935 lines, 102 exported symbols)"
  compiled: "shared/types.js + shared/types.d.ts + source maps"
  path_alias: "Server tsconfig maps @/shared/* → ../shared/*"

  @categories [
    "Auth: UserRole, User, AuthRequest, AuthResponse, ApiResponse, AvatarInfo"
    "Session: PlayerSession, TerminalTab, Command, ParsedCommand, CommandResult, ValidationResult"
    "Server: ServerState, GameState, CurrentServerInfo, GameServerInfo, ServerConnectionInfo"
    "Player: PlayerInfo, PlayerSkills, PlayerStats, PlayerAliasInfo"
    "Faction: FactionId, FactionRank, FactionReputation, FactionResources, FactionStandingInfo, FactionServerInfo, FactionWarInfo, WarStatus"
    "Network: IPRange, IPZone, IPOwner, DiscoveryResult, TraceRouteHop, TraceRouteResult, ServerDiscoveryResult, ServerScanOptions"
    "Hacking: HackAttempt, HackMethod (enum), HackResult, HackCalculation, HackDifficultyFactors, HackSessionInfo, MinigameType, MinigameChallenge, LayerResult"
    "File System: FileSystemNode, PermissionLevel (bitmask enum), SpecialAccess, FilePermissions, FileOperation, FileOperationType, FileAccessRecord, FileAccessSummary"
    "Missions: MissionInfo, MissionStatus (enum), MissionObjective, MissionObjectiveMetadata, MissionReward, MissionProgress, ObjectiveProgress, MissionObjectiveType (enum, 30+ types)"
    "Events: GameEvent, EventType (17 types), EventSeverity, EventSubscription, SubscriptionMethod"
    "Notifications: Notification, NotificationType, NotificationPriority"
    "Socket: SocketEventData, StateUpdateEvent, StateDelta, CommandExecuteEvent, BroadcastMessage, BroadcastTarget"
    "Home System: PlayerHomeSystem, HomeCustomization"
    "Save/Backup: SaveTrigger, SavePriority, ProgressBackup"
    "Errors: GameError, ValidationError, AuthorizationError, NotFoundError, RateLimitError"
    "NPC: NPCAgent, NPCType, NPCState, NPCPersonality"
    "DarkNet: DarkNetDiscoveryMethod, CensorshipAlert"
    "Inventory: InventoryItem"
    "Server Contest: ServerContestInfo, ContestStatus"
  ]
}

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE SCHEMA
# ═══════════════════════════════════════════════════════════════════════════════

@database_schema {
  models: 61
  file: "server/prisma/schema.prisma"

  @core {
    User: "id, username (unique), email (unique), password, homeIp (unique), homeServerId, isOnline, role (player|moderator|admin), mutedUntil"
    UserSession: "JWT session tracking, lastServerId, currentDirectory. @@index(expiresAt, userId)"
    PlayerProgress: "userId (PK), XP, level, credits, skills (hacking/networking/cryptography/stealth/socialEng/forensics as Int), missionProgress (Json), equipment (Json), inventory (Json), homeFirewall (0-3), homeVault (0-3), homeIds (0-3), homeHoneypot (Boolean), achievements (String[])"
    ProgressBackup: "Snapshots of PlayerProgress. @@index(userId, createdAt)"
    AuditLog: "userId, action, resource, resourceId, oldValues, newValues"
    GameConfig: "key (PK), value (Json)"
    GameEvent: "type, title, severity, isGlobal, affectedUsers[]"
    EventSubscription: "userId, eventType, targetId, method, quality"
    Notification: "userId, type, title, category, priority, isRead, expiresAt. @@index(userId, isRead, type, category, createdAt)"
  }

  @game_world {
    GameServer: "id, name, ipAddress (unique), type, role (gateway|router|...), networkId (FK→Network), ownerId (FK→User), factionId (FK→Faction), securityLevel (1-10), firewallLevel (1-10), encryptionLevel (0-5), discoveryLevel (0-5), isPublic, accessMethod (open|hackable|keycard|hack_or_key), accessKey, isPlayerHome, isAidaHomeServer, isOnline, resourceType, resourceOutput, isContested. @@index(ownerId, networkId)"
    FileSystemNode: "id, serverId (FK), parentId (self-ref via FileHierarchy), name, type (file|directory), content, permissions (Json bitmask), size, isHidden, isEncrypted, isProtected, metadata (Json? — {sourceServerId, sourcePath, downloadedAt, isDownloaded, isDecoy}), createdBy (FK→User). @@index(parentId, serverId)"
    ServerConnection: "userId, serverId, accessLevel (0-10), workingDirectory, isActive, sessionData (Json)"
    ServerAccessKey: "userId, serverId (FK→GameServer), keyValue, source, sourceDetail, sourceFileId (FK?→FileSystemNode for revocation), discoveredAt. @@unique(userId,serverId)"
  }

  @network {
    Network: "id, name (unique), description, factionId (FK→Faction), zone, isHidden, metadata (Json). @@index(factionId)"
    ServerLink: "id, sourceId (FK→GameServer), targetId (FK→GameServer), networkId (FK→Network), linkType, bandwidth, latency, isActive, requiredAccess. @@unique(sourceId,targetId). @@index(sourceId, targetId, networkId)"
    DiscoveredLink: "id, userId, linkId (FK→ServerLink), discoveredAt, source. @@unique(userId,linkId). @@index(userId)"
  }

  @factions {
    Faction: "id, name (unique), shortName (unique), fullName, description, ideology, color, resources (Json), isHidden, rankRequirements (Json), aiPersonaId (unique FK→AIPersona)"
    FactionMember: "userId, factionId, rank (recruit|operative|elite|council_member), reputation, totalReputationEarned. @@unique(userId,factionId)"
    FactionStanding: "userId, factionId, reputation, isAllied, isHostile, isNeutral. @@unique(userId,factionId). @@index(userId, factionId, reputation)"
    FactionEvent: "type, data (Json), factionId, userId, impact, reputationChange, resourceChange. @@index(userId, factionId, eventType)"
    FactionKnowledge: "factionId, assetType (server|file|player), assetId, assetMeta (Json), source, confidence (0-1), discoveredBy, expiresAt. @@unique(factionId,assetType,assetId). @@index(factionId+assetType, factionId+discoveredAt, expiresAt)"
    FactionResourceTick: "factionId, credits, intel, compute, tickedAt. @@index(factionId, tickedAt)"
  }

  @missions {
    Mission: "title, description, type, difficulty (1-10), objectives (Json), reward (Json), status, assignedTo (FK→User), createdBy (FK→User), factionId (FK→Faction), issuedBy (FK→AIPersona), storyArcId (FK→StoryArc), storyStep (Int), prerequisiteTemplateIds (Json?), targetServerId, expiresAt, timeLimit. @@index(storyArcId)"
    StoryArc: "title, description, factionId (FK), issuedBy (FK→AIPersona), assignedTo (FK→User), status (active|completed|failed|abandoned), currentStep, totalSteps, steps (Json — StoryStep[]), narrativeContext (Json), difficulty. @@index(assignedTo+status, factionId)"
  }

  @ai {
    AIPersona: "id, type (game_master|faction_leader|aida), name (unique), personality (Json), systemPrompt, model, actionsToday, lastActionAt"
    AIKnowledge: "personaId, source, type, content (Json), confidence, expiresAt. @@index(personaId+type)"
    AIAction: "personaId, type (issue_mission|send_message|forum_post|trigger_event|plant_discovery), status, input (Json), output (Json), triggeredBy. @@index(personaId+status, status+createdAt)"
    AidaClue: "type, serverId, filePath, content, requiredClues[], difficulty, discovered, discoveredBy. @@index(serverId, discovered). No FK relations (plain strings)."
  }

  @story_discovery {
    StoryProgress: "userId (unique), discoveryLevel (0-6), key fragments (signal/location/cipher 0-3 each), aidaTrustLevel, endgameUnlocked, endgameChoice (help|expose|exploit), gameCompleted"
    IntelligenceReport: "userId, category, title, importance, triggersEvent. @@index(userId, category, isRead)"
    KeyFragment: "keyType, fragmentNum, sourceType, sourceId. @@unique(keyType,fragmentNum)"
    KeyFragmentDiscovery: "userId, fragmentId (FK→KeyFragment), method. @@unique(userId,fragmentId). @@index(userId)"
    NarrativeEpoch: "epochNum (unique), title, summary, worldState (Json — faction standings, tension, themes snapshot), triggers (Json — what caused this epoch), decisions (Json — Architect decisions during epoch), startedAt, endedAt"
    StoryLedger: "type, category, actorId, actorType (player|faction|system|architect), targetId, targetType, summary, impact (Json), weight (1-10, ≥7 = global GameEvent), epochId (FK→NarrativeEpoch), isProcessed. @@index(isProcessed, epochId, actorId, category)"
    PersonaMessage: "userId (FK→User), personaId (FK→AIPersona), tokenItemId (consumed ShopItem), direction (inbound|outbound), subject, content, linkedMessageId (FK→Message). @@index(userId, personaId)"
    DarkNetInstance: "networkId (unique FK→Network), gatewayIp, passkey, vaultServerId (FK→GameServer), depth, difficulty, rewardType (aida_token|rare_script|credits_cache|intel_package), rewardData (Json), status (active|conquered|expired|regenerating), conqueredBy (FK→User), conqueredAt, expiresAt. @@index(status)"
  }

  @social {
    Message: "senderId, recipientId, subject, content, isEncrypted, encryptionKey, messageType, triggerEvent"
    Contact: "userId, contactUserId, handle, encryptionLevel. @@unique(userId,contactUserId)"
  }

  @forum_legacy {
    ForumPost: "authorId, title, forumSection, isHoneypot, factionAlignment (legacy — Phase 3A enhanced system is primary)"
    ForumReply: "postId, authorId, content, votes (legacy)"
  }

  @forum_enhanced {
    description: "Phase 3A + Phase 4 enhanced forum system (primary)"
    Forum: "name (unique), url (unique), category, securityLevel (1-5), isHoneypot, factionId, requiresProxy. @@index(category, factionId)"
    Post: "forumId, authorId, authorHandle, title, isEncrypted, isHidden, storyRelevant, keyFragmentId. @@index(forumId, authorId, storyRelevant)"
    ForumMember: "userId, forumId, handle, reputation. @@unique(userId,forumId). @@index(userId, forumId)"
    ForumDiscovery: "userId, forumId, method. @@unique(userId,forumId). @@index(userId)"
    ProxyConnection: "userId (unique), proxyServer, location, expiresAt"
    PostReply: "postId, authorId, authorHandle, content, votes. @@index(postId, authorId)"
    PostVote: "userId, postId?, replyId?, value. @@unique(userId,postId) @@unique(userId,replyId). @@index(postId, replyId)"
    PostReport: "reporterId, postId?, replyId?, forumId, reason, status, resolvedBy. @@index(forumId, status)"
  }

  @territory {
    ServerContest: "serverId, attackingFactionId, defendingFactionId, initiatedBy, status, decryptionProgress, winnerId. @@index(serverId, status)"
    ContestParticipant: "contestId, userId, factionId?, contribution, side. @@unique(contestId,userId). @@index(contestId, userId)"
  }

  @shop_inventory {
    ShopItem: "name, description, itemType, category, price, level, stat bonuses (hacking/stealth/crypto/networking), rarity, isConsumable, stock. @@index(itemType, category, isActive)"
    InventoryItem: "userId, shopItemId, quantity, isEquipped, slot, usesRemaining, expiresAt. @@index(userId, shopItemId, isEquipped)"
    note_shop_effect: "ShopItem gained effect (Json?) field for functional item effects (e.g. personaName for communication tokens)"
    note_inventory_source: "InventoryItem gained source (shop|mission_reward|server_loot|story_event|admin) and sourceId fields for tracking item provenance"
  }

  @pvp {
    HackSession: "id (manual, no @default), attackerId, targetOwnerId, targetServerId, method, currentLayer, totalLayers, status, layersData, detectionAccumulator, startedAt/expiresAt/layerStartedAt (BigInt epoch ms). @@index(attackerId, status)"
    Backdoor: "installerId, serverId, accessLevel, type (standard|persistent|rootkit), detectionRisk, expiresAt. @@unique(installerId,serverId). @@index(serverId)"
    ActiveTrace: "targetId, initiatedBy, serverId, progress (0-100), status, evidenceLevel. @@index(targetId, status)"
    HackLog: "attackerId, targetId, targetServerId, method, tools[], stealthLevel, success, detected, evidenceLeft. @@index(attackerId, targetId, timestamp)"
    Bounty: "targetUserId, targetUsername, issuedByFactionId, reason, rewardCredits, rewardReputation, status (active|claimed|completed|expired), claimedByUserId, stolenFileIds (Json? — fileSystemNode IDs), serverId, evidenceLevel, expiresAt (48h). @@index(status, targetUserId, issuedByFactionId, expiresAt). NOTE: No FK @relation directives — plain strings with indexes only."
  }

  @phase5 {
    FactionWar: "attackerFactionId, defenderFactionId, declaredBy (AI persona ID), status, attackerScore, defenderScore, reputationMultiplier, terms. @@index(status, attackerFactionId, defenderFactionId)"
    PlayerAlias: "userId (unique), aliasName (unique), apparentFactionId, cost, revealedBy[]"
    DarkNetDiscovery: "userId (unique), method, metadata"
    CensorshipRule: "factionId?, serverId?, pattern (regex), replacement, alertTarget"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# SEED FILES
# ═══════════════════════════════════════════════════════════════════════════════

@seed_files {
  file: "server/prisma/seed.ts (~1283 lines) — single integral seed"
  entry_point: "server/src/database/seed.ts — delegates to prisma/seed.ts"
  script: "npm run db:seed (tsx prisma/seed.ts)"
  note: "Old seed files (seed-simple.ts, seed-phase3a.ts, seed-core-systems.ts) have been removed."

  @sections [
    "0. Clear Data — deleteMany() on all 40+ tables in reverse dependency order"
    "1. Users — 3 test users: testuser (admin), alice, bob"
    "2. Player Progress — skills, levels, credits for each user"
    "3. Factions — 4 factions: The Garrison, dotHackers, CyberCorp, DarkNet (hidden)"
    "4. AI Personas — 5 personas: The Architect, AIDA, Commander Steele, gh0st, Director Chen — linked to factions"
    "5. Servers & Networks — 28 servers: 3 standalone + Internet Exchange + Garrison (8) + CyberCorp (8) + dotHackers (6) + DarkNet (3)"
    "6. Access Controls — public/hackable/keycard servers with generated access keys"
    "7. Server Links — full bidirectional topology (backbone + 4 faction LANs)"
    "8. Faction Standings — all test users initialized neutral on visible factions"
    "9. Forums — 6 forums: tech, underground, honeypot, garrison, dothackers, cybercorp"
    "10. Forum Members — 5 memberships (test users on public forums)"
    "11. Shop Items — 13 items across hardware (3 tiers) + software tools"
    "12. Game Config — game_settings entry with version, tick rate, feature flags"
    "13. Key Fragments — 9 fragments (signal/location/cipher × 3)"
    "14. Story Progress — initialized for all 3 test users"
  ]

  @not_yet_seeded [
    "Tutorial missions are created dynamically at runtime by TutorialService — no seed data needed"
    "Training Network servers (10.10.10.x) get content via static 'tutorial' template in serverContentService on first content provisioning"
  ]
}

