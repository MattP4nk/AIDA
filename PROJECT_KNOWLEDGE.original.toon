# DARKNET DUNGEON SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@darknet_dungeon_system {
  description: "Procedural dungeon generator for DarkNet. Creates ephemeral hidden server chains that players must hack through to reach a vault with rewards. Auto-regenerates on conquest or expiry."
  file: "server/src/services/darknetDungeonService.ts (~1400 lines)"
  token: "DARKNET_DUNGEON_SERVICE"

  @generation_pipeline {
    step_1: "generateDungeon(difficulty) — random name from prefix/suffix/code pools"
    step_2: "Difficulty-scaled depth (3-7 servers in a chain) with escalating security"
    step_3: "Passkey generation (XXX-XXX format) for gateway access"
    step_4: "Weighted reward selection (aida_token, rare_script, credits_cache, intel_package)"
    step_5: "Unique IP allocation (collision-checked, RFC 5737 documentation IPs)"
    step_6: "Network + GameServer chain with linear topology under darknet faction"
    step_7: "ServerLinks (chain topology with hidden link types)"
    step_8: "plantClueFiles() — hidden .signal/trace_N.dat files on each hop pointing to next server IP. Files beyond hop 2 are encrypted."
    step_9: "populateServerContent() — AI-generated lore content using DARKNET_SERVER_THEMES + CRYPTIC_QUOTES per depth tier"
    step_10: "plantVaultReward() — vault_payload.enc on final server"
    step_11: "DarkNetInstance record created (7-day TTL)"
  }

  @rewards {
    aida_token: "AIDA Signal Fragment or Envoy's Cipher Token (weight 3/5)"
    rare_script: "zero_day_exploit + 10k credits (weight 4)"
    credits_cache: "25k credits (weight 6 — most common)"
    intel_package: "5000 XP + 2 skill points (weight 4)"
  }

  @forum_riddles {
    description: "postForumRiddle() — The Architect AI persona posts a cryptic forum puzzle with gateway IP and passkey hidden in disguised forms (encoded, split across sentences, acronyms, etc.)"
    author: "The Architect persona"
    target: "Random public forum"
  }

  @vault_conquest {
    trigger: "Player reads vault_payload.enc on final vault server (via cat/read command)"
    actions: ["Grant weighted random reward" "Record fragment_found event to StoryLedger (weight 8)" "Fire system alert" "Auto-regenerate dungeon after 30 seconds"]
  }

  @lifecycle {
    ensureActiveDungeon: "On server startup, guarantees at least one active dungeon exists"
    expireOldDungeons: "TTL cleanup — dungeons expire after 7 days if unconquered"
    regeneration: "30 seconds after conquest — tears down all servers/files/links/connections, generates fresh dungeon with new riddle"
  }
}

