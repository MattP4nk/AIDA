# PROJECT STATUS
# ═══════════════════════════════════════════════════════════════════════════════

@pending_work {
  @high_priority [
    "End-to-end gameplay testing (all command flows, hack→bounty→defense cycle)"
    "Test suite — 0% coverage, no test files. Priority targets: MessageService flows, MissionService (generate→create→add-to-progress), AIService (/api/chat request shape, headers, retry/backoff), mission generation integration (missions added to playerProgress and acceptable), E2E smoke (login→missions→mission 1→accept 1→start)"
    "Endgame sequence — StoryProgress has endgameUnlocked/endgameChoice/gameCompleted fields and schema supports 3×3 key fragment collection, but no dedicated KeyFragmentService or endgame sequence implementation exists yet"
  ]

  @medium_priority [
    "Client UI polish (read/delivery status icons in ChatDialog, avatar compact mode, accessibility fixes)"
    "Migrate client components from Svelte 4 patterns to Svelte 5 runes ($state, $derived, $effect)"
    "Developer docs / README updates: AI env vars (AI_API_URL, AI_MODEL, AI_API_KEY), AIService behavior (chat endpoint, cloud/local modes), socket auth handshake and CSRF expectations"
    "Security review: audit API key storage (OLLAMA/AI keys), consider vault/encrypted secret storage for production, ensure server-side storage policy for AI keys and logs is acceptable"
    "Persist or improve mission index: currently in-memory per-player Map refreshed by 'missions' command — consider session/cache persistence for server restart survival, cache expiration on logout or after N minutes"
    "Dedicated KeyFragmentService — fragment discovery currently logged as StoryLedger events but no specialized service orchestrates the 9-fragment collection or tracks progress toward endgame unlock"
  ]

  @low_priority [
    "Redis session storage (redis package installed but unused)"
    "Mission archival after 7 days"

    "Remove legacy ForumPost/ForumReply models (replaced by Phase 3A+4 enhanced forum)"
    "Logging and metrics for AI usage (per-persona request counts, cache hit rate)"
    "Optional player-facing avatar selection UI (server remains source of truth)"
  ]
}

@known_issues {
  @version_skew [
    "TypeScript: server ^5.3.3 vs client ~5.9.3 — 6 minor versions apart"
    "@types/node: server ^20.10.5 vs client ^24.6.0 — significant gap"
  ]

  @schema_notes [
    "Bounty model has no FK @relation directives — referential integrity not enforced at DB level"
    "AidaClue model has no FK relations for serverId/discoveredBy — plain strings"
    "HackSession uses BigInt for timestamps (startedAt/expiresAt) while all other models use DateTime"
    "HackSession.id has no @default(cuid()) — IDs generated in application code"
    "Legacy ForumPost/ForumReply models still in schema alongside enhanced Forum/Post/PostReply system"
  ]
}

@configuration {
  required_env: ["DATABASE_URL" "JWT_SECRET"]
  optional_env: ["PORT (3001)" "NODE_ENV (development)" "AI_API_URL (http://localhost:11434)" "AI_MODEL (llama3.1:8b)" "AI_API_KEY (cloud mode)" "OLLAMA_API_URL (legacy alias)" "OLLAMA_MODEL (legacy alias)" "OLLAMA_API_KEY (legacy alias)" "LOG_LEVEL (info)"]
  client_env: ["VITE_API_URL (http://localhost:3001/api)" "VITE_SOCKET_URL (http://localhost:3001)"]
  server_engine: "node >= 18.0.0"
  client_dev_port: 8080
}

@development_workflow {
  setup: "createdb aida_game && cd server && npm install && npx prisma migrate dev && npm run db:seed && npm run dev"
  client: "cd client && npm install && npm run dev"

  @scripts {
    server_dev: "npm run dev (tsx watch src/index.ts)"
    server_build: "npm run build (tsc)"
    server_start: "npm start (node dist/server/src/index.js)"
    db_migrate: "npm run db:migrate (npx prisma migrate dev)"
    db_generate: "npm run db:generate (npx prisma generate)"
    db_studio: "npm run db:studio (npx prisma studio)"
    db_seed: "npm run db:seed (tsx prisma/seed.ts)"
    migrate_home_dirs: "npm run migrate:home-dirs (tsx scripts/migrate-home-directories.ts)"
  }

  @adding_service [
    "1. Create server/src/services/myService.ts with @injectable()"
    "2. Add MY_SERVICE token to server/src/di/tokens.ts"
    "3. Register singleton in server/src/di/container.ts"
    "4. If needed by commands: add to CommandContext.services in interface.ts + buildCommandContext() in commandProcessor.ts"
  ]

  @adding_command [
    "1. Identify module in server/src/services/commandModules/"
    "2. Add to commands Set + execute() switch + handler method + getCommandInfo()"
    "3. If skill-gated: add to SKILL_REQUIREMENTS in skillRequirements.ts"
  ]
}

@last_updated {
  date: "2026-04-06T15:30:00Z"
  summary: "Two-process content generation refactor. ServerContentService.provisionServerContent() now runs two independent AI generation passes per server: (1) Lore Process — LORE_SYSTEM_PROMPT + buildLorePrompt(), serious/dark/enigmatic tone, 2-4 files with 400+ chars, faction servers only; (2) Ambient Process — AMBIENT_SYSTEM_PROMPT + buildAmbientPrompt(), voice varies by content, 4-6 files with 400+ chars, all servers. Results merged with static fallback if both fail. Added resolveFactionKey() helper. Content cap raised 2000→3000 chars. Legacy generateContentPlan renamed to _generateContentPlan."
}
