# Node.js
node_modules/
dist/
build/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / Secrets — NEVER commit these
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# AI / Agent tooling
.agents/
.claude/

# Scripts (dev-only utilities, not production code)
# NOTE: 5 files here are already tracked; gitignore does not apply to tracked
# files, so this rule only affects new additions. See PLAN.md (O8).
server/scripts/

# Documentation / notes
# Previously this blanket-ignored *.md and *.toon, which meant a fresh clone got
# exactly one doc (README.md) and PROJECT_KNOWLEDGE.toon — the de-facto
# architecture reference — could not be committed at all. Docs are now tracked.

# SQL dumps — but NOT Prisma migrations, which are source, not dumps.
#
# The exception is kept ready rather than needed: as of 2026-08-31 the project
# deliberately has NO migrations and provisions with `prisma db push` from
# schema.prisma (see PROJECT_KNOWLEDGE @migrations). The blanket *.sql rule would
# swallow server/prisma/migrations/** the moment migrations ARE adopted, which is
# the trap this exception exists to prevent.
#
# Correction to the original D1 note, which claimed a fresh clone "could not
# provision a database at all" without migrations: it always could, from
# schema.prisma. What ignoring migrations actually costs is deploy history — the
# ability to evolve a database whose data you cannot drop.
*.sql
!server/prisma/migrations/**/*.sql

# Compiled output committed by mistake — shared/ is TypeScript source only.
# A stale shared/types.js was shadowing shared/types.ts under Vite's default
# .js-before-.ts resolution. See PLAN.md (A1).
shared/**/*.js
shared/**/*.js.map
shared/**/*.d.ts
shared/**/*.d.ts.map

# OS
.DS_Store
Thumbs.db
