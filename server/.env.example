# AIDA Server Environment Configuration
# Copy this file to .env and fill in the values

# ==================== SERVER CONFIGURATION ====================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://aida_user:your_password@localhost:5432/aida_db

# ==================== SECURITY ====================
# JWT secret for token signing (generate a strong random string)
# Use: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_please_change_this

# JWT token expiration time
JWT_EXPIRES_IN=24h

# BCrypt rounds for password hashing (10-12 recommended for production)
BCRYPT_ROUNDS=12

# ==================== REDIS (OPTIONAL) ====================
# Redis connection string for sessions and caching
# If not provided, will use in-memory storage
REDIS_URL=redis://localhost:6379

# ==================== RATE LIMITING ====================
# Rate limiting window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ==================== GAME CONFIGURATION ====================
# Maximum number of concurrent players
MAX_CONCURRENT_PLAYERS=100

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60

# Cooldown between hack attempts in seconds
HACK_COOLDOWN_SECONDS=30

# ==================== SECURITY & SANDBOXING ====================
# Script execution timeout in milliseconds
SCRIPT_EXECUTION_TIMEOUT_MS=5000

# Memory limit for script execution in MB
SCRIPT_MEMORY_LIMIT_MB=10

# ==================== FILE SYSTEM LIMITS ====================
# Maximum file size in MB
MAX_FILE_SIZE_MB=1

# Maximum number of files per user
MAX_FILES_PER_USER=1000

# ==================== LOGGING ====================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file path
LOG_FILE_PATH=./logs/app.log

# ==================== DEVELOPMENT SETTINGS ====================
# Enable detailed error messages (development only)
DETAILED_ERRORS=true

# Enable database query logging
DB_LOGGING=false

# Enable CORS for development
CORS_ORIGIN=http://localhost:8080

# ==================== MULTIPLAYER CONFIGURATION ====================
# Auto-save interval in seconds
AUTO_SAVE_INTERVAL_SECONDS=60

# Command rate limit per player per second
COMMAND_RATE_LIMIT_PER_SEC=10

# ==================== IP ALLOCATION ====================
# Player IP range (default: 10.0.0.0/16)
PLAYER_IP_RANGE_START=10.0.0.1
PLAYER_IP_RANGE_END=10.0.255.254

# Corporate server IP range (default: 172.16.0.0/12)
CORPORATE_IP_RANGE_START=172.16.0.1
CORPORATE_IP_RANGE_END=172.31.255.254

# Government server IP range (default: 192.168.0.0/16)
GOVERNMENT_IP_RANGE_START=192.168.0.1
GOVERNMENT_IP_RANGE_END=192.168.255.254

# Underground network IP range (default: 169.254.0.0/16)
UNDERGROUND_IP_RANGE_START=169.254.0.1
UNDERGROUND_IP_RANGE_END=169.254.255.254

# ==================== AI CONFIGURATION (FUTURE) ====================
# Enable NPC AI (not implemented yet)
ENABLE_NPC_AI=false

# NPC tick rate in milliseconds
NPC_TICK_RATE_MS=1000

# Maximum number of NPCs
MAX_NPCS=100

# ==================== PERFORMANCE TUNING ====================
# Database connection pool size
DB_POOL_SIZE=10

# Maximum pending save operations
MAX_SAVE_QUEUE_SIZE=1000

# State sync throttle in milliseconds
STATE_SYNC_THROTTLE_MS=50
