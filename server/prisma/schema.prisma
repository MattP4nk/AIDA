// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTHENTICATION ====================

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  password     String
  homeIp       String    @unique @map("home_ip")
  homeServerId String?   @map("home_server_id") // Reference to player's home system
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLogin    DateTime  @default(now()) @map("last_login")
  isActive     Boolean   @default(true) @map("is_active")
  isOnline     Boolean   @default(false) @map("is_online")
  role         String    @default("player") // "player" | "moderator" | "admin"
  mutedUntil   DateTime? @map("muted_until")

  // Relations
  progress           PlayerProgress?
  ownedServers       GameServer[]
  messages           Message[]           @relation("MessageSender")
  receivedMessages   Message[]           @relation("MessageRecipient")
  contacts           Contact[]           @relation("ContactOwner")
  contactOf          Contact[]           @relation("ContactTarget")
  forumPosts         ForumPost[]
  forumReplies       ForumReply[]
  createdFiles       FileSystemNode[]
  missions           Mission[]           @relation("MissionAssignee")
  createdMissions    Mission[]           @relation("MissionCreator")
  storyArcs          StoryArc[]
  hackAttempts       HackLog[]           @relation("HackAttacker")
  hackTargets        HackLog[]           @relation("HackTarget")
  sessions           UserSession[]
  auditLogs          AuditLog[]
  eventSubscriptions EventSubscription[]

  // Phase 3A Relations
  forumMemberships ForumMember[]
  forumDiscoveries ForumDiscovery[]
  proxyConnection  ProxyConnection?
  storyProgress    StoryProgress?
  intelligence     IntelligenceReport[]
  postReplies      PostReply[]
  postVotes        PostVote[]
  reportsMade            PostReport[]      @relation("ReportCreator")
  reportsResolved        PostReport[]      @relation("ReportResolver")
  messageReportsMade     MessageReport[]   @relation("MessageReportCreator")
  messageReportsResolved MessageReport[]   @relation("MessageReportResolver")

  // Game mechanics
  inventoryItems   InventoryItem[]
  notifications    Notification[]
  keyFragments     KeyFragmentDiscovery[]
  factionStandings FactionStanding[]
  factionEvents    FactionEvent[]
  factionMembers   FactionMember[]
  progressBackups  ProgressBackup[]
  posts            Post[]

  // Phase 5 relations
  alias            PlayerAlias?
  darkNetDiscovery DarkNetDiscovery?

  // PvP hacking relations
  hackSessionsAttacking HackSession[]    @relation("HackSessionAttacker")
  hackSessionsDefending HackSession[]    @relation("HackSessionTarget")
  backdoors             Backdoor[]
  tracesAgainst         ActiveTrace[]    @relation("TraceTarget")
  tracesInitiated       ActiveTrace[]    @relation("TraceInitiator")
  personaMessages       PersonaMessage[]

  @@map("users")
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  token            String   @unique
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  isActive         Boolean  @default(true) @map("is_active")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  currentDirectory String?  @map("current_directory")
  lastServerId     String?  @map("last_server_id") // Last connected server for resume

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ==================== PLAYER PROGRESS & SKILLS ====================

model PlayerProgress {
  userId         String @id @map("user_id")
  discoveryLevel Int    @default(0) @map("discovery_level")
  credits        Int    @default(1000)
  level          Int    @default(1)
  experience     Int    @default(0)

  // Skills (0-100)
  hacking      Int @default(10)
  networking   Int @default(10)
  cryptography Int @default(5)
  stealth      Int @default(10)
  socialEng    Int @default(5) @map("social_engineering")
  forensics    Int @default(5)

  // Faction reputation (-100 to +100)
  repMilitary  Int @default(0) @map("rep_military")
  repSwordCorp Int @default(0) @map("rep_sword_corp")
  repAnons     Int @default(0) @map("rep_anons")
  repNeutral   Int @default(0) @map("rep_neutral")

  // Home Server Defenses (0 = not purchased, 1-3 = upgrade level)
  homeFirewall Int     @default(0) @map("home_firewall") // Increases hack prep time for attackers (adds firewall.knock minigame)
  homeVault    Int     @default(0) @map("home_vault") // Encrypted vault dir — multi-layer minigame to crack
  homeIds      Int     @default(0) @map("home_ids") // Intrusion Detection: 1=alert on complete, 2=alert on start, 3=reveal attacker IP
  homeHoneypot Boolean @default(false) @map("home_honeypot") // Creates decoy downloads folder to waste attacker time

  // Inventory and Skills
  inventory Json @default("{}") @map("inventory")
  equipment Json @default("{}") @map("equipment")
  skills    Json @default("{}") @map("skills")

  missionProgress Json     @default("{}") @map("mission_progress")
  achievements    String[] @default([])

  // Stat counters
  commandsExecuted  Int @default(0) @map("commands_executed")
  successfulHacks   Int @default(0) @map("successful_hacks")
  failedHacks       Int @default(0) @map("failed_hacks")
  missionsCompleted Int @default(0) @map("missions_completed")
  serversDiscovered Int @default(0) @map("servers_discovered")
  filesAccessed     Int @default(0) @map("files_accessed")
  messagesSent      Int @default(0) @map("messages_sent")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_progress")
}

model ProgressBackup {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  data      Json // Complete snapshot of user + progress + servers
  reason    String // Why backup was created
  checksum  String? // Data integrity verification
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("progress_backups")
}

// ==================== SERVERS & FILE SYSTEM ====================

model GameServer {
  id                 String   @id @default(cuid())
  name               String
  ipAddress          String   @unique @map("ip_address")
  type               String // ServerType enum: player_home, corporate, government, underground, etc.
  ownerId            String?  @map("owner_id")
  factionId          String?  @map("faction_id")
  securityLevel      Int      @default(1) @map("security_level") // 1-10, affects hack difficulty
  firewallLevel      Int      @default(1) @map("firewall_level") // 1-10, affects detection
  encryptionLevel    Int      @default(0) @map("encryption_level")
  discoveryLevel     Int      @default(0) @map("discovery_level") // Required skill level to discover
  isPlayerHome       Boolean  @default(false) @map("is_player_home") // Flag for player home systems
  isAidaHomeServer   Boolean  @default(false) @map("is_aida_home_server") // Hidden AIDA server
  accessRules        Json     @default("[]") @map("access_rules")
  isOnline           Boolean  @default(true) @map("is_online")
  maxConnections     Int      @default(10) @map("max_connections")
  currentConnections Int      @default(0) @map("current_connections")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Territory/Resource fields (Phase 3)
  resourceType   String? @map("resource_type") // "credits" | "intel" | "compute"
  resourceOutput Int     @default(0) @map("resource_output") // Units per tick
  isContested    Boolean @default(false) @map("is_contested") // True during active contest

  // Network topology fields (Phase 5)
  role      String  @default("general") // "gateway" | "router" | "workstation" | "database" | "email" | "firewall" | "dns" | "general"
  networkId String? @map("network_id")

  // Visibility & Access
  isPublic     Boolean @default(true) @map("is_public") // true = shows in scan, false = must discover IP from files/intel
  accessMethod String  @default("hackable") @map("access_method") // "open" | "hackable" | "keycard" | "hack_or_key"
  accessKey    String? @map("access_key") // passkey required for keycard/hack_or_key access (null = no key needed)

  // Relations
  owner            User?              @relation(fields: [ownerId], references: [id])
  faction          Faction?           @relation(fields: [factionId], references: [id], onDelete: SetNull)
  network          Network?           @relation(fields: [networkId], references: [id], onDelete: SetNull)
  fileSystem       FileSystemNode[]
  connections      ServerConnection[]
  hackLogs         HackLog[]
  contestsAsTarget ServerContest[]    @relation("ContestTarget")
  censorshipRules  CensorshipRule[]
  hackSessions     HackSession[]
  backdoors        Backdoor[]
  activeTraces     ActiveTrace[]
  linksOut         ServerLink[]       @relation("LinkSource")
  linksIn          ServerLink[]       @relation("LinkTarget")
  accessKeys       ServerAccessKey[]
  contentJobs      ContentJob[]

  @@index([ownerId])
  @@index([networkId])
  @@map("game_servers")
}

model ServerAccessKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  serverId     String   @map("server_id")
  keyValue     String   @map("key_value") // the passkey the player discovered
  source       String // "file_download" | "mission_reward" | "shared" | "purchased"
  sourceDetail String?  @map("source_detail") // e.g. file path or mission ID where key was found
  sourceFileId String?  @map("source_file_id") // fileSystemNode ID of downloaded file that granted this key
  discoveredAt DateTime @default(now()) @map("discovered_at")

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId])
  @@map("server_access_keys")
}

model FileSystemNode {
  id             String    @id @default(cuid())
  serverId       String    @map("server_id")
  parentId       String?   @map("parent_id")
  name           String
  type           String // "file" | "directory"
  content        String?
  permissions    Json      @default("{}") // FilePermissions
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  modifiedAt     DateTime  @updatedAt @map("modified_at")
  lastAccessedAt DateTime? @map("last_accessed_at") // Track when file was last read
  lastAccessedBy String?   @map("last_accessed_by") // Track who last accessed it
  size           Int       @default(0)
  isEncrypted    Boolean   @default(false) @map("is_encrypted")
  encryptionKey  String?   @map("encryption_key")
  isHidden       Boolean   @default(false) @map("is_hidden")
  isProtected    Boolean   @default(false) @map("is_protected")
  metadata       Json? // { sourceServerId, sourcePath, downloadedAt, isDownloaded }

  // Relations
  server   GameServer       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator  User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  parent   FileSystemNode?  @relation("FileHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children FileSystemNode[] @relation("FileHierarchy")

  @@index([serverId, parentId])
  @@index([serverId, name])
  @@index([createdBy])
  @@map("file_system_nodes")
}

model ServerConnection {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  serverId         String    @map("server_id")
  connectedAt      DateTime  @default(now()) @map("connected_at")
  disconnectedAt   DateTime? @map("disconnected_at")
  isActive         Boolean   @default(true) @map("is_active")
  sessionData      Json      @default("{}") @map("session_data")
  workingDirectory String    @default("/") @map("working_directory") // Directory on this server
  accessLevel      Int       @default(0) @map("access_level") // Access level achieved (0-10)

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId, serverId])
  @@index([userId, isActive])
  @@map("server_connections")
}

// ==================== MESSAGING SYSTEM ====================

model Message {
  id              String   @id @default(cuid())
  senderId        String   @map("sender_id")
  recipientId     String   @map("recipient_id")
  subject         String
  content         String
  timestamp       DateTime @default(now())
  isRead          Boolean  @default(false) @map("is_read")
  isEncrypted     Boolean  @default(false) @map("is_encrypted")
  encryptionLevel Int?     @map("encryption_level")
  encryptionKey   String?  @map("encryption_key") // Server-side stored encryption key (for AI moderation)
  messageType     String   @default("private") @map("message_type")
  requiredSkill   Json?    @map("required_skill")
  triggerEvent    String?  @map("trigger_event")
  isHidden        Boolean  @default(false) @map("is_hidden")

  sender    User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User            @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reports   MessageReport[]

  @@index([recipientId, isRead])
  @@index([senderId])
  @@map("messages")
}

model MessageReport {
  id         String    @id @default(cuid())
  reporterId String    @map("reporter_id")
  messageId  String    @map("message_id")
  reason     String
  status     String    @default("pending") // "pending" | "reviewed" | "dismissed" | "actioned"
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  reporter User    @relation("MessageReportCreator", fields: [reporterId], references: [id])
  resolver User?   @relation("MessageReportResolver", fields: [resolvedBy], references: [id])
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("message_reports")
}

model Contact {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  contactUserId   String   @map("contact_user_id")
  handle          String
  name            String?
  status          String   @default("unknown") // ContactStatus enum
  lastSeen        DateTime @default(now()) @map("last_seen")
  encryptionLevel Int      @default(0) @map("encryption_level")
  notes           String?
  faction         String?
  createdAt       DateTime @default(now()) @map("created_at")

  owner   User @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactUserId], references: [id])

  @@unique([userId, contactUserId])
  @@map("contacts")
}

// ==================== FORUM SYSTEM (LEGACY) ====================

model ForumPost {
  id               String   @id @default(cuid())
  authorId         String   @map("author_id")
  title            String
  content          String
  forumSection     String   @map("forum_section") // ForumSection enum
  timestamp        DateTime @default(now())
  isHoneypot       Boolean  @default(false) @map("is_honeypot")
  factionAlignment String?  @map("faction_alignment")
  votes            Int      @default(0)
  tags             String[] @default([])
  isSticky         Boolean  @default(false) @map("is_sticky")
  isLocked         Boolean  @default(false) @map("is_locked")

  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]
  faction   Faction?     @relation(fields: [factionId], references: [id])
  factionId String?

  @@map("forum_posts")
}

model ForumReply {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  timestamp DateTime @default(now())
  votes     Int      @default(0)
  isHidden  Boolean  @default(false) @map("is_hidden")

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
}

// ==================== PHASE 3A: ENHANCED FORUM SYSTEM ====================

model Forum {
  id            String           @id @default(cuid())
  name          String           @unique
  url           String           @unique
  description   String           @db.Text
  category      String // 'tech', 'underground', 'darkweb', 'faction'
  securityLevel Int // 1-5 (1=public, 5=deep web)
  isHoneypot    Boolean          @default(false) @map("is_honeypot")
  isActive      Boolean          @default(true) @map("is_active")
  factionId     String?          @map("faction_id")
  requiresProxy Boolean          @default(false) @map("requires_proxy")
  posts         Post[]
  members       ForumMember[]
  discoveredBy  ForumDiscovery[]
  reports       PostReport[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  faction Faction? @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([factionId])
  @@map("forums")
}

model Post {
  id            String   @id @default(cuid())
  forumId       String   @map("forum_id")
  authorId      String   @map("author_id")
  authorHandle  String   @map("author_handle")
  title         String
  content       String   @db.Text
  votes         Int      @default(0)
  tags          String[] @default([])
  isSticky      Boolean  @default(false) @map("is_sticky")
  isPinned      Boolean  @default(false) @map("is_pinned")
  isLocked      Boolean  @default(false) @map("is_locked")
  isHidden      Boolean  @default(false) @map("is_hidden")
  isEncrypted   Boolean  @default(false) @map("is_encrypted")
  viewCount     Int      @default(0) @map("view_count")
  replyCount    Int      @default(0) @map("reply_count")
  storyRelevant Boolean  @default(false) @map("story_relevant")
  keyFragmentId String?  @map("key_fragment_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  forum     Forum        @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id])
  replies   PostReply[]
  postVotes PostVote[]
  reports   PostReport[]

  @@index([forumId])
  @@index([authorId])
  @@index([storyRelevant])
  @@map("posts")
}

model ForumMember {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  forumId    String   @map("forum_id")
  handle     String
  reputation Int      @default(0)
  postCount  Int      @default(0) @map("post_count")
  isAdmin    Boolean  @default(false) @map("is_admin")
  isBanned   Boolean  @default(false) @map("is_banned")
  joinedAt   DateTime @default(now()) @map("joined_at")

  // NPC forum identity + memory (null for real players)
  personality Json? // { description, tone, topics, factionLean }
  memory      Json? // [{ timestamp, userId, username, summary, topic }]

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  forum Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@unique([userId, forumId])
  @@index([userId])
  @@index([forumId])
  @@map("forum_members")
}

model ForumDiscovery {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  forumId      String   @map("forum_id")
  discoveredAt DateTime @default(now()) @map("discovered_at")
  method       String // 'scan', 'intel', 'link', 'story'

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  forum Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@unique([userId, forumId])
  @@index([userId])
  @@map("forum_discoveries")
}

model ProxyConnection {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  proxyServer String   @map("proxy_server")
  location    String
  active      Boolean  @default(true)
  connectedAt DateTime @default(now()) @map("connected_at")
  expiresAt   DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proxy_connections")
}

model PostReply {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  authorId     String   @map("author_id")
  authorHandle String   @map("author_handle")
  content      String   @db.Text
  votes        Int      @default(0)
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyVotes PostVote[]
  reports    PostReport[]

  @@index([postId])
  @@index([authorId])
  @@map("post_replies")
}

model PostVote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  replyId   String?  @map("reply_id")
  value     Int // 1 = upvote, -1 = downvote
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply PostReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, replyId])
  @@index([postId])
  @@index([replyId])
  @@map("post_votes")
}

model PostReport {
  id         String    @id @default(cuid())
  reporterId String    @map("reporter_id")
  postId     String?   @map("post_id")
  replyId    String?   @map("reply_id")
  forumId    String    @map("forum_id")
  reason     String
  status     String    @default("pending") // 'pending', 'reviewed', 'dismissed', 'actioned'
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  reporter User       @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User?      @relation("ReportResolver", fields: [resolvedBy], references: [id])
  post     Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply    PostReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  forum    Forum      @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@index([forumId])
  @@index([status])
  @@map("post_reports")
}

// ==================== PHASE 3A: STORY SYSTEM ====================

model StoryProgress {
  id             String @id @default(cuid())
  userId         String @unique @map("user_id")
  discoveryLevel Int    @default(0) @map("discovery_level") // 0-6

  // AIDA fragments (sword/key/collar × 3 each = 9 total)
  swordFragments  Int @default(0) @map("sword_fragments") // 0-3
  keyFragments    Int @default(0) @map("key_fragments") // 0-3
  collarFragments Int @default(0) @map("collar_fragments") // 0-3

  fragments Json @default("[]") // Array of found fragment IDs

  // AIDA contact
  hasContactedAIDA Boolean @default(false) @map("has_contacted_aida")
  aidaContactCount Int     @default(0) @map("aida_contact_count")
  aidaTrustLevel   Int     @default(0) @map("aida_trust_level") // 0-100

  // Endgame
  endgameUnlocked Boolean @default(false) @map("endgame_unlocked")
  endgameChoice   String? @map("endgame_choice") // 'help' | 'expose' | 'exploit'
  gameCompleted   Boolean @default(false) @map("game_completed")

  // Tracking
  lastDiscoveryAt DateTime? @map("last_discovery_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("story_progress")
}

model IntelligenceReport {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  category       String // 'aida', 'faction', 'server', 'threat'
  title          String
  content        String   @db.Text
  source         String
  importance     Int // 1-5
  isRead         Boolean  @default(false) @map("is_read")
  relatedFaction String?  @map("related_faction")
  triggersEvent  Boolean  @default(false) @map("triggers_event")
  eventType      String?  @map("event_type")
  discoveredAt   DateTime @default(now()) @map("discovered_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isRead])
  @@map("intelligence_reports")
}

model KeyFragment {
  id          String                 @id @default(cuid())
  keyType     String                 @map("key_type") // 'sword' | 'key' | 'collar'
  fragmentNum Int                    @map("fragment_num") // 1, 2, or 3
  name        String
  description String                 @db.Text
  hint        String                 @db.Text
  foundBy     KeyFragmentDiscovery[]

  // Current holder (only one player can hold each fragment at a time)
  heldByUserId String?   @map("held_by_user_id")
  heldSince    DateTime? @map("held_since")

  // Location/trigger
  sourceType String @map("source_type") // 'forum', 'server', 'mission', 'hack'
  sourceId   String @map("source_id")

  // Status: "active" or "bricked" (destroyed from failed fragment.crack attempt)
  status String @default("active")

  @@unique([keyType, fragmentNum])
  @@index([heldByUserId])
  @@map("key_fragments")
}

model KeyFragmentDiscovery {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  fragmentId   String   @map("fragment_id")
  discoveredAt DateTime @default(now()) @map("discovered_at")
  method       String // How they found it

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fragment KeyFragment @relation(fields: [fragmentId], references: [id])

  @@unique([userId, fragmentId])
  @@index([userId])
  @@map("key_fragment_discoveries")
}

// ==================== MISSIONS & EVENTS ====================

model Mission {
  id                      String    @id @default(cuid())
  title                   String
  description             String
  type                    String // MissionType enum
  difficulty              Int       @default(1)
  requiredSkills          Json      @default("{}") @map("required_skills")
  reward                  Json      @default("{}") // MissionReward
  timeLimit               Int?      @map("time_limit")
  targetServerId          String?   @map("target_server_id")
  targetUserId            String?   @map("target_user_id")
  objectives              Json      @default("[]")
  status                  String    @default("available") // MissionStatus enum
  assignedTo              String?   @map("assigned_to")
  createdBy               String?   @map("created_by") // User ID if created by player
  issuedBy                String?   @map("issued_by") // AI Persona ID if created by AI
  factionId               String?   @map("faction_id")
  storyArcId              String?   @map("story_arc_id") // If part of a story arc
  storyStep               Int?      @map("story_step") // Step number within the story arc
  prerequisiteTemplateIds Json?     @map("prerequisite_template_ids") // Template IDs player must have completed before accepting
  createdAt               DateTime  @default(now()) @map("created_at")
  expiresAt               DateTime? @map("expires_at")

  assignee  User?      @relation("MissionAssignee", fields: [assignedTo], references: [id])
  creator   User?      @relation("MissionCreator", fields: [createdBy], references: [id])
  aiPersona AIPersona? @relation(fields: [issuedBy], references: [id])
  faction   Faction?   @relation(fields: [factionId], references: [id])
  storyArc  StoryArc?  @relation(fields: [storyArcId], references: [id], onDelete: SetNull)

  @@index([storyArcId])
  @@map("missions")
}

model StoryArc {
  id               String    @id @default(cuid())
  title            String // "Operation Shadowfall"
  description      String // AI-generated narrative premise
  factionId        String    @map("faction_id")
  issuedBy         String    @map("issued_by") // AI Persona ID (faction leader or game master)
  assignedTo       String    @map("assigned_to") // Player ID
  status           String    @default("active") // active | completed | failed | abandoned
  currentStep      Int       @default(0) @map("current_step")
  totalSteps       Int       @map("total_steps")
  steps            Json      @default("[]") // StoryStep[] — ordered step definitions
  narrativeContext Json      @default("{}") @map("narrative_context") // Accumulating context for AI continuity
  difficulty       Int       @default(3) // 1-10, affects template selection
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  faction  Faction   @relation(fields: [factionId], references: [id])
  persona  AIPersona @relation(fields: [issuedBy], references: [id])
  player   User      @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  missions Mission[]

  @@index([assignedTo, status])
  @@index([factionId])
  @@map("story_arcs")
}

model GameEvent {
  id            String   @id @default(cuid())
  type          String // EventType enum
  title         String
  description   String
  timestamp     DateTime @default(now())
  affectedUsers String[] @map("affected_users")
  metadata      Json     @default("{}")
  isGlobal      Boolean  @default(false) @map("is_global")
  severity      String   @default("info") // EventSeverity enum

  @@map("game_events")
}

model EventSubscription {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  eventType String    @map("event_type") // EventType enum
  targetId  String?   @map("target_id") // serverId, factionId, or userId
  method    String // 'bug', 'hack', 'surveillance', 'insider', 'intercept'
  quality   Int       @default(50) // 0-100, affects event detail/reliability
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_subscriptions")
}

// ==================== SECURITY & HACKING ====================

model HackLog {
  id              String   @id @default(cuid())
  attackerId      String   @map("attacker_id")
  targetId        String   @map("target_id")
  targetServerId  String   @map("target_server_id")
  method          String // HackMethod enum
  tools           String[] @default([])
  stealthLevel    Int      @map("stealth_level")
  success         Boolean
  detected        Boolean
  accessLevel     Int      @map("access_level")
  evidenceLeft    Int      @map("evidence_left")
  counterMeasures String[] @default([]) @map("counter_measures")
  timestamp       DateTime @default(now())
  metadata        Json     @default("{}")

  attacker User       @relation("HackAttacker", fields: [attackerId], references: [id])
  target   User       @relation("HackTarget", fields: [targetId], references: [id])
  server   GameServer @relation(fields: [targetServerId], references: [id])

  @@index([attackerId])
  @@index([targetServerId])
  @@index([timestamp])
  @@map("hack_logs")
}

// ==================== SYSTEM & AUDIT ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  timestamp  DateTime @default(now())
  metadata   Json?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model GameConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("game_config")
}

// ==================== PHASE 3A: FACTION SYSTEM ====================

model Faction {
  id               String   @id @default(cuid())
  name             String   @unique
  shortName        String?  @unique @map("short_name") // 'garrison', 'dothackers', 'cybercorp', 'darknet'
  fullName         String?  @map("full_name")
  description      String   @db.Text
  objective        String?  @db.Text
  ideology         String?  @db.Text
  color            String   @default("#00ff00") // UI theme color
  hostilityLevel   Int      @default(0) @map("hostility_level")
  resources        Json     @default("{}") // { funding: 100, intel: 50, military: 30 }
  knownServers     String[] @map("known_servers")
  activeMembers    Int      @default(0) @map("active_members")
  metadata         Json     @default("{}")
  isHidden         Boolean  @default(false) @map("is_hidden")
  rankRequirements Json     @default("{}") @map("rank_requirements")
  createdAt        DateTime @default(now()) @map("created_at")

  // Phase 5: AI Relations
  aiPersonaId String?    @unique @map("ai_persona_id")
  aiPersona   AIPersona? @relation(fields: [aiPersonaId], references: [id])

  // Relations
  members    FactionMember[]
  standings  FactionStanding[]
  events     FactionEvent[]
  forums     Forum[]
  missions   Mission[]
  servers    GameServer[]
  forumPosts ForumPost[]

  // Territory & Contest relations (Phase 3)
  contestsAttacking ServerContest[]       @relation("ContestAttacker")
  contestsDefending ServerContest[]       @relation("ContestDefender")
  resourceTicks     FactionResourceTick[]

  // Phase 5 relations
  warsAttacking   FactionWar[]     @relation("WarAttacker")
  warsDefending   FactionWar[]     @relation("WarDefender")
  playerAliases   PlayerAlias[]
  censorshipRules CensorshipRule[]

  // Knowledge base
  knowledge FactionKnowledge[]

  // Network topology
  networks Network[]

  // Story arcs
  storyArcs StoryArc[]

  @@map("factions")
}

model FactionMember {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  factionId             String   @map("faction_id")
  rank                  String   @default("recruit") // "recruit", "operative", "elite", "council_member"
  reputation            Int      @default(0)
  totalReputationEarned Int      @default(0) @map("total_reputation_earned")
  joinedAt              DateTime @default(now()) @map("joined_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([userId, factionId])
  @@map("faction_members")
}

model FactionStanding {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  factionId String @map("faction_id")

  reputation Int @default(0) // -100 to +100

  // Status flags
  isHostile Boolean @default(false) @map("is_hostile")
  isAllied  Boolean @default(false) @map("is_allied")
  isNeutral Boolean @default(true) @map("is_neutral")

  // Tracking
  lastAction String?  @map("last_action")
  lastChange Int?     @map("last_change")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([userId, factionId])
  @@index([userId])
  @@index([factionId])
  @@index([reputation])
  @@map("faction_standings")
}

model FactionEvent {
  id        String  @id @default(cuid())
  userId    String? @map("user_id") // null = global event
  factionId String  @map("faction_id")

  eventType   String @map("event_type") // 'reputation', 'attack', 'alliance', 'mission', 'discovery'
  title       String
  description String @db.Text
  impact      String // 'positive' | 'negative' | 'neutral'

  // Effects
  reputationChange Int?  @map("reputation_change")
  resourceChange   Json? @map("resource_change")

  isRead      Boolean  @default(false) @map("is_read")
  triggeredAt DateTime @default(now()) @map("triggered_at")

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([factionId])
  @@index([eventType])
  @@map("faction_events")
}

// ==================== PHASE 5: AI PERSONAS ====================

model AIPersona {
  id           String @id @default(cuid())
  type         String // "game_master", "faction_leader", "aida"
  name         String @unique
  personality  String // JSON: tone, priorities, strategies
  systemPrompt String @map("system_prompt") @db.Text
  model        String @default("llama3.1:8b")

  faction Faction?

  knowledge AIKnowledge[]
  actions   AIAction[]
  missions  Mission[]
  storyArcs StoryArc[]

  lastActionAt DateTime? @map("last_action_at")
  actionsToday Int       @default(0) @map("actions_today")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  personaMessages PersonaMessage[]

  @@map("ai_personas")
}

model AIKnowledge {
  id        String    @id @default(cuid())
  personaId String    @map("persona_id")
  persona   AIPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  source     String // "mission_completion", "forum_post", "player_message", "game_event"
  type       String // "server_location", "player_skill", "file_intel", "faction_activity"
  content    Json // Flexible: { serverId, fileHash, playerId, description, etc. }
  confidence Float  @default(1.0) // 0.0-1.0

  timestamp DateTime  @default(now())
  expiresAt DateTime? @map("expires_at")

  @@index([personaId, type])
  @@map("ai_knowledge")
}

model AIAction {
  id        String    @id @default(cuid())
  personaId String    @map("persona_id")
  persona   AIPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  type   String // "issue_mission", "send_message", "forum_post", "server_action"
  status String @default("pending") // "pending", "processing", "completed", "failed"

  input  Json // Context for AI (e.g., recent events, player actions)
  output Json? // Generated content (mission text, message, etc.)

  triggeredBy String    @map("triggered_by") // "interval", "event:mission_complete", "event:server_hacked"
  executedAt  DateTime? @map("executed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([personaId, status])
  @@index([status, createdAt])
  @@map("ai_actions")
}

model AidaClue {
  id       String @id @default(cuid())
  type     String // "ip_fragment", "coordinate", "access_code", "network_map"
  serverId String @map("server_id") // Server where clue is hidden
  filePath String @map("file_path") // Path to file containing clue
  content  String @db.Text // The actual clue data

  requiredClues String[]  @map("required_clues") // Other clue IDs needed to decode this one
  difficulty    Int // Server security level required
  discovered    Boolean   @default(false)
  discoveredBy  String?   @map("discovered_by") // User ID who found it
  discoveredAt  DateTime? @map("discovered_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([serverId])
  @@index([discovered])
  @@map("aida_clues")
}

model FactionKnowledge {
  id        String  @id @default(cuid())
  factionId String  @map("faction_id")
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  assetType String @map("asset_type") // "server", "file", "player"
  assetId   String @map("asset_id") // ID of the known asset
  assetMeta Json   @default("{}") @map("asset_meta") // { name, ip, serverType, description, ... }

  source       String // "server_discovery", "mission_completion", "player_report", "forum_intel", "persona_observation"
  confidence   Float   @default(0.8) // 0.0-1.0
  discoveredBy String? @map("discovered_by") // userId who contributed this intel

  discoveredAt DateTime  @default(now()) @map("discovered_at")
  expiresAt    DateTime? @map("expires_at")

  @@unique([factionId, assetType, assetId])
  @@index([factionId, assetType])
  @@index([factionId, discoveredAt])
  @@index([expiresAt])
  @@map("faction_knowledge")
}

// ==================== NETWORK TOPOLOGY ====================

model Network {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  factionId   String?  @map("faction_id")
  zone        String // "corporate" | "government" | "underground" | "public" | "darknet"
  isHidden    Boolean  @default(false) @map("is_hidden")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  faction         Faction?         @relation(fields: [factionId], references: [id], onDelete: SetNull)
  servers         GameServer[]
  links           ServerLink[]
  darknetInstance DarkNetInstance?

  @@index([factionId])
  @@map("networks")
}

model DarkNetInstance {
  id            String  @id @default(cuid())
  name          String // Generated name like "Shadow Nexus Alpha"
  networkId     String  @unique @map("network_id") // FK to Network (1:1)
  gatewayIp     String  @map("gateway_ip") // IP of the entry point
  vaultServerId String? @map("vault_server_id") // ID of the vault server (the goal)
  passkey       String // Access code needed to enter the gateway
  depth         Int     @default(4) // Number of servers in the chain
  difficulty    Int     @default(7) // Base difficulty level (1-10)

  // Vault reward
  rewardType String @map("reward_type") // "aida_token", "rare_script", "credits_cache", "intel_package"
  rewardData Json   @default("{}") @map("reward_data") // { tokenName: "AIDA Signal Fragment", amount: 1 }

  // Lifecycle
  status      String    @default("active") // "active", "conquered", "expired", "regenerating"
  conqueredBy String?   @map("conquered_by") // userId who reached the vault
  conqueredAt DateTime? @map("conquered_at")
  forumClueId String?   @map("forum_clue_id") // ID of the ForumPost containing the riddle
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at") // Optional TTL

  // Relations
  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([gatewayIp])
  @@map("darknet_instances")
}

model ServerLink {
  id             String   @id @default(cuid())
  sourceId       String   @map("source_id")
  targetId       String   @map("target_id")
  networkId      String?  @map("network_id")
  linkType       String   @default("lan") // "lan" | "wan" | "vpn" | "backbone" | "hidden"
  bandwidth      Int      @default(100)
  latency        Int      @default(10) // ms
  isActive       Boolean  @default(true) @map("is_active")
  requiredAccess Int      @default(0) @map("required_access") // min access level on source to traverse
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  source  GameServer @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target  GameServer @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  network Network?   @relation(fields: [networkId], references: [id], onDelete: SetNull)

  discoveredBy DiscoveredLink[]

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
  @@index([networkId])
  @@map("server_links")
}

model DiscoveredLink {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  linkId       String   @map("link_id")
  discoveredAt DateTime @default(now()) @map("discovered_at")
  source       String // "scan" | "probe" | "traceroute" | "backdoor" | "mission"

  link ServerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([userId, linkId])
  @@index([userId])
  @@map("discovered_links")
}

// ==================== GAME MECHANICS ====================

model ShopItem {
  id          String @id @default(cuid())
  name        String
  description String @db.Text
  itemType    String @map("item_type") // "software", "hardware", "exploit", "defense"
  category    String @default("general") // "hacking", "stealth", "crypto", "network"
  price       Int
  level       Int    @default(1) // Required player level

  // Item effects
  hackingBonus      Int @default(0) @map("hacking_bonus")
  stealthBonus      Int @default(0) @map("stealth_bonus")
  cryptographyBonus Int @default(0) @map("cryptography_bonus")
  networkingBonus   Int @default(0) @map("networking_bonus")

  // Item properties
  isConsumable Boolean @default(false) @map("is_consumable")
  isStackable  Boolean @default(false) @map("is_stackable")
  maxStack     Int     @default(1) @map("max_stack")
  rarity       String  @default("common") // "common", "uncommon", "rare", "epic", "legendary"

  // Functional effect when used (for consumables/tokens)
  effect Json? // { type: "persona_message", personaId: "..." } or { type: "unlock_area", areaId: "..." }

  // Availability
  isActive    Boolean @default(true) @map("is_active")
  stock       Int? // null = unlimited
  restockTime Int?    @map("restock_time") // minutes

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  inventoryItems InventoryItem[]

  @@index([itemType])
  @@index([category])
  @@index([isActive])
  @@map("shop_items")
}

model InventoryItem {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  shopItemId String  @map("shop_item_id")
  quantity   Int     @default(1)
  isEquipped Boolean @default(false) @map("is_equipped")
  slot       String? // "primary", "secondary", "defense", etc.

  acquiredAt DateTime  @default(now()) @map("acquired_at")
  lastUsedAt DateTime? @map("last_used_at")

  // Consumable tracking
  usesRemaining Int?      @map("uses_remaining")
  expiresAt     DateTime? @map("expires_at")

  // Acquisition tracking
  source   String  @default("shop") // "shop", "mission_reward", "server_loot", "story_event", "admin"
  sourceId String? @map("source_id") // ID of mission/server/event that granted this item

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])

  @@index([userId])
  @@index([shopItemId])
  @@index([isEquipped])
  @@map("inventory_items")
}

model Notification {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  type    String // "info", "warning", "success", "error", "mission", "hack", "message", "faction"
  title   String
  message String @db.Text

  // Notification data
  category String @default("general") // "game", "social", "security", "mission", "faction"
  priority String @default("normal") // "low", "normal", "high", "urgent"
  data     Json   @default("{}") // Additional data (link, action, etc.)

  // Status
  isRead      Boolean   @default(false) @map("is_read")
  isDismissed Boolean   @default(false) @map("is_dismissed")
  readAt      DateTime? @map("read_at")

  // Expiration
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@map("notifications")
}

// ==================== PHASE 3: TERRITORY & CONTESTS ====================

model ServerContest {
  id                 String    @id @default(cuid())
  serverId           String    @map("server_id")
  attackingFactionId String    @map("attacking_faction_id")
  defendingFactionId String?   @map("defending_faction_id")
  initiatedBy        String    @map("initiated_by") // User ID who started the contest
  status             String    @default("active") // "active" | "resolved" | "cancelled"
  decryptionProgress Float     @default(0) @map("decryption_progress") // 0.0 - 1.0
  layers             Json      @default("[]") // Array of challenge layers
  resourceCost       Json      @default("{}") @map("resource_cost") // { credits: X, compute: Y }
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")
  winnerId           String?   @map("winner_id") // Winning faction ID

  server           GameServer           @relation("ContestTarget", fields: [serverId], references: [id], onDelete: Cascade)
  attackingFaction Faction              @relation("ContestAttacker", fields: [attackingFactionId], references: [id], onDelete: Cascade)
  defendingFaction Faction?             @relation("ContestDefender", fields: [defendingFactionId], references: [id])
  participants     ContestParticipant[]

  @@index([serverId])
  @@index([status])
  @@map("server_contests")
}

model ContestParticipant {
  id           String   @id @default(cuid())
  contestId    String   @map("contest_id")
  userId       String   @map("user_id")
  factionId    String?  @map("faction_id") // null = neutral participant
  contribution Float    @default(0) // Total contribution to contest
  side         String // "attack" | "defend" | "neutral"
  joinedAt     DateTime @default(now()) @map("joined_at")

  contest ServerContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@map("contest_participants")
}

model FactionResourceTick {
  id        String   @id @default(cuid())
  factionId String   @map("faction_id")
  credits   Int      @default(0)
  intel     Int      @default(0)
  compute   Int      @default(0)
  tickedAt  DateTime @default(now()) @map("ticked_at")

  faction Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@index([factionId])
  @@index([tickedAt])
  @@map("faction_resource_ticks")
}

// ==================== PHASE 5: WARFARE, ALIAS, DARKNET, CENSORSHIP ====================

model FactionWar {
  id                   String    @id @default(cuid())
  attackerFactionId    String    @map("attacker_faction_id")
  defenderFactionId    String    @map("defender_faction_id")
  declaredBy           String    @map("declared_by") // AI persona ID that declared war
  status               String    @default("active") // "active", "ceasefire", "surrendered", "resolved"
  attackerScore        Int       @default(0) @map("attacker_score")
  defenderScore        Int       @default(0) @map("defender_score")
  reputationMultiplier Float     @default(2.0) @map("reputation_multiplier")
  terms                Json      @default("{}") // surrender/resolution terms
  startedAt            DateTime  @default(now()) @map("started_at")
  endedAt              DateTime? @map("ended_at")

  attackerFaction Faction @relation("WarAttacker", fields: [attackerFactionId], references: [id], onDelete: Cascade)
  defenderFaction Faction @relation("WarDefender", fields: [defenderFactionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([attackerFactionId])
  @@index([defenderFactionId])
  @@map("faction_wars")
}

model PlayerAlias {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  aliasName         String   @unique @map("alias_name")
  aliasEmail        String?  @map("alias_email")
  apparentFactionId String?  @map("apparent_faction_id")
  cost              Int      @default(10000) // credits paid
  isActive          Boolean  @default(true) @map("is_active")
  revealedBy        String[] @map("revealed_by") // user IDs who have unmasked this alias
  createdAt         DateTime @default(now()) @map("created_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apparentFaction Faction? @relation(fields: [apparentFactionId], references: [id])

  @@index([aliasName])
  @@map("player_aliases")
}

model DarkNetDiscovery {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  method       String // "hidden_file", "skill_threshold", "censorship_flags", "breadcrumb_trail"
  metadata     Json     @default("{}") // details about how they discovered it
  discoveredAt DateTime @default(now()) @map("discovered_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("darknet_discoveries")
}

model CensorshipRule {
  id          String   @id @default(cuid())
  factionId   String?  @map("faction_id") // null = system-wide
  serverId    String?  @map("server_id") // null = all servers
  pattern     String // regex pattern to match
  replacement String   @default("[REDACTED]")
  alertTarget String?  @map("alert_target") // persona ID to notify
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  faction Faction?    @relation(fields: [factionId], references: [id], onDelete: SetNull)
  server  GameServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([factionId])
  @@index([isActive])
  @@map("censorship_rules")
}

// ==================== PVP HACKING ====================

model HackSession {
  id                   String   @id
  attackerId           String   @map("attacker_id")
  targetOwnerId        String   @map("target_owner_id")
  targetServerId       String   @map("target_server_id")
  targetIp             String   @map("target_ip")
  method               String
  tools                String[] @default([])
  currentLayer         Int      @default(0) @map("current_layer")
  totalLayers          Int      @map("total_layers")
  status               String   @default("active") // active, completed, failed, expired, aborted
  layersData           Json     @map("layers_data") // MinigameChallenge[] serialized
  layerResults         Json     @default("[]") @map("layer_results") // LayerResult[] serialized
  detectionAccumulator Float    @default(0) @map("detection_accumulator")
  startedAt            BigInt   @map("started_at") // epoch ms
  expiresAt            BigInt   @map("expires_at") // epoch ms
  layerStartedAt       BigInt   @map("layer_started_at") // epoch ms
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  attacker    User       @relation("HackSessionAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  targetOwner User       @relation("HackSessionTarget", fields: [targetOwnerId], references: [id], onDelete: Cascade)
  server      GameServer @relation(fields: [targetServerId], references: [id], onDelete: Cascade)

  @@index([attackerId])
  @@index([status])
  @@map("hack_sessions")
}

model Backdoor {
  id            String    @id @default(cuid())
  installerId   String    @map("installer_id")
  serverId      String    @map("server_id")
  accessLevel   Int       @map("access_level") // 1-10
  type          String    @default("standard") // standard, rootkit, persistent
  isActive      Boolean   @default(true) @map("is_active")
  lastUsed      DateTime? @map("last_used")
  expiresAt     DateTime? @map("expires_at") // null = permanent
  detectionRisk Int       @default(10) @map("detection_risk") // 0-100, increases each use
  metadata      Json      @default("{}") // additional data (method used, tools, etc.)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  installer User       @relation(fields: [installerId], references: [id], onDelete: Cascade)
  server    GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([installerId, serverId]) // one backdoor per player per server
  @@index([serverId])
  @@map("backdoors")
}

model ActiveTrace {
  id            String    @id @default(cuid())
  targetId      String    @map("target_id") // the hacker being traced
  initiatedBy   String    @map("initiated_by") // server owner / system
  serverId      String    @map("server_id") // the server that was hacked
  progress      Int       @default(0) // 0-100 trace completion
  status        String    @default("active") // active, completed, evaded, expired
  evidenceLevel Int       @map("evidence_level") // evidence left during hack
  expiresAt     DateTime  @map("expires_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  target    User       @relation("TraceTarget", fields: [targetId], references: [id], onDelete: Cascade)
  initiator User       @relation("TraceInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)
  server    GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([status])
  @@map("active_traces")
}

model Bounty {
  id                String    @id @default(cuid())
  targetUserId      String    @map("target_user_id") // player with the bounty on their head
  targetUsername    String    @map("target_username") // cached for display
  issuedByFactionId String    @map("issued_by_faction_id") // faction that posted the bounty
  reason            String // "Critical intrusion on CyberCorp Data Vault"
  rewardCredits     Int       @map("reward_credits") // credits for completing
  rewardReputation  Int       @map("reward_reputation") // faction rep for completing
  status            String    @default("active") // "active" | "claimed" | "completed" | "expired"
  claimedByUserId   String?   @map("claimed_by_user_id") // player who accepted the bounty
  completedAt       DateTime? @map("completed_at")
  expiresAt         DateTime  @map("expires_at")
  serverId          String?   @map("server_id") // server where detection happened
  evidenceLevel     Int       @default(0) @map("evidence_level")
  stolenFileIds     Json?     @map("stolen_file_ids") // fileSystemNode IDs of downloaded files to delete
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([targetUserId])
  @@index([issuedByFactionId])
  @@index([expiresAt])
  @@map("bounties")
}

model NarrativeEpoch {
  id          String    @id @default(cuid())
  epochNum    Int       @unique @map("epoch_num")
  title       String // "The Awakening", "Faction Wars", etc.
  description String?   @db.Text // Admin-friendly longer description
  summary     String    @db.Text // AI-generated summary of what defines this epoch
  worldState  Json      @default("{}") @map("world_state") // Snapshot: faction standings, tensions, key events
  triggers    Json      @default("[]") // What conditions/events triggered this epoch
  decisions   Json      @default("[]") // Key Architect decisions during this epoch
  status      String    @default("draft") // "draft" | "active" | "completed" | "archived"
  order       Int       @default(0) // Explicit ordering for admin timeline
  metadata    Json      @default("{}") // Arbitrary admin metadata
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")

  events EpochEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("narrative_epochs")
}

model EpochEvent {
  id          String    @id @default(cuid())
  epochId     String    @map("epoch_id")
  name        String
  description String    @db.Text
  triggerType String    @default("manual") // "scheduled" | "manual" | "condition"
  scheduledAt DateTime? @map("scheduled_at")
  condition   Json? // For condition-based triggers
  payload     Json      @default("{}") // { action: "create_draft"|"architect_intervention"|"world_event"|"advance_epoch"|"toggle_feature", ...data }
  status      String    @default("pending") // "pending" | "fired" | "cancelled" | "failed"
  firedAt     DateTime? @map("fired_at")
  result      Json? // Outcome after firing
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  epoch NarrativeEpoch @relation(fields: [epochId], references: [id], onDelete: Cascade)

  @@index([epochId])
  @@index([status, scheduledAt])
  @@map("epoch_events")
}

model ContentDraft {
  id          String    @id @default(cuid())
  type        String // "server" | "file" | "link" | "mission" | "forum_post" | "network" | "forum"
  title       String
  description String    @db.Text
  payload     Json // Full creation data
  source      String // "ai_content" | "architect" | "admin" | "epoch_event"
  sourceId    String?   @map("source_id")
  status      String    @default("draft") // "draft" | "approved" | "rejected" | "applied"
  reviewNote  String?   @map("review_note") @db.Text
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  appliedAt   DateTime? @map("applied_at")
  resultId    String?   @map("result_id") // ID of created entity after approval
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([source])
  @@index([type])
  @@map("content_drafts")
}

model StoryLedger {
  id          String  @id @default(cuid())
  type        String // "hack", "faction_war", "territory_shift", "fragment_found", "player_choice", "persona_action", "epoch_change", "token_used"
  category    String // "combat", "diplomacy", "discovery", "economy", "narrative", "communication"
  actorId     String  @map("actor_id") // userId or personaId
  actorType   String  @map("actor_type") // "player" or "persona"
  summary     String // Human-readable one-liner
  detail      String? @db.Text // Longer narrative description
  data        Json    @default("{}") // Structured event payload
  impact      Json    @default("{}") // { factions: { garrison: -5, dothackers: +10 }, tension: 3, discoveryWeight: 2 }
  epochNum    Int?    @map("epoch_num") // Which narrative epoch this belongs to
  weight      Int     @default(1) // How significant (1-10), helps Architect prioritize
  isProcessed Boolean @default(false) @map("is_processed") // Has the Architect evaluated this?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([actorId])
  @@index([epochNum])
  @@index([isProcessed, createdAt])
  @@index([category])
  @@map("story_ledger")
}

model PersonaMessage {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  personaId   String  @map("persona_id")
  tokenItemId String? @map("token_item_id") // The inventory item consumed
  direction   String // "outbound" (player→persona) or "inbound" (persona→player)
  subject     String
  content     String  @db.Text
  messageId   String? @map("message_id") // FK to the actual Message record

  createdAt DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona AIPersona @relation(fields: [personaId], references: [id])

  @@index([userId, personaId])
  @@index([personaId])
  @@map("persona_messages")
}

// ==================== CONTENT GENERATION QUEUE ====================

model ContentJob {
  id          String    @id @default(cuid())
  serverId    String    @map("server_id")
  priority    Int       @default(5) // 1=urgent, 5=normal, 10=low
  status      String    @default("pending") // pending | processing | completed | failed
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  error       String?   @db.Text
  requestedBy String?   @map("requested_by")
  options     Json      @default("{}") // { skipAI?: boolean, force?: boolean }
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@index([serverId])
  @@index([createdAt])
  @@map("content_jobs")
}
