# Test Environment Configuration
NODE_ENV=test
PORT=3001
HOST=0.0.0.0

# Test Database
DATABASE_URL=postgresql://mattp4nk@localhost:5432/aida_test

# Security (test values)
JWT_SECRET=test_jwt_secret_key_for_testing_only_min_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=4

# Rate Limiting (relaxed for tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Game Configuration (test values)
MAX_CONCURRENT_PLAYERS=10
SESSION_TIMEOUT_MINUTES=60
HACK_COOLDOWN_SECONDS=1

# Logging (minimal for tests)
LOG_LEVEL=error
DB_LOGGING=false

# Development
DETAILED_ERRORS=true
CORS_ORIGIN=http://localhost:5173

# AI (optional - can be disabled in tests)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
