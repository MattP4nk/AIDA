# Client build-time configuration.
#
# These are baked into the bundle by Vite at BUILD time, not read at runtime —
# changing them requires a rebuild, and a production build with VITE_API_URL
# unset is rejected by vite.config.ts rather than silently shipping a client
# that points at the developer's own machine.
#
# Copy to `.env` for local development. Defaults below match a local server.

# Base URL for the REST API, including the /api suffix.
VITE_API_URL=http://localhost:3001/api

# Base URL for the Socket.IO connection — origin only, no /api suffix.
VITE_SOCKET_URL=http://localhost:3001
