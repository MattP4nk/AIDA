# PLAYER COMPUTER RESOURCE SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@resource_system {
  description: "Player terminal has limited CPU, RAM, BW. Actions become background processes consuming resources + real time. Passive consumers (terminals, connections, backdoors) create ongoing drain."
  file: "server/src/services/memoryService.ts"

  @computer_spec {
    base: "Level 1: CPU 200, RAM 256MB, BW 100Mbps"
    scaling: "+100 CPU, +128MB RAM, +50Mbps BW per 10 levels"
    equipment: "Hardware shop items add flat bonuses"
  }

  @process_costs {
    hack_prep: "CPU 80, RAM 128MB, BW 50 — 60s base, hacking -1s/lvl, min 12s"
    scan: "CPU 40, RAM 32MB, BW 80 — 15s base, networking -0.5s/lvl, min 3s"
    decrypt: "CPU 100, RAM 64MB, BW 0 — 45s base, crypto -1.5s/lvl, min 9s (key: instant ~5s)"
    download: "CPU 10, RAM 64MB, BW 60 — 10s base, networking -0.3s/lvl, min 2s"
    backdoor_install: "CPU 60, RAM 96MB, BW 40 — 90s base, stealth -1.5s/lvl, min 18s"
    traceroute: "CPU 20, RAM 16MB, BW 40 — 8s base, networking -0.2s/lvl, min 2s"
    trace_evade: "CPU 70, RAM 64MB, BW 30 — 30s base, stealth -0.8s/lvl, min 6s"
  }

  @passive_consumers {
    terminal_tab: "CPU 5, RAM 16MB"
    server_connection: "RAM 8MB, BW 15Mbps"
    active_backdoor: "CPU 5, RAM 8MB, BW 10Mbps"
    active_trace: "CPU 15, RAM 16MB, BW 5Mbps"
    os_overhead: "CPU 10, RAM 24MB — always reserved"
  }

  @process_lifecycle {
    flow: "Command → canSpawnProcess() → spawnGameProcess() → 1s tick → on complete fires callback + Socket.IO push"
    events: "process:started, process:progress (5s), process:completed, process:cancelled"
    all_commands: [
      "hack → hack_prep → hackService.initiateHackSession() → minigame via Socket.IO"
      "scan → scan → discoverNeighbors() → results pushed"
      "decrypt → decrypt (fast w/ key, slow brute force) → decrypts file"
      "download → download → copies to ~/downloads/ + access key detection"
      "crack → decrypt → messageService.crackEncryption()"
      "exploit → hack_prep → processHackAttempt(EXPLOIT)"
      "backdoor → backdoor_install → processHackAttempt(BACKDOOR)"
      "rootkit → backdoor_install (min stealth/hacking) → processHackAttempt(ROOTKIT)"
      "traceroute → traceroute → BFS + auto-discovery + table"
      "trace.evade → trace_evade → traceService.evadeTrace()"
    ]
    instant: "backdoor.use, backdoor.list, backdoor.remove, security.scan, trace.status"
  }

  @commands {
    ps: "Running processes + passive consumers + resource summary"
    top: "Resource dashboard: CPU/RAM/BW bars + process list"
    kill: "Cancel process by PID, frees resources"
    free: "RAM breakdown with progress bar"
    uptime: "Session uptime + process count + resources"
  }

  @hardware_shop_items {
    tier_1: "RAM Mk1 (+64MB, 500c), CPU Fan (+50 CPU, 750c), Network Mk1 (+25 BW, 600c)"
    tier_2: "RAM Mk2 (+128MB, 2000c), CPU OC (+100 CPU, 2500c), Fiber (+100 BW, 2200c)"
    tier_3: "Quantum RAM (+256MB, 7500c), Neural Coprocessor (+200 CPU, 8000c), Darknet Relay (+200 BW, 9000c)"
  }
}

