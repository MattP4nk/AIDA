    resolution: "isAIPersonaUsername() / resolvePersonaName() — case-insensitive"
  }

  @token_mechanics {
    find: "findPersonaToken() — finds ShopItems with itemType 'token' + effect.personaName match"
    consume: "consumeToken() — transactional decrement (deletes on last use)"
    check_and_consume: "LIVE BUG (verified 2026-09-24): checkAndConsumeToken() is NOT atomic, despite what this entry used to claim. tokenConsumption.ts:185-196 performs a NON-transactional findPersonaToken read and THEN a separate consumeToken transaction. Only the decrement/delete is atomic; find→consume is racy — the same check-then-spend class CLAUDE.md warns about for credits."
  }

  @bypass_rules {
    tutorial: "hasActiveTutorial() — Architect messages free during active tutorial"
    routing: "shouldRequireToken() — routing decision for token gating"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# PLAYER COMPUTER RESOURCE SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@resource_system {
  description: "Player terminal has limited CPU, RAM, BW. Actions become background processes consuming resources + real time. LIVE WARNING (verified 2026-09-24): the terminal/connection/backdoor passive drain NEVER HAPPENS. registerTerminal / registerConnection / registerBackdoor and their unregister twins (memoryService.ts:319-355) have ZERO CALLERS repo-wide; only registerActiveTrace is ever called (hackService.ts:2032, traceService.ts:550). This is CLAUDE.md bug shape #4 — dead code that looks live."
  file: "server/src/services/memoryService.ts"

  @computer_spec {
    base: "Level 1: CPU 200, RAM 256MB, BW 100Mbps"
    scaling: "+100 CPU, +128MB RAM, +50Mbps BW per 10 levels"
    equipment: "Hardware shop items add flat bonuses"
  }

  @process_costs {
    hack_prep: "CPU 80, RAM 128MB, BW 50 — 60s base, hacking -1s/lvl, min 12s"
    scan: "CPU 40, RAM 32MB, BW 80 — 15s base, networking -0.5s/lvl, min 3s"
    decrypt: "CPU 100, RAM 64MB, BW 0 — 45s base, crypto -1.5s/lvl, min 9s. Corrected 2026-09-24: holding the password does NOT give an 'instant ~5s' — it sets effectiveSkillOverride = max(crypto, 30), which drives the duration down to the 9s minDuration FLOOR."
    download: "CPU 10, RAM 64MB, BW 60 — 10s base, networking -0.3s/lvl, min 2s"
    backdoor_install: "CPU 60, RAM 96MB, BW 40 — 90s base, stealth -1.5s/lvl, min 18s"
    traceroute: "CPU 20, RAM 16MB, BW 40 — 8s base, networking -0.2s/lvl, min 2s"
    trace_evade: "CPU 70, RAM 64MB, BW 30 — 30s base, stealth -0.8s/lvl, min 6s"
  }

  @passive_consumers {
    terminal_tab: "CPU 5, RAM 16MB"
    server_connection: "RAM 8MB, BW 15Mbps"
    active_backdoor: "CPU 5, RAM 8MB, BW 10Mbps"
    active_trace: "CPU 15, RAM 16MB, BW 5Mbps"
    os_overhead: "CPU 10, RAM 24MB — always reserved"
    INERT_WARNING: "Verified 2026-09-24: of the four passive consumers only active_trace is ever registered. The PASSIVE_COSTS entries terminal_tab (memoryService.ts:120), server_connection (:121) and active_backdoor (:122) are INERT — nothing in the repo calls registerTerminal / registerConnection / registerBackdoor."
  }

  @process_lifecycle {
    flow: "Command → canSpawnProcess() → spawnGameProcess() → 1s tick → on complete fires callback + Socket.IO push"
    events: "process:started, process:progress (5s), process:completed, process:cancelled"
    all_commands: [
      "hack → hack_prep → hackService.initiateHackSession() → minigame via Socket.IO"
      "scan → scan → discoverNeighbors() → results pushed"
      "decrypt → decrypt (fast w/ key, slow brute force) → decrypts file"
      "download → download → copies to ~/downloads/ + access key detection"
      "crack → decrypt → messageEncryptionService.crackEncryption() (hackCommands.ts:1022-1030) — NOT messageService (corrected 2026-09-24)"
      "exploit → hack_prep → processHackAttempt(EXPLOIT)"
      "backdoor → backdoor_install → processHackAttempt(BACKDOOR)"
      "rootkit → backdoor_install (min stealth/hacking) → processHackAttempt(ROOTKIT)"
      "traceroute → traceroute → BFS + auto-discovery + table"
      "trace.evade → trace_evade → traceService.evadeTrace()"
    ]
    instant: "backdoor.use, backdoor.list, backdoor.remove, security.scan, trace.status"
  }

  @commands {
    ps: "Running processes + passive consumers + resource summary"
    top: "Resource dashboard: CPU/RAM/BW bars + process list"
    kill: "Cancel process by PID, frees resources"
    free: "RAM breakdown with progress bar"
    uptime: "Session uptime + process count + resources"
  }

  @hardware_shop_items {
    tier_1: "RAM Mk1 (+64MB, 500c), CPU Fan (+50 CPU, 750c), Network Mk1 (+25 BW, 600c)"
    tier_2: "RAM Mk2 (+128MB, 2000c), CPU OC (+100 CPU, 2500c), Fiber (+100 BW, 2200c)"
    tier_3: "Quantum RAM (+256MB, 7500c), Neural Coprocessor (+200 CPU, 8000c), Darknet Relay (+200 BW, 9000c)"
    stacking: "Bonuses DO NOT STACK (verified 2026-09-24): resolveInstalledHardware keeps only the HIGHEST owned tier per channel (gameBalance.ts:122-130), so owning Mk1 and Mk2 yields Mk2's bonus alone."
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# SERVICES REFERENCE
# ═══════════════════════════════════════════════════════════════════════════════

@services {
  total: 62
  pattern: "@injectable(), constructor @inject() deps, singleton in container.ts"
  di_tokens_total: 60
  di_registrations: "57 registerSingleton (55 services + 2 repositories) + 3 registerInstance (Logger, SocketIO, PrismaClient) = 60 total. Recounted 2026-09-24."
  note: "Counts verified 2026-08-31. `total` is files in src/services/ (62), which exceeds registrations because some modules are helpers/generators rather than injected singletons."

  @tutorial {
    TutorialService: "Mail-driven tutorial. Architect sends in-character mails. Players reply for AI hints (context-filtered). Does NOT inject AIService (corrected 2026-09-24) — tutorialService.ts:289-298 takes PrismaClient, MissionService, MessageService, Logger and PlayerMissionRepository, with an explicit comment that there is no AI_SERVICE dependency any more because generation moved to PersonaMailQueueService."
  }

  @helper_files_not_in_di {
    hackMinigameGenerator: "server/src/services/hackMinigameGenerator.ts — internal HackService utility"
    connectionChallengeGenerator: "server/src/services/connectionChallengeGenerator.ts — pure generators + validators for handshake/signal_trace challenges"
    commandHelpers: "server/src/services/commandModules/helpers.ts — shared utilities: resolvePath(), getSession(), getServerId(), spawnBackgroundProcess(), result factories"
    commandRegistry: "server/src/services/commandModules/registry.ts — createAllModules() factory, single source of truth for module registration"
    gameBalance: "server/src/config/gameBalance.ts — centralized skill-scaled gameplay constants (cooldowns, durations, thresholds, challenge configs)"
    missionObjectiveTypes: "server/src/services/missionObjectiveTypes.ts — 37 objective type definitions (recounted 2026-09-24 at missionObjectiveTypes.ts:67; was 34)"
    missionTemplatePool: "server/src/services/missionTemplatePool.ts — 39 template configs"
    tokenConsumption: "server/src/utils/tokenConsumption.ts — Token-gated persona messaging. 5 personas. find/consume/checkAndConsume tokens. Tutorial bypass for Architect."
    aiFallbacks: "server/src/utils/aiFallbacks.ts — Smart fallback generators for AI downtime. Faction-voiced templates for welcome/departure/promotion messages, weighted action decisions, persona replies, forum posts."
    aiOutputValidator: "server/src/utils/aiOutputValidator.ts — 8 validators (Message, Mission, Decision, ContentPlan, ArchitectEval, StoryArc, ForumPosts, ForumReply) + extractJSON() + validateOrRetry() helper with auto-retry on validation failure."
    fileAccessMinigameGenerator: "server/src/services/fileAccessMinigameGenerator.ts — live and imported by hackCommands.ts:8 and fileAccessCommands.ts:16. Was absent from this entire document until 2026-09-24."
    aiAgentTools: "server/src/services/aiAgentTools.ts — AI agent tool definitions, not DI-registered. Added 2026-09-24."
    worldTopologyContext: "server/src/services/worldTopologyContext.ts — not DI-registered. Added 2026-09-24."
  }

  @core {
    GameStateManager: "Session management (in-memory Maps), game state sync, player↔server tracking. Session locks use Map<userId, timestamp> with 30s TTL (stale locks auto-expire)."
    ProgressService: "Auto-save player progress on interval"
    EventService: "Game event pub/sub (EventEmitter), subscription cleanup 5min"
    IPService: "IP allocation per zone (PLAYER 10.x, CORPORATE 172.16.x, GOVERNMENT 192.168.x, UNDERGROUND 169.254.x), player /16 isolation"
    CommandProcessor: "Parse → validate → skill gate → route → execute. Rate limited (10 cmd/s). clearHistory() also cleans rateLimitMap."
    CacheService: "In-memory key-value with TTL. Max 5000 entries with eviction (expired first, then oldest). 60s cleanup interval."
  }

  @network_and_content {
    ServerService: "Server CRUD, connectToServer, discoverServers, security alerts, audit. Injects MissionIntegrationService + FactionKnowledgeService. Corrected 2026-09-24: ServerContentService is NOT a constructor dependency (serverService.ts:134-158)."
    ServerContentService: "AI-first content gen with network context. provisionServerContent() and provisionMissionInfrastructure() are real. provisionAllNetworkServers() IS GONE — deleted, and serverContentService.ts:1887-1891 records that it had ZERO callers (removed from this doc 2026-09-24). Builds NetworkContext, generates role content, plants secrets."
    NetworkTopologyService: "Graph traversal, adjacency, BFS, fog of war, access control, passkey management. THREE caches, not one (networkTopologyService.ts:85-87, corrected 2026-09-24): per-server adjacency 30s, path 30s, full graph 120s."
    ConnectionChallengeService: "Connection minigame sessions. shouldChallenge(), initiateChallenge(), submitAnswer(). Two types: handshake (TCP SYN/ACK) + signal_trace (hex grid). Sends Architect briefing mail on first encounter."
    FileService: "Virtual FS CRUD, AES-256-CBC encryption, permission bitmask, path traversal sandboxing. detectAndGrantAccessKeys() on download only, links via sourceFileId. deleteNode() handles key revocation + honeypot alerts."
    DynamicContentService: "Event-driven content injection. 17 hooks (recounted 2026-09-24 and independently confirmed by a second audit slice; the 9 named here — hack:detected, hack:attempt, bounty:posted, ids_alert, honeypot:triggered, war:declared/ended, mission:completed, contest:resolved — are only a subset). ContentEncoder for encoding. registerHook() extensible."
  }

  @utilities {
    ContentEncoder: "server/src/utils/contentEncoder.ts — base64/caesar/rot13/xor/hex/reverse/ascii. encodeWithMetadata(), template wrappers, randomEncoding(difficulty)."
  }

  @utils_directory {
    description: "server/src/utils/ — 16 files (recounted 2026-09-24; the list below is a partial, corrected inventory). auth.ts, previously listed here, DOES NOT EXIST — control: the same directory listing does show validators.ts and ipUtils.ts."
    files: [
      "asciiAvatars.ts — Server-side avatar gen. 16 ASCII templates, 16 colors. Deterministic hashCode(name). generateAvatar(), getCompactAvatar(), getInlineGlyph (faction-aware: [★_★]/[#_#]/[$_$]/[░◈░]), formatAvatarBlock, renderAvatarWithInfo, renderMessageHeader, renderProfileCard, renderNotificationBadge."
