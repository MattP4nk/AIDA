#           Trust structure and wiring; distrust every number and line citation. See CLAUDE.md section 0.
# Purpose: Single source of truth — system reference + project status

@development_rules {
  rule_1: "Keep this file updated after each task — project's accurate index"
  rule_2: "Describes HOW SYSTEM WORKS, not change history — logs belong in git"
  rule_3: "When adding/modifying system, update relevant section to reflect current state"
  rule_4: "Minimal console logs (except tests). Use pino via @inject(LOGGER)."
  rule_5: "Update @last_updated with brief summary after every task"
}

@project {
  name: "AIDA - Advanced Intrusion Detection & Analysis"
  type: "Multiplayer Terminal Hacking Game"
  version: "1.0.0"
  status: "ACTIVE DEV — PHASE 5 CORE GAME LOOP (missions, trace, socket sessions)"

  @health {
    architecture: "A+"
    implementation: "A+"
    completeness: "97%"
    test_coverage: "0%"
    stability: "A+"
    security: "A"
  }
}

@technology_stack {
  backend: "Node.js 18+ / TypeScript ~5.9.3 / Express ^4.18.2 declared, 4.22.2 installed / Socket.IO 4.8.1"
  database: "PostgreSQL 14+ / Prisma 5.22.0 (@prisma/client + CLI aligned)"
  di: "tsyringe 4.10.0 — all services @injectable(), singletons in container.ts"
  auth: "jsonwebtoken 9.0.2 + bcryptjs 2.4.3 + cookie-parser 1.4.7 — httpOnly cookie (primary) + Bearer header (fallback), 60s TTL auth cache (max 1000, 2min cleanup), per-JWT CSRF tokens"
  logging: "pino 10.1.0 + pino-pretty 13.1.2 — shared instance from logger.ts, injected via @inject(LOGGER)"
  caching: "Custom Map-based CacheService singleton — 60s default TTL, 60s cleanup interval, max 5000 entries with LRU-style eviction"
  ai: "Ollama REST /api/chat — model comes from AI_MODEL || OLLAMA_MODEL env with code default llama3.1:8b (aiService.ts:89-90); the deployed value lives in server/.env, which cannot be read in this environment, and the string 'nemotron' appears in no source file. requestTimeout is 120000ms for BOTH cloud and local, not 60s/120s (aiService.ts:97-98). retryOperation(maxRetries=3) means 3 ATTEMPTS / 2 retries, and the loop throws on the last attempt BEFORE sleeping, so only the 5s and 15s rate-limit backoffs are ever applied — the 45s tier is unreachable (the in-file comment at aiService.ts:195 claiming '5s, 15s, 30s' is wrong a third way; non-rate-limit backoff is 1s/2s). Concurrency throttle: max 2 parallel requests. Agent loop: 28 tools (23 read + 5 creation) in aiAgentTools.ts."
  frontend: "Svelte ^5.39.6 declared, 5.57.0 installed / Vite ^7.1.7 declared, 7.3.6 installed / Socket.IO Client 4.8.1 / TypeScript ~5.9.3"
  security: "helmet 8.3.0 (CSP: mediaSrc data:+blob: for sounds) / cors 2.8.5 (CORS_ORIGIN env parsed as comma-separated array) / express-rate-limit 7.5.1 / compression 1.8.1 / cookie-parser 1.4.7. Command validation is an ALLOW-LIST that REJECTS the whole command — it strips nothing. COMMAND_REGEX (utils/inputValidation.ts:6) permits only alphanumerics, whitespace, single and double quotes, and the set _ . / , @ : = + * # ( ) ! ? ~ % ^ - ; anything outside that fails validation at :28-30 and the command is refused whole. The excluded set is therefore much wider than the five shell metacharacters previously named here. MAX_COMMAND_LENGTH=1000. AI user lookup filters by @ai.aida.internal email."
  validation: "express-validator ^7.0.1 declared, 7.3.0 installed"
  scheduling: "cron 4.3.5"
  dev_runner: "tsx ^4.6.2 declared, 4.20.6 installed (tsx watch for dev)"
  error_handling: "safeExecute (universal handler) + safeAI (AI-specific) + formatServerError (Prisma/JWT/GameError classifier) in server/src/utils/safeExecute.ts"

  @notes [
    "TypeScript and @types/node aligned across server and client (~5.9.3, ^24.6.0)"
    "redis 4.6.10 installed but unused (future session storage + distributed cache)"
    "morgan ^1.10.0 declared, 1.12.0 installed — alongside pino: morgan for HTTP, pino for app logging"
    "shared/handler.ts REMOVED — was from another project (Vue/SweetAlert2), unused by AIDA"
    "All 16 server test files REMOVED — were stale/void. The jest TOOLCHAIN was NOT removed with them: @types/jest ^29.5.8 (server/package.json:49), jest ^29.7.0 (:56) and ts-jest ^29.1.1 (:58) are still declared AND installed as dead devDependencies. There is still no test script and no jest config, so nothing runs them."
  ]
}

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════════════

@architecture {
  principle: "Backend IS Console — client = dumb terminal, server handles all logic"

  @entry_points {
    server: "server/src/index.ts (597 lines) — NOT a thin orchestrator. It wires DI + Socket.IO + Express + lifecycle, but also inlines ~300 lines of persona/AI bootstrap at index.ts:126-433"
    lifecycle: "server/src/lifecycle.ts (173 lines) — graceful shutdown of AI scheduler, resources, warfare, missions, CSRF, Socket.IO and HTTP, plus ProgressService (:50-52), the AI retry queue (:91), the content queue (:98), persona mail (:107), hack timers (:115), and a 15s force-exit watchdog"
    di_container: "server/src/di/container.ts — setupContainer(io, prisma, logger) registers 60 tokens (55 services + 2 repositories + 3 external deps: LOGGER, SOCKET_IO, PRISMA_CLIENT) as singletons: 57 registerSingleton + 3 registerInstance"
    di_tokens: "server/src/di/tokens.ts — 60 string token constants"
  }

  @request_flow {
    http: "Client → POST /api/command/execute {command, serverId?, terminalCols?} → asyncHandler → CommandProcessor → parse → validate → execute → formatOutput(terminalWidth) → respond"
    socket: "Client → 'command:execute' {command, args?, serverId?, terminalId?, terminalCols?} → same pipeline → 'command:result' back"
    auth: "httpOnly cookie (primary) or JWT in Authorization header (fallback) → authenticateToken middleware (60s cache, max 1000 entries, 2min cleanup) → req.userId. On page refresh: App.svelte always calls verifyToken() (cookie-based) to restore in-memory token."
    responsive_output: "Client sends terminalCols (measured from actual container width). Server sets context.terminalWidth (clamped 40-200, -2 safety margin). All panels/tables/boxes use context.terminalWidth. Post-processor (outputFormatter.ts) word-wraps plain text exceeding width. TERM_WIDTH=70 fallback."
  }

  @command_system {
    pattern: "CommandModule interface (commandModules/interface.ts:89-96): category: string (REQUIRED — omitted from earlier versions of this note), commands: Set<string>, execute(command, context), and getCommandInfo?() which is OPTIONAL"
    context: "CommandContext (commandModules/interface.ts:34-79): userId, role, terminalWidth, db, fileService, io?, commandHistory, gameStateManager, modules, playerProgress (PlayerProgressRepository — the ONLY sanctioned writer of player_progress from a command module), and services (24 named service fields plus an [key: string]: any index signature)"
    skill_gating: "skillRequirements.ts — checkSkillRequirement() validates before execution, help filters by skill"
    formatting: "asciiBox.ts — shared box-drawing primitives (panel, table, statusCard, progressBar, etc.). TERM_WIDTH=70 default. table() accepts totalWidth param for auto-column-sizing. outputFormatter.ts post-processes all output for word-wrapping."
    total_commands: 122

    @modules {
      total: 17
      note: "GameCommands split into 4 focused modules. All modules registered in registry.ts."
      list: [
        "SystemCommands (11): ls, cd, pwd, cat, rm, mkdir, touch, cp, mv, echo, write"
        "NetworkCommands (10): scan, servers, connect, disconnect, traceroute, probe, netmap, handshake.ack, signal.trace, connect.abort"
        "HackCommands (23): hack, crack, exploit, backdoor, rootkit, crack.submit, firewall.knock, memory.extract, hack.hint, hack.status, hack.abort, backdoor.list, backdoor.use, backdoor.remove, security.scan, trace.status, trace.evade, crack.dict, crack.mask, crack.pattern, crack.protected, crack.storm, crack.storm.submit"
        "FileCommands (5): upload, download (process-based, copies to ~/downloads/, triggers key detection), encrypt, decrypt, analyze"
        "DefenseCommands (5): defenses, protect, safevault, honeypot, upgrade"
        "SocialCommands (7): msg, mail, inbox, contact, chat, forum, proxy"
        "ShopCommands (9): shop, buy, sell, use, equip, unequip, equipment, gear, scripts"
        "MissionCommands (7): missions, mission, accept, abandon, progress, stories, story (owns missionIndex Map + resolveMissionId)"
        "FragmentCommands (6): fragment/fragments (view/give/steal), endgame, fragment.crack (Sword — offensive), collar.shield (Collar — defensive), key.contact (Key — contact AIDA)"
        "PlayerInfoCommands (11): status, skills, players, who, whois, share_intel, bounties, bounty, leaderboard, achievements, report"
        "HelpCommands (4): help, man, history, stats"
        "ProcessCommands (9): ps, top, kill, pkill, nice, renice, free, uptime, specs"
        "MathCommands (10): calc, expr, math, vars, set, unset, convert (hex/bin/dec/oct + physical units), random, decode (xor/caesar/rot13/base64/ascii/hex), subnet (CIDR)"
        "FactionCommands (1+15 subs): faction list|join|leave|status|missions|rank|promote|standings|resources|servers|contest|war|wars|neutral|help"
        "AliasCommands (1+5 subs): alias create|destroy|info|reveal|help"
        "AdminCommands (1+17 subs): admin status|players|whois|audit|kick|mute|unmute|ban|unban|setrole|broadcast|cleanup|servers|resetpw|reports|resolve|help — the password-reset sub is resetpw, NOT resetpassword (adminCommands.ts:99)"
        "FileAccessCommands (2): sweep, sweep.reveal"
      ]
    }

    @skill_requirements {
      total_gated: 42
      modes: "SkillRequirement.mode — hard (default: refuse below the level), soft (run anyway with a shortfall-scaled penalty, refuse past SKILL_SOFT_BAND), unblockable (never refused; for commands that ANSWER a challenge the game itself forced on the player, where refusing would soft-lock the session)"
      hacking: "hack(20,soft), crack(30,soft), exploit(40,soft), backdoor(50,soft), rootkit(60,soft), fragment.crack(50,hard — failure bricks the fragment), endgame(50). backdoor.list is now UNGATED: its entry was removed deliberately (skillRequirements.ts:118-120), because gating it hid backdoors the player had already earned"
      networking: "scan(5), probe(10), traceroute(15), protect(15), subnet(10), proxy(10), handshake.ack(5,unblockable), signal.trace(5,unblockable), firewall.knock(5,unblockable)"
      cryptography: "crack.submit(5,unblockable), encrypt(10), decrypt(15), safevault(20), decode(10), crack.dict(20,unblockable), crack.mask(25,unblockable), crack.pattern(20,unblockable), crack.protected(40), crack.storm(50), crack.storm.submit(5,unblockable), key.contact(20)"
      stealth: "backdoor.use(20), backdoor.remove(15), trace.evade(25), honeypot(25), collar.shield(30)"
      forensics: "memory.extract(5,unblockable), security.scan(15), analyze(10,soft), sweep(15), sweep.reveal(15,unblockable)"
      social_engineering: "forum(5), share_intel(10), alias:create(15), alias:reveal(20)"
    }
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# ERROR HANDLING ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════════════

@error_handling {
  description: "Three-layer universal error handling system inspired by ejecutarSeguro pattern. All errors go through centralized formatters with structured logging."
  file: "server/src/utils/safeExecute.ts"

  @layer_1_safeExecute {
    description: "Factory that wraps ANY async function with centralized error handling, logging, and fallback."
    pattern: "safeExecute({ fn, context, logger, fallback?, silent?, rethrow?, onError?, onSuccess? })"
    return_type: "With fallback → Promise<TResult> (guaranteed). Without → Promise<TResult | undefined>"
    logging: "silent=true → debug level. silent=false → error level. Always logs via pino."
    usage_count: "162 calls across 29 files (count excludes the 5 occurrences inside the definition file utils/safeExecute.ts)"
    replaces: "~161 manual try/catch blocks"
  }

  @layer_2_safeAI {
    description: "AI-specific wrapper combining generateOrThrow + validateOrRetry + safeExecute + retry queue."
    pattern: "safeAI({ aiService, prompt, systemPrompt, expectedFormat, validate, fallback, context, logger, jsonType?, retry?, onRetrySuccess? })"
    flow: "generateOrThrow() → validateOrRetry() → return validated OR fallback + optional retry queue"
    usage_count: "12 calls across 5 service files — personaService.ts, personaActionService.ts, personaMissionGenService.ts, darknetDungeonService.ts, forumService.ts"
    replaces: "Manual if (!result.success) + validateOrRetry + queueForRetry blocks"
    ai_method: "aiService.generateOrThrow() — wraps generateResponse(), throws on failure instead of returning success=false"
  }

  @layer_3_formatServerError {
    description: "Error classifier used by global Express error handler. Detects Prisma, JWT, GameError, generic errors."
    detects: [
      "Prisma unique constraint (P2002) → 409 UNIQUE_CONSTRAINT"
      "Prisma not found (P2025) → 404 NOT_FOUND"
      "Prisma foreign key (P2003) → 409 FOREIGN_KEY"
      "Prisma invalid invocation → 400 INVALID_QUERY"
      "Prisma schema errors → 500 SCHEMA_ERROR"
      "DB connection errors → 503 DB_CONNECTION"
      "Timeouts → 504 TIMEOUT"
      "JWT errors → 401 AUTH_EXPIRED"
      "GameError subclasses → statusCode from error"
      "Generic → 500 INTERNAL_ERROR"
    ]
    global_handler: "setup.ts setupErrorHandling() — ALL errors (including unhandled Prisma) get clean client-safe JSON response"
  }

  @route_handling {
    pattern: "asyncHandler(async (req, res) => { ... throw new GameError(...) }) — no try/catch needed"
    file: "server/src/middleware/setup.ts — asyncHandler() + setupErrorHandling()"
    coverage: "ALL 52 route handlers across auth.ts, command.ts, 8 admin API files"
    error_classes: "GameError (base), ValidationError (400), AuthorizationError (403), NotFoundError (404), RateLimitError (429) — all in shared/types/error.ts (re-exported via the shared/types/ barrel)"
  }

  @command_handling {
    pattern: "successResult(output, data?) / errorResult(output, error?) — factory functions"
    file: "server/src/services/commandModules/helpers.ts"
    coverage: "ALL 17 command modules use these helpers"
  }

  @ai_fallbacks {
    file: "server/src/utils/aiFallbacks.ts"
    functions: [
      "fallbackWelcomeMessage(faction, player) — faction-specific welcome template"
      "fallbackDepartureMessage(faction, username) — faction-specific departure"
      "fallbackPromotionMessage(faction, rank) — faction-specific promotion"
      "fallbackPersonaReply(persona, faction) — in-character reply template"
      "fallbackForumPost(faction, author) — mundane forum post"
      "fallbackActionDecision(personaType) — weighted persona action"
      "fallbackMissionFlavor(title, faction) — template mission title+description"
      "fallbackStoryStep(title) — template narrative step"
      "fallbackRecruitmentDM() — darknet recruitment message"
    ]
    coverage: "There are only 16 generateResponse call sites in the whole server, not 32: 5 inside aiService.ts itself, 7 in src/scripts/ test harnesses, and 4 real service call sites — darknetDiscoveryService.ts:195, serverContentService.ts:2218, serverContentService.ts:2905, commandModules/fragmentCommands.ts:825. The '32 calls' figure describes a population that does not exist; most AI work now goes through safeAI instead of raw generateResponse."
  }

  @typed_constants {
    file: "shared/types/game.ts (DraftStatus, EpochStatus, ReservedPID) + shared/types/faction.ts (FactionEventType); barrel shared/types/index.ts"
    constants: [
      "DraftStatus: draft | approved | rejected | applied"
      "EpochStatus: draft | active | completed"
      "ReservedPID: HACK_CHALLENGE=-1, CONNECTION_CHALLENGE=-2, FILE_CHALLENGE=-3"
      "FactionEventType: join | leave | neutral"
    ]
    pattern: "as const objects with companion types — compatible with Prisma string queries"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT GENERATION QUEUE
# ═══════════════════════════════════════════════════════════════════════════════

@content_queue {
  description: "Event-driven queue that replaced all fire-and-forget content provisioning. Jobs persist to DB, process sequentially, retry with backoff, notify players."
  file: "server/src/services/contentQueueService.ts"
  token: "CONTENT_QUEUE_SERVICE"
  model: "ContentJob (content_jobs table) — serverId, priority, status, attempts, maxAttempts, error, requestedBy, options, completedAt"

  @priority_levels {
    URGENT: "1 — player actively connecting, needs content NOW"
    NORMAL: "5 — pre-warm from scan, server creation, draft approval"
    LOW: "10 — startup batch, background enrichment"
  }

  @processing {
    interval: "10-second poll (POLL_INTERVAL_MS = 10_000, contentQueueService.ts:65) + 15s COOLDOWN_MS enforced between consecutive non-URGENT jobs (:71, :341)"
    concurrency: "Sequential — one job at a time (respects AI concurrency)"
    retry: "Exponential backoff: 10s × 2^attempt (BACKOFF_BASE_MS = 10_000, contentQueueService.ts:68, :416), max 3 attempts"
    deduplication: "By serverId — upgrades priority if more urgent request arrives"
    persistence: "Jobs survive restarts — rehydrated from DB on start()"
    cleanup: "Completed/failed jobs deleted after 24 hours"
    file_count_check: "Only counts type='file' (not directories) against threshold of 12"
  }

  @trigger_points [
    "1. Server startup — enqueueAllUnpopulated() for servers with fileCount ≤ 8 (LOW, skipAI)"
    "2. Server creation — serverService.createServer() enqueues NORMAL"
    "3. Scan discovery — networkCommands scan pre-warms discovered servers (NORMAL)"
    "4. Connect challenge — first visit enqueues URGENT during puzzle"
    "5. Connect completion — ensureReady() blocks up to 30s or proceeds with partial content"
    "6. Draft approval — contentDraftService approves server draft (NORMAL)"
  ]

  @connect_flow {
    description: "ensureReady(serverId, userId) — fast-path if content exists, else enqueue URGENT + wait"
    timeout: "30 seconds max wait, then connect anyway with partial content"
    waiter_pattern: "Multiple callers on same serverId attach to same job, all resolved on completion"
    notification: "Socket.IO 'command:result' → '[System] Server filesystem loaded.'"
  }

  @replaces [
    "MOST direct provisionServerContent() calls — but ONE remains outside the queue: serverContentService.ts:1962, inside provisionMissionInfrastructure()"
    "Fire-and-forget .catch(() => {}) pattern — all errors now logged + retried"
    "Fire-and-forget provisionAllUnpopulatedServers() — NOTE: the in-memory aiEnrichedServers Set was NOT replaced; it is still live (declared serverContentService.ts:1544, read :1586, written :1667-1668)"
    "provisionAllUnpopulatedServers() — replaced by enqueueAllUnpopulated()"
  ]
}

# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK TOPOLOGY SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@network_topology {
  description: "Servers form explorable graph networks. Players hack through gateways → routers → internal servers. Private servers discovered through file content. Access requires hacking or passkeys."

  @data_model {
    Network: "Named grouping of linked servers (e.g. 'CyberCorp Internal'). Fields: id, name (unique), description, factionId, zone, isHidden, metadata (Json)"
    ServerLink: "Directed edge between servers. Fields: id, sourceId, targetId, networkId, linkType (lan|wan|vpn|backbone|hidden), bandwidth, latency, isActive, requiredAccess. @@unique(sourceId, targetId)"
    DiscoveredLink: "Per-player fog of war. Fields: id, userId, linkId, discoveredAt, source (scan|probe|traceroute|backdoor|mission). @@unique(userId, linkId)"
    ServerAccessKey: "Per-player passkey storage. Fields: id, userId, serverId, keyValue, source (file_download|mission_reward|shared|purchased), sourceDetail, sourceFileId, discoveredAt. @@unique(userId, serverId). schema.prisma:258-278; the sole writer of source='file_download' is fileService.ts:1931"
  }

  @gameserver_fields {
    role: "gateway | router | workstation | database | email | firewall | dns | general"
    networkId: "FK to Network"
    isPublic: "true = visible in scan, false = must find IP in file content"
    accessMethod: "open | hackable | keycard | hack_or_key"
    accessKey: "Passkey string — when player reads file containing this string, auto-gains access"
  }

  @service {
    file: "server/src/services/networkTopologyService.ts"
    token: "NETWORK_TOPOLOGY_SERVICE"

    @methods {
      getAdjacentServers: "All linked servers (bidirectional), cached 30s"
      canTraverse: "Link exists A→B, active, player access meets requiredAccess"
      resolveBackdoorBypass: "Active backdoor on target skips adjacency"
      findPath: "BFS shortest path — used by traceroute, cached 30s"
      discoverNeighbors: "Topology scan: public adjacent servers, creates DiscoveredLink, feeds FactionKnowledge"
      discoverPath: "Auto-discovers all links along path (traceroute)"
      getPlayerTopology: "Discovered subgraph (nodes + edges) up to N hops for netmap"
      checkServerAccess: "Enforces accessMethod: OWNER bypass only (ownerId === userId), then open, hackable, keycard, hack_or_key. There is NO home-server bypass — the isPlayerHome disjunct was deliberately removed because it made every player home world-readable. The default: branch FAILS CLOSED. networkTopologyService.ts:713-723, :761-784"
      playerHasAccessKey: "Checks ServerAccessKey for userId+serverId"
      grantAccessKey: "Upserts ServerAccessKey — called by FileService on credential discovery"
      createBidirectionalLink: "Two ServerLink records (A→B and B→A)"
      createHomeLink: "Links player home to Internet Exchange via 'wan'"
      getNetworkDepth: "BFS hop count from Internet Exchange — for mission difficulty scaling"
    }
  }

  @traversal_rules [
    "1. Home always reachable — 'connect home'/'disconnect' works anywhere (VPN tunnel)"
    "2. Active backdoor bypasses topology — direct jump"
    "3. Otherwise, must have ServerLink from current to target"
    "4. Links have requiredAccess — player access level on source must meet it"
    "5. After adjacency, accessMethod enforced: open/hackable/keycard/hack_or_key"
    "6. Private servers (isPublic=false) hidden from scan — find IP in file content"
  ]

  @commands {
    scan: "Discovers adjacent PUBLIC servers. Shows IP, NAME, ROLE, SECURITY, ACCESS, LINK TYPE. Private hidden."
    connect: "Enforces adjacency → access method → connection challenge (if needed) → connects. 'connect home' always works. Backdoors bypass. First visit always shows challenge."
    disconnect: "Returns home. DiscoveredLink records persist."
    traceroute: "BFS real path. Server names, IPs, roles, latencies. Undiscovered hops = ?.?.?.?. Auto-discovers links."
    probe: "Server role, network, security, ACCESS GRANT STATUS (Granted(Level n) / Denied, via canAccessServer — not the raw accessMethod), link count. networking ≥ 30 + adjacent → shows linked names. networkCommands.ts:1178-1182"
    netmap: "Tree visualization of discovered topology. Box-drawing chars. Depth-limited (default 2, -d deeper)."
  }

  @seeded_networks {
    internet_exchange: "10.0.0.1 [router, open] — backbone hub linking all faction gateways + training + player homes"

    training_network: {
      zone: "training (10.10.10.x)"
      servers: 5
      description: "Safe practice network. 4 of the 5 servers are public + open at security 1; the Training Firewall is public but hack_or_key at security 3. seed.ts:869-899"
      structure: [
        "[Gateway] Training Gateway 10.10.10.1 sec:1 — public, open"
        "  ├─[Workstation] Training Terminal 10.10.10.10 sec:1"
        "  │   └─[Database] Training Archive 10.10.10.20 sec:1 (cross-linked, has /data/classified/faction_overview.doc)"
        "  ├─[Email] Training Comms 10.10.10.11 sec:1"
        "  └─[Firewall] Training Firewall 10.10.10.30 sec:3 — public, hack_or_key (TRN-FW-*) (tutorial step 5). seed.ts:869-899, 1735-1743"
      ]
      purpose: "Tutorial steps 1-5 (explore, download, faction, report, hack). Static tutorial content."
    }

    garrison_defense_grid: {
      zone: "government (192.168.1.x)"
      servers: 8
      structure: [
        "[Gateway] garrison-gw 192.168.1.1 sec:8 fw:9 — public, hackable"
        "  ├─[Firewall] garrison-fw 192.168.1.2 sec:9 — private, hack_or_key (GRN-FW-*)"
        "  │   ├─[Workstation] garrison-ops 192.168.1.10 sec:6 — private, hack_or_key"
        "  │   └─[Email] garrison-mail 192.168.1.11 sec:5 — private, hack_or_key"
        "  ├─[Router] garrison-core 192.168.1.3 sec:7 — private, hackable"
        "  │   ├─[Database] garrison-intel 192.168.1.20 sec:9 — private, keycard (GRN-INT-*)"
        "  │   └─[Database] garrison-classified 192.168.1.21 sec:10 — private, keycard (GRN-CLS-*)"
        "  └─[DNS] garrison-dns 192.168.1.4 sec:5 — public, hackable"
      ]
      employees: ["Commander Steele" "Agent Voss" "Lt. Mora" "Sgt. Reeves" "Cpl. Park" "Major Blackwood" "...15 total"]
      secrets: ["operation (.op_shadowstrike.enc on email)" "personnel (.undercover_agents.dat on workstation)" "strategic (.defense_grid_codes.key on gateway)"]
    }

    cybercorp_internal: {
      zone: "corporate (172.16.1.x)"
      servers: 8
      structure: [
        "[Gateway] cybercorp-gw 172.16.1.1 sec:6 fw:7 — public, hackable"
        "  ├─[Router] cybercorp-core 172.16.1.2 sec:5 — private, hackable"
        "  │   ├─[Workstation] cybercorp-dev 172.16.1.10 sec:4 — private, hackable"
        "  │   ├─[Email] cybercorp-mail 172.16.1.11 sec:4 — private, hackable"
        "  │   └─[Database] cybercorp-vault 172.16.1.20 sec:8 — private, keycard (CC-VLT-*)"
        "  ├─[Firewall] cybercorp-dmz 172.16.1.3 sec:7 — private, hack_or_key (CC-DMZ-*)"
        "  │   └─[Workstation] cybercorp-web 172.16.1.30 sec:3 — public, hackable"
        "  └─[DNS] cybercorp-dns 172.16.1.4 sec:4 — public, hackable"
      ]
      employees: ["Dr. Sarah Chen" "Marcus Webb" "Yuki Tanaka" "R. Blackwell" "Elena Voss" "James Harrington III" "...15 total"]
      secrets: ["financial (.project_nightfall_financials.xls on DB)" "operation (.acquisition_targets.memo on email)" "technical (.vault_master_key.pem on firewall)"]
    }

    dothackers_mesh: {
      zone: "underground (169.254.1.x)"
      servers: 6
      structure: [
        "[Gateway] dh-relay 169.254.1.1 sec:4 enc:4 — public, hackable"
        "  ├─[Router] dh-node1 169.254.1.2 sec:3 — private, hackable"
        "  │   ├─[Workstation] dh-safehouse 169.254.1.10 sec:2 — private, hackable"
        "  │   └─[Database] dh-drops 169.254.1.20 sec:5 — private, hack_or_key (DH-DRP-*)"
        "  └─[Router] dh-node2 169.254.1.3 sec:3 — private, hackable"
        "      └─[Email] dh-deadletter 169.254.1.11 sec:4 — private, hackable"
      ]
      employees: ["gh0st" "nullbyte" "sp1k3" "cr4sh" "z3r0day" "ph4ntom" "...15 total"]
      secrets: ["operation (.op_truthbomb.plan on workstation)" "technical (.zero_days.stash on DB)"]
    }

    darknet: {
      zone: "hidden (203.0.113.x)"
      servers: "4 static + procedural dungeons"
      structure: [
        "[Gateway] Unknown Signal Source 203.0.113.1 sec:10 fw:10 — private, keycard (AIDA-*), isAidaHomeServer"
        "  ├─[Database] Phantom Archive 203.0.113.10 sec:10 fw:10 — private, keycard"
        "  └─[Router] Ghost Relay 203.0.113.2 sec:8 fw:8 — private, hack_or_key (AIDA-MSH-*), NOT keycard"
        "      └─[Router] [DarkNet] Signal Relay 203.0.113.50 sec:5 — private, hackable (resolves unknown.darknet)"
      ]
      secrets: ["aida_fragment (.signal_fragment_0x7A.dat)" "strategic (.faction_analysis.enc)"]
      procedural_dungeons: "DarkNetDungeonService generates ephemeral chains of DEPTH 3-7 — servers = depth + 1, so 4-8 servers (default roll is depth 4-6 → 5-7 servers). darknetDungeonService.ts:241-246. Escalating security, encrypted clues, AI-generated forum riddles, vault rewards. Auto-regenerates on conquest or 7-day expiry."
      employees: ["[SIGNAL]" "[ECHO]" "[NULL]" "[VOID]" "[FRAGMENT]" "...10 total (not 15 — darknet is the short roster)"]
    }

    cybercorp_black_sites: {
      zone: "corporate (172.16.99.x) — the seeded Network.zone is 'corporate'; 'corporate-black' is only an OUTPUT of resolveTopologyFromIP(), never a stored zone"
      servers: 1
      structure: ["[Database] Silver Tower 172.16.99.1 sec:7 — private, keycard (CC-SLV-*), Project Echo data"]
      purpose: "Off-books CyberCorp black site. Referenced in gh0st forum post + CyberCorp DNS hidden zone file."
    }

    phantom_network: {
      zone: "underground (198.51.100.x) — the seeded Network.zone is 'underground'; 'rogue' is only an OUTPUT of resolveTopologyFromIP(), never a stored zone"
      servers: 3
      structure: [
        "[Gateway] Phantom Gateway 198.51.100.1 sec:6 — private, hackable"
        "  ├─[Workstation] Phantom Probe Node 198.51.100.33 sec:5 — the SSH brute-forcer from firewall logs"
        "  └─[Database] Phantom Dead Drop 198.51.100.44 sec:4 — exfiltrated data manifest"
      ]
      purpose: "Rogue hackers. No faction. Resolves blocked IPs from firewall/log templates. Investigation trail for players."
    }

    standalone: ["TechCorp Main Server 172.16.0.1 sec:3" "Underground Hub 169.254.0.1 sec:5 (seed.ts:922-935)"]
  }

  @ip_ranges {
    "10.0.0.x": "Internet Exchange (public backbone)"
    "10.10.10.x": "Training Network (tutorial, sec:1-2)"
    "169.254.x.x": "Underground / dotHackers (VPN mesh, sec:3-5)"
    "172.16.0-1.x": "Corporate / CyberCorp (internal, sec:4-8)"
    "172.16.99.x": "CyberCorp Black Sites (hidden, sec:7+)"
    "192.168.x.x": "Government / Garrison (defense grid, sec:5-10)"
    "198.51.100.x": "Phantom Network (rogue, sec:4-6)"
    "203.0.113.x": "DarkNet (hidden, sec:5-10)"
    resolver: "resolveTopologyFromIP() in referenceValidationService.ts — maps IP → network, faction, gateway, security, link type"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# ADMIN SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@admin_system {
  description: "Full CRUD admin panel for world-building. REST API + web panel served at /admin."
  auth: "requireRole('admin') — role hierarchy: player(0) → moderator(1) → admin(2)"

  @api_routes {
    base: "/api/admin"
    router: "server/src/routes/adminApi.ts → mounts 8 sub-routers. All endpoints use asyncHandler + GameError. PUT routes allowlist fields (no raw req.body to Prisma)."
    sub_routers: [
      "servers.ts — CRUD + files + links (9 endpoints)"
      "networks.ts — CRUD (5 endpoints)"
      "missions.ts — CRUD (5 endpoints)"
      "forums.ts — CRUD + posts (6 endpoints)"
      "epochs.ts — CRUD + events + activate/fire (11 endpoints)"
      "drafts.ts — list + approve/reject (5 endpoints)"
      "stats.ts — dashboard aggregates (1 endpoint)"
      "players.ts — view + modify progress/role (4 endpoints)"
    ]
    total_endpoints: 46
    total_endpoints_breakdown: "9 + 5 + 5 + 6 + 11 + 5 + 1 + 4 = 46"
    admin_gated_routes_outside_this_router: "GET /api/stats/sessions (moderator) and POST /api/admin/cleanup-sessions (admin) — admin.ts:27, :48. Not counted in the 46."
  }

  @content_drafts {
    model: "ContentDraft — type, title, payload (Json), source, status (draft→applied | rejected). There is NO intermediate 'approved' state: approveDraft() writes status:'applied' directly (contentDraftService.ts:119) and the string 'approved' appears nowhere in server/src. The schema comment that lists it is dead."
    service: "ContentDraftService (server/src/services/contentDraftService.ts)"
    token: "CONTENT_DRAFT_SERVICE"
    purpose: "AI-created content goes through admin review before publishing to game world"
    types: ["server", "file", "link", "mission", "forum_post", "network", "forum"]
    sources: ["ai_content", "architect", "admin", "epoch_event"]
    approve_flow: "approveDraft(id) → executeDraftPayload(type, payload) → creates GameServer/FileSystemNode/ServerLink/Mission/Post/Forum/Network → sets resultId"
  }

  @reference_validation {
    service: "ReferenceValidationService (server/src/services/referenceValidationService.ts)"
    token: "REFERENCE_VALIDATION_SERVICE"
    purpose: "Ensures AI content references real IPs/URLs. Auto-creates ContentDrafts for missing entities."
    topology_resolver: "resolveTopologyFromIP() maps IP ranges → network, faction, gateway, security, link type"
    methods: [
      "validateAndBackfillReferences(content, source) — scans for IPs/URLs, creates drafts for missing ones + link drafts"
      "generateInvestigationChain(serverId, depth, theme) — uses AI agent loop to create multi-step clue trails"
    ]
    admin_endpoint: "POST /api/admin/servers/:id/investigation-chain"
  }

  @ai_agent_tools {
    file: "server/src/services/aiAgentTools.ts"
    purpose: "Tool-use system letting AI query AND create game entities mid-conversation. AI can look up real data, react to player activity, and invent new world content."
    loop: "runAgentLoop(aiService, prisma, systemPrompt, userPrompt, logger, maxRounds=6)"
    flow: "AI receives tool list → responds with {tool, params} → server executes query → AI gets results → continues or gives {final: true, result: ...}. Max 5 tool calls per request."
    total_tools: 28

    @query_tools_world [
      "get_networks — all networks + server counts"
      "get_servers — servers filtered by network/faction/type"
      "get_server_details — full info + files + links"
      "get_ip_ranges — IP range conventions per zone"
      "search_files — search file content across servers"
    ]

    @query_tools_factions [
      "get_factions — factions + members + leaders"
      "get_faction_knowledge — faction intel DB (what they know)"
      "get_active_wars — ongoing faction conflicts"
      "get_censorship_rules — monitored/banned topics per faction"
    ]

    @query_tools_story [
      "get_recent_events — story ledger events"
      "get_current_epoch — active epoch + events"
      "get_story_arcs — ongoing narrative threads"
      "get_key_fragments — AIDA endgame artifact status"
      "get_ai_personas — NPC personalities + system prompts"
    ]

    @query_tools_social [
      "get_forums — forums + post counts"
      "get_forum_posts — posts from a specific forum"
      "get_players — active players + levels + factions"
      "get_shop_items — available tools/software/upgrades"
    ]

    @query_tools_activity [
      "get_player_activity — specific player's hacks, missions, skills"
      "get_recent_hack_activity — who's hacking what across the game"
      "get_active_backdoors — persistent access across servers"
      "get_server_access_keys — discovered keys per server"
      "get_active_bounties — active bounties: who has a price on their head and why (aiAgentTools.ts:264)"
    ]

    @creation_tools [
      "create_server — invent new server (auto-linked to gateway via IP range topology)"
      "create_network — invent new network"
      "create_file — plant file on any server (clues, evidence, logs)"
      "create_link — connect two servers"
      "create_forum_post — post on any forum (rumors, intel, propaganda)"
    ]
    creation_note: "All creations go through ContentDraft → admin reviews before publishing"

    @integration {
      world_topology: "enrichWithTopology(basePrompt, prisma, logger) in worldTopologyContext.ts — shared helper used by all AI services to inject real game IPs/servers/networks into prompts. Cached 5 min."
      agent_loop_services: [
        "serverContentService — lore + ambient file generation (with fallback to direct call)"
        "storyProgressionService — Architect evaluation"
        "personaActionService — director + faction leader decisions"
        "referenceValidationService — investigation chain generation"
      ]
      topology_context_services: [
        "personaService — welcome/departure/promotion/war messages"
        "personaMissionGenService — mission flavor text"
        "storyMissionService — story arc generation"
        "forumService — AI forum replies + NPC posts"
        "darknetDungeonService — dungeon riddles + lore files"
        "missionGenerator — daily mission descriptions"
      ]
      no_context_services: [
        "tutorialService — Architect hints (tutorial-scoped)"
        "messageService — persona replies (conversational)"
        "darknetDiscoveryService — AIDA riddles (self-contained)"
      ]
    }
  }

  @epochs {
    model: "NarrativeEpoch (extended) — status (draft/active/completed), order, description"
    events_model: "EpochEvent — triggerType (scheduled/manual/condition), payload, status"
    scheduler: "EpochSchedulerService (server/src/services/epochSchedulerService.ts) — 1-min interval"
    token: "EPOCH_SCHEDULER_SERVICE"
    purpose: "Named story phases with scheduled events. Admin controls macro timeline."
    event_actions: ["create_draft", "architect_intervention", "world_event", "advance_epoch", "toggle_feature"]
    flow: "Scheduler checks every 60s → finds pending events with scheduledAt <= now in active epoch → fireEvent() executes payload action → markEventResult writes status fired|failed. ONLY status='pending' is ever re-read, so writing 'fired' SPENDS the event permanently."
    advance_epoch_semantics: "handleAdvanceEpoch finds the successor BEFORE retiring the current epoch, and refuses to retire the last one (that would leave zero active epochs, and the method requires one to start — it would strand the world). Both exits return a shared {advanced: boolean, ...} shape. When no draft successor exists it returns advanced:false and the event is LEFT PENDING rather than marked fired — previously it was recorded as status 'fired', success:true, which meant authoring the next epoch later could never advance to it. A handler that declines to act must not consume its event. (2026-09-24)"
  }

  @panel {
    location: "server/public/admin/"
    serving: "Express static at /admin, but ONLY when isDevelopment (setup.ts:160; NODE_ENV === 'development', environment.ts:124). The panel is NOT served in production."
    static_path_auth: "SECURITY: there is NO auth middleware on the static path. requireRole('admin') guards /api/admin/* only. The isDevelopment gate is the ONLY guard on the panel's static assets."
    tech: "Plain HTML/CSS/JS, dark terminal theme, no build step"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# CONNECTION CHALLENGE SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@connection_challenge {
  description: "Minigame shown when connecting to servers. Masks AI content provisioning latency while adding gameplay. Two challenge types selected by server context."

  @trigger_rules {
    home_server: "Always instant — no challenge"
    first_visit: "ALWAYS challenge (AI content provisions in background during puzzle)"
    revisit_with_backdoor: "Skip challenge — backdoor bypasses auth"
    revisit_security_1_2: "Instant — no challenge"
    revisit_security_3_5: "At 0 networking skill: sec 3 → easy, sec 4 → easy, sec 5 → MEDIUM (not uniformly simple)"
    revisit_security_6_plus: "At 0 networking skill: sec 6 and sec 7 are still MEDIUM; hard requires sec 8+"
  }

  @challenge_types {
    handshake: {
      trigger: "UNCONDITIONAL DEFAULT. selectChallengeType() only tests membership in the signal_trace zone set; everything else falls through to 'handshake' (connectionChallengeGenerator.ts:30-37)"
      description: "TCP-style SYN/ACK puzzle. Player sees table of SYN packets with SEQ, PORT, FLAGS, WINDOW."
      task: "Identify valid SYN packets (non-RST, window > 0), calculate ACK = SEQ + 1, submit in ascending port order."
      command: "handshake.ack <ack1> <ack2> ..."
      difficulty_scaling: "Easy (3 packets, 2 real), Medium (5 packets, 3 real), Hard (7 packets, 4 real)"
    }

    signal_trace: {
      trigger: "Zone set is exactly {underground, darknet, hidden} (gameBalance.ts:485-486) — note 'hidden' is in the set and 'dothackers' is not a zone"
      description: "Hex grid puzzle. Signal starts at marked cell, follows fixed hex increment pattern through adjacent cells."
      task: "Trace the signal path from origin through N hops, identify endpoint cell."
      command: "signal.trace <cell>  (e.g. C4)"
      difficulty_scaling: "Easy (4x6 grid, 3 hops, no noise), Medium (5x8 grid, 4 hops, 1 noise cell), Hard (6x10 grid, 5 hops, more noise). Noise is NOT hard-only — gameBalance.ts:459-461"
    }
  }

  @difficulty {
    formula: "base = isFirstVisit ? clamp(1, 8, securityLevel) : max(1, securityLevel - 1); reduction = networkingSkill / (isFirstVisit ? 50 : 40); final = clamp(1, 10, ROUND(base - reduction)). gameBalance.ts:472-482 — the revisit branch and the rounding are both load-bearing."
    skill_bonuses: "Two DIFFERENT thresholds: handshake hint at networking ≥ 30 (gameBalance.ts:149); signal_trace second-cell hint at networking ≥ 40 (gameBalance.ts:277-279)"
    tiers: "1-3 = easy, 4-6 = medium, 7-10 = hard"
  }

  @files {
    generator: "server/src/services/connectionChallengeGenerator.ts — pure module (no DI): generateHandshakeChallenge(), generateSignalTraceChallenge(), validateConnectionAnswer(), selectChallengeType()"
    service: "server/src/services/connectionChallengeService.ts — DI singleton: shouldChallenge(), initiateChallenge(), submitAnswer(), session tracking + expiry timers"
    token: "CONNECTION_CHALLENGE_SERVICE"
    config: "server/src/config/gameBalance.ts — HANDSHAKE_CONFIG, SIGNAL_TRACE_CONFIG, CONNECTION_CHALLENGE_SKIP_THRESHOLD"
    types: "shared/types/hack.ts:110,112,122 — ConnectionChallengeType, ConnectionChallenge, ConnectionSessionInfo"
  }

  @flow [
    "1. Player types 'connect <ip>'"
    "2. networkCommands.handleConnect() validates topology + access"
    "3. connectionChallengeService.shouldChallenge() checks trigger rules"
    "4. If needed: initiateChallenge() generates puzzle, starts expiry timer"
    "5. Content queued via ContentQueueService.enqueue(serverId, URGENT) — processes during puzzle"
    "6. Challenge displayed in client sticky panel (cyan/blue theme)"
    "7. Player submits via 'handshake.ack' or 'signal.trace'"
    "8. On success: contentQueue.ensureReady() waits up to 30s for content"
    "9. completeConnection() runs standard connect flow"
    "10. On failure/timeout: player must re-run 'connect' for new challenge"
    "11. First-ever challenge triggers Architect briefing mail (one-time)"
  ]

  @architect_briefing {
    trigger: "First connection challenge per player (checked via DB + in-memory set)"
    sender: "The Architect (game_master persona)"
    subject: "Network Security Protocols"
    content: "Explains both challenge types with step-by-step instructions, commands, and tips"
  }

  @client {
    store: "activeConnectionSession (socket.ts) — mirrors activeHackSession pattern"
    panel: "Terminal.svelte — sticky connection-challenge-panel with cyan theme, shows displayText + hints"
    events: "command:result data.connectionSessionId triggers panel, data.connectionResolved clears it"
  }

  @commands {
    "handshake.ack": "Submit ACK sequence for TCP handshake challenge (networking 5)"
    "signal.trace": "Submit endpoint cell for signal trace challenge (networking 5)"
    "connect.abort": "Cancel active connection challenge (ungated)"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# WORLD LORE
# ═══════════════════════════════════════════════════════════════════════════════

@world_lore {
  description: "Canonical source of truth for game narrative. All AI prompts, personas, content generators consume these constants."
  file: "server/src/lore/worldLore.ts (~1138 lines)"

  @exports {
    WORLD_BACKSTORY: "Full backstory (~60 lines): Emperor, AIDA creation, 100-year reign, Shattering, four faction motivations"
    WORLD_BACKSTORY_SHORT: "Condensed for token-limited AI prompts"
    FACTION_LORE: "Per-faction backstory (garrison, dothackers, cybercorp, darknet)"
    FACTION_VOICE: "Writing style/tone per faction for AI content generation"
    FACTION_FILE_FLAVORS: "Per-faction file name patterns, topics, hidden file hints for ServerContentService"
    AIDA_PIECES: "3 AIDA fragments — Sword (offensive capacity), Key (infiltration capacity), Collar (control program binding AIDA). Each with 6 loreHints."
    EMPEROR_LORE: "Extended Emperor backstory"
    LOCATIONS: "Lore entries: NetSlum (underground market), Silver Tower (CyberCorp HQ), Deep Grid (infra), DarkNet (hidden layer)"
    DARKNET_SERVER_THEMES: "5 depth-tiered theme configs (gateway/early/middle/deep/vault) for dungeon content"
    CRYPTIC_QUOTES: "24 atmospheric one-liners for clues, forums, dungeons"
    FACTION_MUNDANE_THEMES: "Per-faction mundane content (workFiles, personalFiles, gossip, ambientLogs) — servers feel inhabited"
    INDEPENDENT_SERVER_THEMES: "14 themed profiles for non-faction servers: trade_hub, news_relay, personal_terminal, retired_hacker, medical, university, entertainment, abandoned, freelancer, black_market, isp, dead_drop, religious, pirate_radio"
    AMBIENT_NEWS_POOL: "24 network-wide headlines for background flavor"
    EASTER_EGG_POOL: "16 rare fun/absurd file descriptions. 30% chance per server."
  }

  @narrative_core {
    premise: "AIDA = sentient AI shattered into 3 pieces (Sword, Key, Collar) by Emperor. 4 factions compete to find/prevent reassembly. Architect observes + guides from shadows."
    factions: {
      garrison: "Government/military — contain AIDA, maintain order"
      dothackers: "Anarchist hackers — free AIDA, expose corruption"
      cybercorp: "Corporate — weaponize AIDA for profit/power"
      darknet: "Hidden faction led by AIDA — inscrutable objectives"
    }
    key_figures: ["Emperor (AIDA creator)" "Architect (game master AI)" "AIDA (shattered sentient AI)" "Commander Steele (Garrison)" "gh0st (dotHackers)" "Director Chen (CyberCorp)"]
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONTENT ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

@content_engine {
  description: "Two-process AI content gen. Process 1 (Lore): serious/dark/enigmatic, 2-4 faction-critical files 400+ chars — faction servers only. Process 2 (Ambient): voice varies, 4-6 mundane files 400+ chars — all servers. Both independent, results merged. Static content is NOT a fallback: Tier 1 static is ALWAYS generated and awaited BEFORE any AI call, and the AI layers on top of it. When AI output comes back empty the ambient prompt is QUEUED FOR RETRY — nothing falls back. serverContentService.ts:1594-1640, :1707-1726"
  file: "server/src/services/serverContentService.ts"
  token: "SERVER_CONTENT_SERVICE"

  @generation_pipeline {
    overview: "provisionServerContent(serverId) runs two-tier pipeline: Tier 1 (static, awaited) + Tier 2 (AI enrichment, background). Called via ContentQueueService — EXCEPT for one direct caller that bypasses the queue: provisionMissionInfrastructure() at serverContentService.ts:1962."
    steps: [
      "1. ContentQueueService.enqueue(serverId, priority) — persistent DB job"
      "2. Queue processes job → provisionServerContent(serverId, options)"
      "3. buildNetworkContext(server) — queries links, network, faction, generates roster + secrets"
      "4. resolveFactionKey(ctx) — determines faction (garrison/dothackers/cybercorp/darknet)"
    ]

    @process_1_lore {
      trigger: "Faction servers only"
      system: "LORE_SYSTEM_PROMPT — serious/dark/enigmatic, backstory context, AIDA pieces, 400+ char, 2-4 files"
      user: "buildLorePrompt(ctx) — faction lore+voice, file patterns, topic, hidden seed, quote, AIDA hint, role instructions"
      output: "2-4 dirs, 2-4 files (1+ hidden). Classified docs, transmissions, memos, confessions."
    }

    @process_2_ambient {
      trigger: "All servers"
      system: "AMBIENT_SYSTEM_PROMPT — voice varies, no lore refs, signal-in-noise, 400+ char, 4-6 files"
      user_faction: "buildAmbientPrompt(ctx) — takes ONLY ctx and resolves the faction internally (serverContentService.ts:1316-1320); there is no factionKey parameter. Mundane themes, faction voice, news, easter eggs (30%)"
      user_independent: "buildAmbientPrompt(ctx) no faction — INDEPENDENT_SERVER_THEMES (14 types), quest seed (40%), news, easter eggs (30%)"
      output: "4-7 dirs, 4-6 files. Mundane workplace, personal notes, gossip, news, logs."
    }

    post_steps: [
      "Merge lorePlan + ambientPlan → single ServerContentPlan"
      "Fallback: generateRoleContent(ctx) or STATIC_CONTENT"
      "Plant faction secrets on matching role (financial→DB, operation→email, technical→gateway)"
      "generateEncodedFiles(ctx) — encoded credentials/keys/memos per role"
      "applyContentPlan() — create dirs + files ALWAYS Prisma-direct. applyContentPlanViaFileService() is DEAD CODE (zero callers, carries an @ts-expect-error TS6133). serverContentService.ts:2268-2286"
    ]
  }

  @ai_prompt_contracts {
    shared: "Prompts PREFER the provided real IPs/names but EXPLICITLY PERMIT invention — 'You MAY invent new IPs... auto-created as drafts' (serverContentService.ts:1068-1070, :1096-1097). Paths start /, content cap 3000 chars, must have directories[] + files[]"
    output: "{ directories: [{path, isHidden, isProtected}], files: [{path, content, isHidden, isEncrypted, isProtected}] }"
    fallback: "AI fail → role-based static templates with {placeholder} injection"
  }

  @role_content {
    note: "All role templates use 'peers' array (linkedServers with fallback to allNetworkServers excluding self). BUT the escape hatches survive: ls() falls back to the server's OWN name/ip/role when peers is empty (:619-623); generateEncodedFiles falls back to {name:'remote', ip:'0.0.0.0'} (:956); generateFactionSecrets has a 127.0.0.1 fallback (:204). Self-referencing and 0.0.0.0 IPs are still reachable."
    gateway: "Firewall rules (real peer IPs), ACLs (columns are ip, hostname, access_level, last_verified — NO employee names, :651-653), connection logs, network map"
    router: "Routing table (real peer IPs via dev ethN), interface status, traffic logs"
    database: "User tables (employees), SQL exports, query logs, backup credentials (other servers)"
    email: "Emails between employees (mention IPs), maintenance notices, drafts with secrets"
    workstation: "Personal notes (ref other servers), .ssh/config (real hostnames+IPs), browser history, bash history"
    firewall: "ACL rules (protected server IPs), IDS signatures, blocked logs, alerts"
    dns: "Zone files (hostname→real IP), reverse DNS, query cache"
  }

  @faction_secrets {
    types: {
      financial: "Revenue projections, off-books → DB servers"
      operation: "Attack plans, schedules → email"
      personnel: "Agent identities, undercover → workstations"
      technical: "Credentials, keys → gateway/firewall, and also database (e.g. dothackers .zero_days.stash, :304)"
      strategic: "Alliances, war plans → targetRole 'gateway'. There is no 'deep' or 'classified' role; both strategic secrets use gateway (:229-236, :321-327)"
      aida_fragment: "AIDA lore breadcrumbs → darknet only, targetRole 'database' (:311-319), hidden+encrypted. NOT any server."
    }
    intelligence_loop: "secrets → player explores → reads hidden file → FactionKnowledge.addEntry() → faction AI generates mission → player goes deeper → more secrets"
  }

  @content_variety {
    ratio: "DESIGN INTENT ONLY, not enforced: ~70% mundane/ambient, ~20% faction-relevant non-critical, ~10% genuinely important (lore, AIDA, strategic). No such constant or weighting exists anywhere in source."
    discovery_reward: "Thorough explorers find useful tidbits in noise — IP in passing, password in sticky note, gossip naming real operative. Signal-in-noise trains exploration."

    faction_coloring: {
      garrison: "Military-bureaucratic — duty rosters, requisitions, morale reports, fitness scores"
      dothackers: "Chaotic-personal — meme archives, mixtapes, philosophy rants, conspiracy threads"
      cybercorp: "Corporate-sterile — quarterly reports, synergy memos, satisfaction surveys, stock tickers"
      darknet: "Fragmented-eerie — corrupted logs, entries from nonexistent users, unsettling auto-poetry"
    }
  }

  @employee_rosters {
    description: "15 names each for garrison, cybercorp and dothackers; darknet has only 10 (worldLore.ts:156-166). Reused consistently across network — same 'Dr. Chen' in emails, DBs, workstations."
    garrison: ["Commander Steele" "Agent Voss" "Lt. Mora" "Sgt. Reeves" "Cpl. Park" "Major Blackwood" "..."]
    cybercorp: ["Dr. Sarah Chen" "Marcus Webb" "Yuki Tanaka" "R. Blackwell" "Elena Voss" "..."]
    dothackers: ["gh0st" "nullbyte" "sp1k3" "cr4sh" "z3r0day" "ph4ntom" "..."]
    darknet: ["[SIGNAL]" "[ECHO]" "[NULL]" "[VOID]" "[FRAGMENT]" "..."]
  }

  @passkey_auto_detection {
    flow: "Wired to DOWNLOAD, not read/cat. fileCommands.ts download path (:279, :407 — re-verified 2026-09-24) → detectAndGrantAccessKeys() queries servers with accessKey → content.includes(accessKey) → grantAccessKey(userId, serverId). FileService.readFile() NEVER calls it — source comment: 'Access key detection happens HERE (on download, not on cat)'."
    result: "Player can 'connect' without hacking — file content WAS key"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# MISSION SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@mission_system {
  description: "Template-constrained missions with AI narrative. Knowledge-aware targeting fills objectives with real server/file IDs. Network-depth scales difficulty."

  @objective_types {
    total: 37
    file: "server/src/services/missionObjectiveTypes.ts"

    @categories {
      action: ["hack (count)" "hack_target (boolean, serverId)" "hack_stealth (count)" "hack_method (count, method)" "gain_access (boolean, serverId+accessLevel)" "install_backdoor (boolean, serverId)"]
      file: ["steal (boolean, fileId)" "steal_count (count, serverId)" "upload_file (boolean, serverId)" "delete_file (boolean, fileId)" "download_file (boolean)"]
      social: ["message (count)" "contact_player (boolean, targetUserId)"]
      forum: ["forum_post (count)" "forum_reply (boolean, threadId)" "forum_interaction (count)"]
      exploration: ["explore (count)" "connect_server (boolean, serverId)" "discover_server_type (count, serverType)"]
      progression: ["skill_level (boolean, skillName+targetLevel)" "gain_xp (count)" "earn_credits (count)" "spend_credits (count)"]
      faction: ["join_faction (boolean)" "faction_choice (boolean — join or neutral)" "faction_reputation (count, factionId)" "faction_mission (count, factionId)"]
      network: ["infiltrate_network (boolean, networkId)" "trace_connection (boolean, serverId)" "exfiltrate_data (boolean, serverId+fileId)"]
      intel: ["report_intel (count — server/file/mission reports)"]
      bonus: ["claim_bounty (boolean)" "survive_trace (count)" "scan_subnet (count)"]
      defense: ["defend_home (boolean, defenseType)" "decode_content (boolean, encoding)"]
    }

    integration_hooks: "15 hooks (+onAccessGranted for breach_server/gain_access): onHackComplete (+install_backdoor), onFileOperation (+download_file, exfiltrate_data), onServerConnect (+infiltrate_network, trace_connection), onSkillUpdate, onCreditsTransaction, onFactionEvent (+faction_choice), onMessageSent, onForumActivity, onReportSubmitted (report_intel), onDecodeSuccess, onDefenseEvent, onBountyCompleted, onTraceEvaded, onSubnetUsed"
  }

  @templates {
    total: 39
    file: "server/src/services/missionTemplatePool.ts"

    @tiers {
      tier_1: "L1-5, D1-2 — 5 templates (first_blood, neighborhood_watch, message_runner, petty_theft, credit_hustle)"
      tier_2: "L5-15, D2-4 — 10 templates (silent_entry, data_heist, network_sweep, forum_operative, faction_recruit, xp_grinder, network_probe, data_extraction, home_fortification, network_cartographer)"
      tier_3: "L15-30, D4-6 — 10 templates (clean_sweep, chain_reaction, dead_drop, reputation_play, intel_gathering, credit_empire, deep_extraction, follow_the_trail, cipher_breaker, bounty_hunter)"
      tier_4: "L30-50, D6-8 — 8 templates (persistent_access, ghost_protocol, resource_war, double_agent, intelligence_sweep, surgical_strike, network_siege, ghost_run)"
      tier_5: "L50+, D8-10 — 6 templates (kingmaker, aida_trail, scorched_earth, zero_day, shadow_broker, endgame)"
    }

    reward_scaling: "RewardScaling { xp: {base, perLevel}, credits: {base, perLevel}, reputation?, skillPoints? } — final = base + perLevel * playerLevel"
    selection: "getEligibleTemplates(level, factionId?) → selectWeightedTemplate() — bell-curve bias toward level midpoint"
  }

  @generation_pipeline {
    file: "server/src/services/personaService.ts — generateDynamicMission()"
    steps: [
      "1. Find faction leader persona + faction profile (voice, themes, objectives, rewardBias)"
      "2. Load FactionKnowledge.getSnapshot(factionId) — known servers, files, players"
      "3. Estimate avg player level from faction members"
      "4. Select template via getEligibleTemplates() + selectWeightedTemplate()"
      "5. fillObjectivesFromKnowledge(template, snapshot) — fills IDs from known assets"
      "6. No known targets → fallback exploration objective"
      "7. computeRewards(template.rewards, level, factionBias) — 1.3x for preferred reward"
      "8. AI flavor: structured skeleton + KNOWN_TARGETS → AI returns title + description"
      "9. Validate: title ≤ 80 chars, description ≤ 500 chars. Fallback to template strings."
      "10. createMission() with real objectives, IDs, rewards"
    ]

    faction_profiles: {
      garrison: "voice: Military precision | themes: Defense, Patrol, Secure | bias: XP"
      dothackers: "voice: Anarchist leet-speak | themes: Expose, Leak, Liberate | bias: Reputation"
      cybercorp: "voice: Corporate calculated | themes: Acquisition, Intelligence | bias: Credits"
      darknet: "voice: Cryptic fragmented | themes: Signal, Fragment, Decode | bias: Unlocks"
    }
  }

  @tutorial_system {
    description: "Mail-driven mandatory tutorial. Architect (Game Master AI) guides via in-character emails. No 'tutorial' command — players interact by replying to training mails."
    service: "TutorialService (server/src/services/tutorialService.ts)"
    token: "TUTORIAL_SERVICE"

    @steps [
      "1. Terminal Basics — explore(3): connect 3 servers (connection challenges teach auth). 50 XP, 100c"
      "2. Data Recovery — download_file: download classified file from Training Archive. 75 XP, 150c"
      "3. Choose Your Path — faction_choice: join faction or remain neutral (faction leader recruitment emails). 100 XP, 250c"
      "4. Intel Delivery — report_intel(1): report file to a faction using report command. 75 XP, 150c"
      "5. Breach Protocol — hack(1): hack Training Firewall 10.10.10.30 (suggests backdoor). 100 XP, 200c"
      "6. Going Dark — forum_interaction(1): browse/post on a forum (mentions status/shop). 75 XP, 150c"
      "7. Graduation — earn_credits(200): earn credits via missions. 150 XP, 500c, 5 skill points"
    ]

    @flow [
      "1. Socket.IO connect → handleAuthentication() checks shouldStartTutorial()"
      "2. New player (no tutorial missions, level ≤ 5): startTutorial() creates step 1 + sends Architect mail"
      "3. Mission complete → mission:completed event → index.ts calls advanceTutorial()"
      "4. advanceTutorial() creates next step + mail. Step 3 also sends faction leader recruitment emails. After step 7: graduation mail."
      "5. Player replies to Architect → MessageService hook → tutorialService.handlePlayerReply() → AI hint"
    ]

    @context_filtering {
      checks: [
        "1. Recipient = Architect's AI account"
        "2. Message training-related (subject refs training mail or contains keywords)"
        "3. Sender has active tutorial mission"
        "4. All pass → AI in-character hint (ARCHITECT_SYSTEM_PROMPT: game-only responses)"
        "5. Any fail → silently ignored"
      ]
    }

    hooks: "Auto-start: handleAuthentication(). Advance: mission:completed listener. Reply: MessageService.onPrivateMessageSent → handlePlayerReply()"
    idempotent: "shouldStartTutorial returns false if tutorial missions exist"
  }

  @hardening {
    transaction_lock: "completeMission() uses prisma.$transaction"
    mission_cap: "Max 5 active per player"
    accept_states: "acceptMission() allows 'available' or 'assigned'"
    prerequisites: "Mission.prerequisiteTemplateIds (Json?) — checks completed prerequisites"
    bonus_objectives: "isBonus flag. Skipped in completion check. Each completed bonus +10% reward."
    expiration: "15-min interval checks, expires overdue"
    daily_generation: "Midnight CronJob: 3 missions/player for users active in last 7 days"
  }

  @commands {
    tutorial: "'tutorial [status|start|skip|hint]' — training progress panel with checklist, progress bar, mission info, hint"
    missions: "Lists grouped by status (ACTIVE → AVAILABLE → COMPLETED). Auto-generates when empty. Per-player index cached in-memory Map."
    mission: "'mission <id|N>' — full briefing: title, difficulty, type, issuer, rewards, time, description, per-objective progress"
    accept: "'accept <id|N>' — briefing, objectives with hints, time, rewards"
    abandon: "'abandon <id|N>' — confirms, warns faction rep penalty"
    progress: "Active missions with progress bars, time countdown"
    stories: "All player story arcs with status, faction, step progress"
    story: "'story <id>' — detailed step list. 'story abandon <id>' to abandon."
  }

  @story_arcs {
    description: "AI-driven multi-step narrative arcs. Faction leader plans 3-7 steps with branching on failure."
    service: "StoryMissionService (server/src/services/storyMissionService.ts)"
    schema: "StoryArc (id, title, description, factionId, issuedBy, assignedTo, status, currentStep, totalSteps, steps Json, narrativeContext Json, difficulty). Mission gains storyArcId + storyStep."

    @flow [
      "1. createStoryArc() — AI generates premise + step plan"
      "2. First step auto-created via generateStepMission()"
      "3. Complete/fail → missionService event → index.ts calls advanceStory()"
      "4. advanceStory() checks successBranch/failureBranch"
      "5. Success: next step with AI narrative referencing previous"
      "6. Failure with 'adapt': AI generates alternate step"
      "7. 'complete' → arc completed. 'fail' → arc failed."
    ]

    branching: "successBranch (next step # or 'complete'), failureBranch (step # skip, 'adapt' for AI alternate, 'fail' to end)"
    narrative_context: "Accumulates {premise, completedSteps[{step, outcome, summary}], playerLevel, factionName, leaderName}"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# DARKNET DUNGEON SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@darknet_dungeon_system {
  description: "Procedural dungeon generator. Creates ephemeral hidden server chains, hack through to vault with rewards. Auto-regenerates on conquest or expiry."
  file: "server/src/services/darknetDungeonService.ts (1545 lines)"
  token: "DARKNET_DUNGEON_SERVICE"

  @generation_pipeline {
    steps: [
      "1. generateDungeon(difficulty) — random name from prefix/suffix/code pools"
      "2. Difficulty-scaled depth 3-7 with escalating security. NOTE: 3-7 is the DEPTH, not the server count — the chain holds depth+1 = 4-8 servers (corrected 2026-09-24, independently confirmed by three audit slices)"
      "3. Passkey generation (XXX-XXX format)"
      "4. Weighted reward selection"
      "5. Unique IP allocation (collision-checked, RFC 5737)"
      "6. Network + GameServer chain, linear topology, darknet faction"
      "7. ServerLinks (chain with hidden link types)"
      "8. plantClueFiles() — hidden .signal/trace_N.dat per hop pointing to next IP. Beyond hop 2 = encrypted."
      "9. populateServerContent() — AI lore via DARKNET_SERVER_THEMES + CRYPTIC_QUOTES per depth"
      "10. plantVaultReward() — vault_payload.enc on final server"
      "11. DarkNetInstance record (7-day TTL)"
    ]
  }

  @rewards {
    aida_token: "AIDA Signal Fragment or Envoy's Cipher Token (weight 3/5)"
    rare_script: "zero_day_exploit + 10k credits (weight 4)"
    credits_cache: "25k credits (weight 6 — most common)"
    intel_package: "5000 XP + 2 skill points (weight 4)"
  }

  @forum_riddles {
    description: "postForumRiddle() — Architect AI posts cryptic puzzle with gateway IP + passkey in disguised forms"
  }

  @vault_conquest {
    trigger: "Player reads vault_payload.enc on final vault server"
    actions: ["Grant weighted random reward" "Record fragment_found to StoryLedger (weight 8)" "Fire system alert" "Auto-regenerate after 30s"]
  }

  @lifecycle {
    ensureActiveDungeon: "On startup, guarantees ≥1 active dungeon"
    expireOldDungeons: "7-day TTL cleanup"
    ORPHANED_CONSTANTS_WARNING: "Verified 2026-09-24. gameBalance.DUNGEON_TTL_DAYS (gameBalance.ts:315) and DUNGEON_REGEN_DELAY_MS (:318) have ZERO consumers — darknetDungeonService hardcodes 7*24*60*60*1000 at :382 and 30_000 at :865. Editing gameBalance silently does nothing; violates 'one definition per rule'. Also recorded: the comment at darknetDungeonService.ts:1265 claims content 'is generated in parallel for speed' directly above a strictly SEQUENTIAL for-loop (:1272-1273, awaits per server). The CODE is correct; the COMMENT lies."
    regeneration: "30s after conquest — teardown all, generate fresh + new riddle"
  }
}

