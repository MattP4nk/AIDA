# AIDA Project Knowledge Base
# Format: TOON (Token-Oriented Object Notation)
# Last Updated: 2026-08-08T00:00:00Z
# Purpose: Single source of truth — system reference + project status

@development_rules {
  rule_1: "Keep this file updated after each task — project's accurate index"
  rule_2: "Describes HOW SYSTEM WORKS, not change history — logs belong in git"
  rule_3: "When adding/modifying system, update relevant section to reflect current state"
  rule_4: "Minimal console logs (except tests). Use pino via @inject(LOGGER)."
  rule_5: "Update @last_updated with brief summary after every task"
}

@project {
  name: "AIDA - Advanced Intrusion Detection & Analysis"
  type: "Multiplayer Terminal Hacking Game"
  version: "1.0.0"
  status: "ACTIVE DEV — ERROR HANDLING + CONTENT PIPELINE HARDENING"

  @health {
    architecture: "A+"
    implementation: "A+"
    completeness: "97%"
    test_coverage: "0%"
    stability: "A+"
    security: "A"
  }
}

@technology_stack {
  backend: "Node.js 18+ / TypeScript ~5.9.3 / Express 4.18.2 / Socket.IO 4.8.1"
  database: "PostgreSQL 14+ / Prisma 5.22.0 (@prisma/client + CLI aligned)"
  di: "tsyringe 4.10.0 — all services @injectable(), singletons in container.ts"
  auth: "jsonwebtoken 9.0.2 + bcryptjs 2.4.3 + cookie-parser 1.4.7 — httpOnly cookie (primary) + Bearer header (fallback), 60s TTL auth cache (max 1000, 2min cleanup), per-JWT CSRF tokens"
  logging: "pino 10.1.0 + pino-pretty 13.1.2 — shared instance from logger.ts, injected via @inject(LOGGER)"
  caching: "Custom Map-based CacheService singleton — 60s default TTL, 60s cleanup interval, max 5000 entries with LRU-style eviction"
  ai: "Ollama REST /api/chat — model: nemotron-3-super:cloud (120B MoE, 12B active, 1.6s avg). 60s cloud / 120s local timeout. 3 retries with 429-aware backoff (5s/15s/45s for rate limits). Concurrency throttle: max 2 parallel requests. Agent loop: 24 tools for DB query + entity creation."
  frontend: "Svelte 5.39.6 / Vite 7.1.7 / Socket.IO Client 4.8.1 / TypeScript ~5.9.3"
  security: "helmet 8.0.0 (CSP: mediaSrc data:+blob: for sounds) / cors 2.8.5 (CORS_ORIGIN env parsed as comma-separated array) / express-rate-limit 7.1.5 / compression 1.7.4 / cookie-parser 1.4.7. Command regex strips $`&|<> (shell metacharacters). AI user lookup filters by @ai.aida.internal email."
  validation: "express-validator 7.0.1"
  scheduling: "cron 4.3.5"
  dev_runner: "tsx 4.6.2 (tsx watch for dev)"
  error_handling: "safeExecute (universal handler) + safeAI (AI-specific) + formatServerError (Prisma/JWT/GameError classifier) in server/src/utils/safeExecute.ts"

  @notes [
    "TypeScript and @types/node aligned across server and client (~5.9.3, ^24.6.0)"
    "redis 4.6.10 installed but unused (future session storage + distributed cache)"
    "morgan 1.10.0 alongside pino — morgan for HTTP, pino for app logging"
    "shared/handler.ts REMOVED — was from another project (Vue/SweetAlert2), unused by AIDA"
    "All 16 server test files REMOVED — were stale/void, no @types/jest installed"
  ]
}

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════════════

@architecture {
  principle: "Backend IS Console — client = dumb terminal, server handles all logic"

  @entry_points {
    server: "server/src/index.ts (231 lines) — thin orchestrator, wires DI + Socket.IO + Express + lifecycle"
    lifecycle: "server/src/lifecycle.ts (115 lines) — graceful shutdown (AI scheduler, resources, warfare, missions, CSRF, Socket.IO, HTTP)"
    di_container: "server/src/di/container.ts — setupContainer(io, prisma, logger) registers 51 tokens (48 services + 3 external deps) as singletons"
    di_tokens: "server/src/di/tokens.ts — 51 string token constants (added CONTENT_QUEUE_SERVICE)"
  }

  @request_flow {
    http: "Client → POST /api/command/execute {command, serverId?, terminalCols?} → asyncHandler → CommandProcessor → parse → validate → execute → formatOutput(terminalWidth) → respond"
    socket: "Client → 'command:execute' {command, args?, serverId?, terminalId?, terminalCols?} → same pipeline → 'command:result' back"
    auth: "httpOnly cookie (primary) or JWT in Authorization header (fallback) → authenticateToken middleware (60s cache, max 1000 entries, 2min cleanup) → req.userId. On page refresh: App.svelte always calls verifyToken() (cookie-based) to restore in-memory token."
    responsive_output: "Client sends terminalCols (measured from actual container width). Server sets context.terminalWidth (clamped 40-200, -2 safety margin). All panels/tables/boxes use context.terminalWidth. Post-processor (outputFormatter.ts) word-wraps plain text exceeding width. TERM_WIDTH=70 fallback."
  }

  @command_system {
    pattern: "CommandModule interface: commands Set<string>, execute(command, context), getCommandInfo()"
    context: "CommandContext: userId, role, db, fileService, io, gameStateManager, modules, services (all 20+ services)"
    skill_gating: "skillRequirements.ts — checkSkillRequirement() validates before execution, help filters by skill"
    formatting: "asciiBox.ts — shared box-drawing primitives (panel, table, statusCard, progressBar, etc.). TERM_WIDTH=70 default. table() accepts totalWidth param for auto-column-sizing. outputFormatter.ts post-processes all output for word-wrapping."
    total_commands: 106

    @modules {
      total: 16
      note: "GameCommands split into 4 focused modules. All modules registered in registry.ts."
      list: [
        "SystemCommands (11): ls, cd, pwd, cat, rm, mkdir, touch, cp, mv, echo, write"
        "NetworkCommands (10): scan, servers, connect, disconnect, traceroute, probe, netmap, handshake.ack, signal.trace, connect.abort"
        "HackCommands (17): hack, crack, exploit, backdoor, rootkit, crack.submit, firewall.knock, memory.extract, hack.hint, hack.status, hack.abort, backdoor.list, backdoor.use, backdoor.remove, security.scan, trace.status, trace.evade"
        "FileCommands (5): upload, download (process-based, copies to ~/downloads/, triggers key detection), encrypt, decrypt, analyze"
        "DefenseCommands (5): defenses, protect, safevault, honeypot, upgrade"
        "SocialCommands (7): msg, mail, inbox, contact, chat, forum, proxy"
        "ShopCommands (9): shop, buy, sell, use, equip, unequip, equipment, gear, scripts"
        "MissionCommands (7): missions, mission, accept, abandon, progress, stories, story (owns missionIndex Map + resolveMissionId)"
        "FragmentCommands (3): fragment/fragments (view/give/steal), endgame"
        "PlayerInfoCommands (11): status, skills, players, who, whois, share_intel, bounties, bounty, leaderboard, achievements, report"
        "HelpCommands (4): help, man, history, stats"
        "ProcessCommands (8): ps, top, kill, pkill, nice, renice, free, uptime"
        "MathCommands (10): calc, expr, math, vars, set, unset, convert (hex/bin/dec/oct + physical units), random, decode (xor/caesar/rot13/base64/ascii/hex), subnet (CIDR)"
        "FactionCommands (1+12 subs): faction list|join|leave|status|missions|rank|promote|standings|resources|servers|contest|war"
        "AliasCommands (1+4 subs): alias create|destroy|info|reveal"
        "AdminCommands (1+14 subs): admin status|players|whois|audit|kick|mute|unmute|ban|unban|setrole|broadcast|cleanup|servers|resetpassword"
      ]
    }

    @skill_requirements {
      total_gated: 33
      hacking: "hack(20), crack(30), exploit(40), backdoor(50), rootkit(60), backdoor.list(15)"
      networking: "scan(5), probe(10), traceroute(15), protect(15), subnet(10), proxy(10), handshake.ack(5), signal.trace(5)"
      cryptography: "crack.submit(5), encrypt(10), decrypt(15), safevault(20), decode(10)"
      stealth: "backdoor.use(20), backdoor.remove(15), trace.evade(25), honeypot(25)"
      forensics: "memory.extract(5), security.scan(15), analyze(10)"
      social_engineering: "forum(5), share_intel(10), alias:create(15), alias:reveal(20)"
    }
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# ERROR HANDLING ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════════════

@error_handling {
  description: "Three-layer universal error handling system inspired by ejecutarSeguro pattern. All errors go through centralized formatters with structured logging."
  file: "server/src/utils/safeExecute.ts"

  @layer_1_safeExecute {
    description: "Factory that wraps ANY async function with centralized error handling, logging, and fallback."
    pattern: "safeExecute({ fn, context, logger, fallback?, silent?, rethrow?, onError?, onSuccess? })"
    return_type: "With fallback → Promise<TResult> (guaranteed). Without → Promise<TResult | undefined>"
    logging: "silent=true → debug level. silent=false → error level. Always logs via pino."
    usage_count: "184+ calls across 24 service files"
    replaces: "~161 manual try/catch blocks"
  }

  @layer_2_safeAI {
    description: "AI-specific wrapper combining generateOrThrow + validateOrRetry + safeExecute + retry queue."
    pattern: "safeAI({ aiService, prompt, systemPrompt, expectedFormat, validate, fallback, context, logger, jsonType?, retry?, onRetrySuccess? })"
    flow: "generateOrThrow() → validateOrRetry() → return validated OR fallback + optional retry queue"
    usage_count: "41+ calls across 13 service files"
    replaces: "Manual if (!result.success) + validateOrRetry + queueForRetry blocks"
    ai_method: "aiService.generateOrThrow() — wraps generateResponse(), throws on failure instead of returning success=false"
  }

  @layer_3_formatServerError {
    description: "Error classifier used by global Express error handler. Detects Prisma, JWT, GameError, generic errors."
    detects: [
      "Prisma unique constraint (P2002) → 409 UNIQUE_CONSTRAINT"
      "Prisma not found (P2025) → 404 NOT_FOUND"
      "Prisma foreign key (P2003) → 409 FOREIGN_KEY"
      "Prisma invalid invocation → 400 INVALID_QUERY"
      "Prisma schema errors → 500 SCHEMA_ERROR"
      "DB connection errors → 503 DB_CONNECTION"
      "Timeouts → 504 TIMEOUT"
      "JWT errors → 401 AUTH_EXPIRED"
      "GameError subclasses → statusCode from error"
      "Generic → 500 INTERNAL_ERROR"
    ]
    global_handler: "setup.ts setupErrorHandling() — ALL errors (including unhandled Prisma) get clean client-safe JSON response"
  }

  @route_handling {
    pattern: "asyncHandler(async (req, res) => { ... throw new GameError(...) }) — no try/catch needed"
    file: "server/src/middleware/setup.ts — asyncHandler() + setupErrorHandling()"
    coverage: "ALL 52 route handlers across auth.ts, command.ts, 8 admin API files"
    error_classes: "GameError (base), ValidationError (400), AuthorizationError (403), NotFoundError (404), RateLimitError (429) — all in shared/types.ts"
  }

  @command_handling {
    pattern: "successResult(output, data?) / errorResult(output, error?) — factory functions"
    file: "server/src/services/commandModules/helpers.ts"
    coverage: "ALL 16 command modules use these helpers"
  }

  @ai_fallbacks {
    file: "server/src/utils/aiFallbacks.ts"
    functions: [
      "fallbackWelcomeMessage(faction, player) — faction-specific welcome template"
      "fallbackDepartureMessage(faction, username) — faction-specific departure"
      "fallbackPromotionMessage(faction, rank) — faction-specific promotion"
      "fallbackPersonaReply(persona, faction) — in-character reply template"
      "fallbackForumPost(faction, author) — mundane forum post"
      "fallbackActionDecision(personaType) — weighted persona action"
      "fallbackMissionFlavor(title, faction) — template mission title+description"
      "fallbackStoryStep(title) — template narrative step"
      "fallbackRecruitmentDM() — darknet recruitment message"
    ]
    coverage: "ALL 32 AI generateResponse calls have fallbacks (was 16 with none before)"
  }

  @typed_constants {
    file: "shared/types.ts"
    constants: [
      "DraftStatus: draft | approved | rejected | applied"
      "EpochStatus: draft | active | completed"
      "ReservedPID: HACK_CHALLENGE=-1, CONNECTION_CHALLENGE=-2"
      "FactionEventType: join | leave | neutral"
    ]
    pattern: "as const objects with companion types — compatible with Prisma string queries"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT GENERATION QUEUE
# ═══════════════════════════════════════════════════════════════════════════════

@content_queue {
  description: "Event-driven queue that replaced all fire-and-forget content provisioning. Jobs persist to DB, process sequentially, retry with backoff, notify players."
  file: "server/src/services/contentQueueService.ts"
  token: "CONTENT_QUEUE_SERVICE"
  model: "ContentJob (content_jobs table) — serverId, priority, status, attempts, maxAttempts, error, requestedBy, options, completedAt"

  @priority_levels {
    URGENT: "1 — player actively connecting, needs content NOW"
    NORMAL: "5 — pre-warm from scan, server creation, draft approval"
    LOW: "10 — startup batch, background enrichment"
  }

  @processing {
    interval: "5-second poll"
    concurrency: "Sequential — one job at a time (respects AI concurrency)"
    retry: "Exponential backoff: 5s × 2^attempt, max 3 attempts"
    deduplication: "By serverId — upgrades priority if more urgent request arrives"
    persistence: "Jobs survive restarts — rehydrated from DB on start()"
    cleanup: "Completed/failed jobs deleted after 24 hours"
    file_count_check: "Only counts type='file' (not directories) against threshold of 12"
  }

  @trigger_points [
    "1. Server startup — enqueueAllUnpopulated() for servers with fileCount ≤ 8 (LOW, skipAI)"
    "2. Server creation — serverService.createServer() enqueues NORMAL"
    "3. Scan discovery — networkCommands scan pre-warms discovered servers (NORMAL)"
    "4. Connect challenge — first visit enqueues URGENT during puzzle"
    "5. Connect completion — ensureReady() blocks up to 30s or proceeds with partial content"
    "6. Draft approval — contentDraftService approves server draft (NORMAL)"
  ]

  @connect_flow {
    description: "ensureReady(serverId, userId) — fast-path if content exists, else enqueue URGENT + wait"
    timeout: "30 seconds max wait, then connect anyway with partial content"
    waiter_pattern: "Multiple callers on same serverId attach to same job, all resolved on completion"
    notification: "Socket.IO 'command:result' → '[System] Server filesystem loaded.'"
  }

  @replaces [
    "ALL direct provisionServerContent() calls — zero remaining outside the queue"
    "Fire-and-forget .catch(() => {}) pattern — all errors now logged + retried"
    "In-memory aiEnrichedServers Set — DB persistence instead"
    "provisionAllUnpopulatedServers() — replaced by enqueueAllUnpopulated()"
  ]
}

# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK TOPOLOGY SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@network_topology {
  description: "Servers form explorable graph networks. Players hack through gateways → routers → internal servers. Private servers discovered through file content. Access requires hacking or passkeys."

  @data_model {
    Network: "Named grouping of linked servers (e.g. 'CyberCorp Internal'). Fields: id, name (unique), description, factionId, zone, isHidden, metadata (Json)"
    ServerLink: "Directed edge between servers. Fields: id, sourceId, targetId, networkId, linkType (lan|wan|vpn|backbone|hidden), bandwidth, latency, isActive, requiredAccess. @@unique(sourceId, targetId)"
    DiscoveredLink: "Per-player fog of war. Fields: id, userId, linkId, discoveredAt, source (scan|probe|traceroute|backdoor|mission). @@unique(userId, linkId)"
    ServerAccessKey: "Per-player passkey storage. Fields: id, userId, serverId, keyValue, source (file_read|mission_reward|shared|purchased), sourceDetail, sourceFileId, discoveredAt. @@unique(userId, serverId)"
  }

  @gameserver_fields {
    role: "gateway | router | workstation | database | email | firewall | dns | general"
    networkId: "FK to Network"
    isPublic: "true = visible in scan, false = must find IP in file content"
    accessMethod: "open | hackable | keycard | hack_or_key"
    accessKey: "Passkey string — when player reads file containing this string, auto-gains access"
  }

  @service {
    file: "server/src/services/networkTopologyService.ts"
    token: "NETWORK_TOPOLOGY_SERVICE"

    @methods {
      getAdjacentServers: "All linked servers (bidirectional), cached 30s"
      canTraverse: "Link exists A→B, active, player access meets requiredAccess"
      resolveBackdoorBypass: "Active backdoor on target skips adjacency"
      findPath: "BFS shortest path — used by traceroute, cached 30s"
      discoverNeighbors: "Topology scan: public adjacent servers, creates DiscoveredLink, feeds FactionKnowledge"
      discoverPath: "Auto-discovers all links along path (traceroute)"
      getPlayerTopology: "Discovered subgraph (nodes + edges) up to N hops for netmap"
      checkServerAccess: "Enforces accessMethod: owner/home bypass, open, hackable, keycard, hack_or_key"
      playerHasAccessKey: "Checks ServerAccessKey for userId+serverId"
      grantAccessKey: "Upserts ServerAccessKey — called by FileService on credential discovery"
      createBidirectionalLink: "Two ServerLink records (A→B and B→A)"
      createHomeLink: "Links player home to Internet Exchange via 'wan'"
      getNetworkDepth: "BFS hop count from Internet Exchange — for mission difficulty scaling"
    }
  }

  @traversal_rules [
    "1. Home always reachable — 'connect home'/'disconnect' works anywhere (VPN tunnel)"
    "2. Active backdoor bypasses topology — direct jump"
    "3. Otherwise, must have ServerLink from current to target"
    "4. Links have requiredAccess — player access level on source must meet it"
    "5. After adjacency, accessMethod enforced: open/hackable/keycard/hack_or_key"
    "6. Private servers (isPublic=false) hidden from scan — find IP in file content"
  ]

  @commands {
    scan: "Discovers adjacent PUBLIC servers. Shows IP, NAME, ROLE, SECURITY, ACCESS, LINK TYPE. Private hidden."
    connect: "Enforces adjacency → access method → connection challenge (if needed) → connects. 'connect home' always works. Backdoors bypass. First visit always shows challenge."
    disconnect: "Returns home. DiscoveredLink records persist."
    traceroute: "BFS real path. Server names, IPs, roles, latencies. Undiscovered hops = ?.?.?.?. Auto-discovers links."
    probe: "Server role, network, security, access method, link count. networking ≥ 30 + adjacent → shows linked names."
    netmap: "Tree visualization of discovered topology. Box-drawing chars. Depth-limited (default 2, -d deeper)."
  }

  @seeded_networks {
    internet_exchange: "10.0.0.1 [router, open] — backbone hub linking all faction gateways + training + player homes"

    training_network: {
      zone: "training (10.10.10.x)"
      servers: 5
      description: "Safe practice network. All public + open, security 1. No hack required."
      structure: [
        "[Gateway] Training Gateway 10.10.10.1 sec:1 — public, open"
        "  ├─[Workstation] Training Terminal 10.10.10.10 sec:1"
        "  │   └─[Database] Training Archive 10.10.10.20 sec:1 (cross-linked, has /data/classified/faction_overview.doc)"
        "  ├─[Email] Training Comms 10.10.10.11 sec:1"
        "  └─[Firewall] Training Firewall 10.10.10.30 sec:2 (hackable — tutorial step 5)"
      ]
      purpose: "Tutorial steps 1-5 (explore, download, faction, report, hack). Static tutorial content."
    }

    garrison_defense_grid: {
      zone: "government (192.168.1.x)"
      servers: 8
      structure: [
        "[Gateway] garrison-gw 192.168.1.1 sec:8 fw:9 — public, hackable"
        "  ├─[Firewall] garrison-fw 192.168.1.2 sec:9 — private, hack_or_key (GRN-FW-*)"
        "  │   ├─[Workstation] garrison-ops 192.168.1.10 sec:6 — private, hack_or_key"
        "  │   └─[Email] garrison-mail 192.168.1.11 sec:5 — private, hack_or_key"
        "  ├─[Router] garrison-core 192.168.1.3 sec:7 — private, hackable"
