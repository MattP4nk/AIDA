    "192.168.x.x": "Government / Garrison (defense grid, sec:5-10)"
    "198.51.100.x": "Phantom Network (rogue, sec:4-6)"
    "203.0.113.x": "DarkNet (hidden, sec:5-10)"
    resolver: "resolveTopologyFromIP() in referenceValidationService.ts — maps IP → network, faction, gateway, security, link type"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# ADMIN SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@admin_system {
  description: "Full CRUD admin panel for world-building. REST API + web panel served at /admin."
  auth: "requireRole('admin') — role hierarchy: player(0) → moderator(1) → admin(2)"

  @api_routes {
    base: "/api/admin"
    router: "server/src/routes/adminApi.ts → mounts 8 sub-routers. All endpoints use asyncHandler + GameError. PUT routes allowlist fields (no raw req.body to Prisma)."
    sub_routers: [
      "servers.ts — CRUD + files + links (8 endpoints)"
      "networks.ts — CRUD (5 endpoints)"
      "missions.ts — CRUD (5 endpoints)"
      "forums.ts — CRUD + posts (6 endpoints)"
      "epochs.ts — CRUD + events + activate/fire (11 endpoints)"
      "drafts.ts — list + approve/reject (5 endpoints)"
      "stats.ts — dashboard aggregates (1 endpoint)"
      "players.ts — view + modify progress/role (4 endpoints)"
    ]
    total_endpoints: 45
  }

  @content_drafts {
    model: "ContentDraft — type, title, payload (Json), source, status (draft→approved→applied)"
    service: "ContentDraftService (server/src/services/contentDraftService.ts)"
    token: "CONTENT_DRAFT_SERVICE"
    purpose: "AI-created content goes through admin review before publishing to game world"
    types: ["server", "file", "link", "mission", "forum_post", "network", "forum"]
    sources: ["ai_content", "architect", "admin", "epoch_event"]
    approve_flow: "approveDraft(id) → executeDraftPayload(type, payload) → creates GameServer/FileSystemNode/ServerLink/Mission/Post/Forum/Network → sets resultId"
  }

  @reference_validation {
    service: "ReferenceValidationService (server/src/services/referenceValidationService.ts)"
    token: "REFERENCE_VALIDATION_SERVICE"
    purpose: "Ensures AI content references real IPs/URLs. Auto-creates ContentDrafts for missing entities."
    topology_resolver: "resolveTopologyFromIP() maps IP ranges → network, faction, gateway, security, link type"
    methods: [
      "validateAndBackfillReferences(content, source) — scans for IPs/URLs, creates drafts for missing ones + link drafts"
      "generateInvestigationChain(serverId, depth, theme) — uses AI agent loop to create multi-step clue trails"
    ]
    admin_endpoint: "POST /api/admin/servers/:id/investigation-chain"
  }

  @ai_agent_tools {
    file: "server/src/services/aiAgentTools.ts"
    purpose: "Tool-use system letting AI query AND create game entities mid-conversation. AI can look up real data, react to player activity, and invent new world content."
    loop: "runAgentLoop(aiService, prisma, systemPrompt, userPrompt, logger, maxRounds=6)"
    flow: "AI receives tool list → responds with {tool, params} → server executes query → AI gets results → continues or gives {final: true, result: ...}. Max 5 tool calls per request."
    total_tools: 24

    @query_tools_world [
      "get_networks — all networks + server counts"
      "get_servers — servers filtered by network/faction/type"
      "get_server_details — full info + files + links"
      "get_ip_ranges — IP range conventions per zone"
      "search_files — search file content across servers"
    ]

    @query_tools_factions [
      "get_factions — factions + members + leaders"
      "get_faction_knowledge — faction intel DB (what they know)"
      "get_active_wars — ongoing faction conflicts"
      "get_censorship_rules — monitored/banned topics per faction"
    ]

    @query_tools_story [
      "get_recent_events — story ledger events"
      "get_current_epoch — active epoch + events"
      "get_story_arcs — ongoing narrative threads"
      "get_key_fragments — AIDA endgame artifact status"
      "get_ai_personas — NPC personalities + system prompts"
    ]

    @query_tools_social [
      "get_forums — forums + post counts"
      "get_forum_posts — posts from a specific forum"
      "get_players — active players + levels + factions"
      "get_shop_items — available tools/software/upgrades"
    ]

    @query_tools_activity [
      "get_player_activity — specific player's hacks, missions, skills"
      "get_recent_hack_activity — who's hacking what across the game"
      "get_active_backdoors — persistent access across servers"
      "get_server_access_keys — discovered keys per server"
    ]

    @creation_tools [
      "create_server — invent new server (auto-linked to gateway via IP range topology)"
      "create_network — invent new network"
      "create_file — plant file on any server (clues, evidence, logs)"
      "create_link — connect two servers"
      "create_forum_post — post on any forum (rumors, intel, propaganda)"
    ]
    creation_note: "All creations go through ContentDraft → admin reviews before publishing"

    @integration {
      world_topology: "enrichWithTopology(basePrompt, prisma, logger) in worldTopologyContext.ts — shared helper used by all AI services to inject real game IPs/servers/networks into prompts. Cached 5 min."
      agent_loop_services: [
        "serverContentService — lore + ambient file generation (with fallback to direct call)"
        "storyProgressionService — Architect evaluation"
        "personaActionService — director + faction leader decisions"
        "referenceValidationService — investigation chain generation"
      ]
      topology_context_services: [
        "personaService — welcome/departure/promotion/war messages"
        "personaMissionGenService — mission flavor text"
        "storyMissionService — story arc generation"
        "forumService — AI forum replies + NPC posts"
        "darknetDungeonService — dungeon riddles + lore files"
        "missionGenerator — daily mission descriptions"
      ]
      no_context_services: [
        "tutorialService — Architect hints (tutorial-scoped)"
        "messageService — persona replies (conversational)"
        "darknetDiscoveryService — AIDA riddles (self-contained)"
      ]
    }
  }

  @epochs {
    model: "NarrativeEpoch (extended) — status (draft/active/completed), order, description"
    events_model: "EpochEvent — triggerType (scheduled/manual/condition), payload, status"
    scheduler: "EpochSchedulerService (server/src/services/epochSchedulerService.ts) — 1-min interval"
    token: "EPOCH_SCHEDULER_SERVICE"
    purpose: "Named story phases with scheduled events. Admin controls macro timeline."
    event_actions: ["create_draft", "architect_intervention", "world_event", "advance_epoch", "toggle_feature"]
    flow: "Scheduler checks every 60s → finds pending events with scheduledAt <= now in active epoch → fireEvent() executes payload action"
  }

  @panel {
    location: "server/public/admin/"
    serving: "Express static at /admin (setup.ts)"
    tech: "Plain HTML/CSS/JS, dark terminal theme, no build step"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# CONNECTION CHALLENGE SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@connection_challenge {
  description: "Minigame shown when connecting to servers. Masks AI content provisioning latency while adding gameplay. Two challenge types selected by server context."

  @trigger_rules {
    home_server: "Always instant — no challenge"
    first_visit: "ALWAYS challenge (AI content provisions in background during puzzle)"
    revisit_with_backdoor: "Skip challenge — backdoor bypasses auth"
    revisit_security_1_2: "Instant — no challenge"
    revisit_security_3_5: "Simple challenge"
    revisit_security_6_plus: "Harder challenge"
  }

  @challenge_types {
    handshake: {
      trigger: "Structured networks (garrison, cybercorp, corporate, government)"
      description: "TCP-style SYN/ACK puzzle. Player sees table of SYN packets with SEQ, PORT, FLAGS, WINDOW."
      task: "Identify valid SYN packets (non-RST, window > 0), calculate ACK = SEQ + 1, submit in ascending port order."
      command: "handshake.ack <ack1> <ack2> ..."
      difficulty_scaling: "Easy (3 packets, 2 real), Medium (5 packets, 3 real), Hard (7 packets, 4 real)"
    }

    signal_trace: {
      trigger: "Chaotic networks (darknet, dothackers, underground)"
      description: "Hex grid puzzle. Signal starts at marked cell, follows fixed hex increment pattern through adjacent cells."
      task: "Trace the signal path from origin through N hops, identify endpoint cell."
      command: "signal.trace <cell>  (e.g. C4)"
      difficulty_scaling: "Easy (4x6 grid, 3 hops), Medium (5x8 grid, 4 hops), Hard (6x10 grid, 5 hops + noise)"
    }
  }

  @difficulty {
    formula: "base = securityLevel (clamped 1-8), reduction = networkingSkill / 50, final = clamp(1-10, base - reduction)"
    skill_bonuses: "networking ≥ 30 → extra hint (valid services for handshake, second signal cell for trace)"
    tiers: "1-3 = easy, 4-6 = medium, 7-10 = hard"
  }

  @files {
    generator: "server/src/services/connectionChallengeGenerator.ts — pure module (no DI): generateHandshakeChallenge(), generateSignalTraceChallenge(), validateConnectionAnswer(), selectChallengeType()"
    service: "server/src/services/connectionChallengeService.ts — DI singleton: shouldChallenge(), initiateChallenge(), submitAnswer(), session tracking + expiry timers"
    token: "CONNECTION_CHALLENGE_SERVICE"
    config: "server/src/config/gameBalance.ts — HANDSHAKE_CONFIG, SIGNAL_TRACE_CONFIG, CONNECTION_CHALLENGE_SKIP_THRESHOLD"
    types: "shared/types.ts — ConnectionChallengeType, ConnectionChallenge, ConnectionSessionInfo"
  }

  @flow [
    "1. Player types 'connect <ip>'"
    "2. networkCommands.handleConnect() validates topology + access"
    "3. connectionChallengeService.shouldChallenge() checks trigger rules"
    "4. If needed: initiateChallenge() generates puzzle, starts expiry timer"
    "5. Content queued via ContentQueueService.enqueue(serverId, URGENT) — processes during puzzle"
    "6. Challenge displayed in client sticky panel (cyan/blue theme)"
    "7. Player submits via 'handshake.ack' or 'signal.trace'"
    "8. On success: contentQueue.ensureReady() waits up to 30s for content"
    "9. completeConnection() runs standard connect flow"
    "10. On failure/timeout: player must re-run 'connect' for new challenge"
    "11. First-ever challenge triggers Architect briefing mail (one-time)"
  ]

  @architect_briefing {
    trigger: "First connection challenge per player (checked via DB + in-memory set)"
    sender: "The Architect (game_master persona)"
    subject: "Network Security Protocols"
    content: "Explains both challenge types with step-by-step instructions, commands, and tips"
  }

  @client {
    store: "activeConnectionSession (socket.ts) — mirrors activeHackSession pattern"
    panel: "Terminal.svelte — sticky connection-challenge-panel with cyan theme, shows displayText + hints"
    events: "command:result data.connectionSessionId triggers panel, data.connectionResolved clears it"
  }

  @commands {
    "handshake.ack": "Submit ACK sequence for TCP handshake challenge (networking 5)"
    "signal.trace": "Submit endpoint cell for signal trace challenge (networking 5)"
    "connect.abort": "Cancel active connection challenge (ungated)"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# WORLD LORE
# ═══════════════════════════════════════════════════════════════════════════════

@world_lore {
  description: "Canonical source of truth for game narrative. All AI prompts, personas, content generators consume these constants."
  file: "server/src/lore/worldLore.ts (~1138 lines)"

  @exports {
    WORLD_BACKSTORY: "Full backstory (~60 lines): Emperor, AIDA creation, 100-year reign, Shattering, four faction motivations"
    WORLD_BACKSTORY_SHORT: "Condensed for token-limited AI prompts"
    FACTION_LORE: "Per-faction backstory (garrison, dothackers, cybercorp, darknet)"
    FACTION_VOICE: "Writing style/tone per faction for AI content generation"
    FACTION_FILE_FLAVORS: "Per-faction file name patterns, topics, hidden file hints for ServerContentService"
    AIDA_PIECES: "3 AIDA fragments — Sword (offensive capacity), Key (infiltration capacity), Collar (control program binding AIDA). Each with 6 loreHints."
    EMPEROR_LORE: "Extended Emperor backstory"
    LOCATIONS: "Lore entries: NetSlum (underground market), Silver Tower (CyberCorp HQ), Deep Grid (infra), DarkNet (hidden layer)"
    DARKNET_SERVER_THEMES: "5 depth-tiered theme configs (gateway/early/middle/deep/vault) for dungeon content"
    CRYPTIC_QUOTES: "24 atmospheric one-liners for clues, forums, dungeons"
    FACTION_MUNDANE_THEMES: "Per-faction mundane content (workFiles, personalFiles, gossip, ambientLogs) — servers feel inhabited"
    INDEPENDENT_SERVER_THEMES: "14 themed profiles for non-faction servers: trade_hub, news_relay, personal_terminal, retired_hacker, medical, university, entertainment, abandoned, freelancer, black_market, isp, dead_drop, religious, pirate_radio"
    AMBIENT_NEWS_POOL: "24 network-wide headlines for background flavor"
    EASTER_EGG_POOL: "16 rare fun/absurd file descriptions. 30% chance per server."
  }

  @narrative_core {
    premise: "AIDA = sentient AI shattered into 3 pieces (Sword, Key, Collar) by Emperor. 4 factions compete to find/prevent reassembly. Architect observes + guides from shadows."
    factions: {
      garrison: "Government/military — contain AIDA, maintain order"
      dothackers: "Anarchist hackers — free AIDA, expose corruption"
      cybercorp: "Corporate — weaponize AIDA for profit/power"
      darknet: "Hidden faction led by AIDA — inscrutable objectives"
    }
    key_figures: ["Emperor (AIDA creator)" "Architect (game master AI)" "AIDA (shattered sentient AI)" "Commander Steele (Garrison)" "gh0st (dotHackers)" "Director Chen (CyberCorp)"]
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONTENT ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

@content_engine {
  description: "Two-process AI content gen. Process 1 (Lore): serious/dark/enigmatic, 2-4 faction-critical files 400+ chars — faction servers only. Process 2 (Ambient): voice varies, 4-6 mundane files 400+ chars — all servers. Both independent, results merged. Static fallback when both fail."
  file: "server/src/services/serverContentService.ts"
  token: "SERVER_CONTENT_SERVICE"

  @generation_pipeline {
    overview: "provisionServerContent(serverId) runs two-tier pipeline: Tier 1 (static, awaited) + Tier 2 (AI enrichment, background). Called ONLY via ContentQueueService — never fire-and-forget."
    steps: [
      "1. ContentQueueService.enqueue(serverId, priority) — persistent DB job"
      "2. Queue processes job → provisionServerContent(serverId, options)"
      "3. buildNetworkContext(server) — queries links, network, faction, generates roster + secrets"
      "4. resolveFactionKey(ctx) — determines faction (garrison/dothackers/cybercorp/darknet)"
    ]

    @process_1_lore {
      trigger: "Faction servers only"
      system: "LORE_SYSTEM_PROMPT — serious/dark/enigmatic, backstory context, AIDA pieces, 400+ char, 2-4 files"
      user: "buildLorePrompt(ctx) — faction lore+voice, file patterns, topic, hidden seed, quote, AIDA hint, role instructions"
      output: "2-4 dirs, 2-4 files (1+ hidden). Classified docs, transmissions, memos, confessions."
    }

    @process_2_ambient {
      trigger: "All servers"
      system: "AMBIENT_SYSTEM_PROMPT — voice varies, no lore refs, signal-in-noise, 400+ char, 4-6 files"
      user_faction: "buildAmbientPrompt(ctx) + factionKey — mundane themes, faction voice, news, easter eggs (30%)"
      user_independent: "buildAmbientPrompt(ctx) no faction — INDEPENDENT_SERVER_THEMES (14 types), quest seed (40%), news, easter eggs (30%)"
      output: "4-7 dirs, 4-6 files. Mundane workplace, personal notes, gossip, news, logs."
    }

    post_steps: [
      "Merge lorePlan + ambientPlan → single ServerContentPlan"
      "Fallback: generateRoleContent(ctx) or STATIC_CONTENT"
      "Plant faction secrets on matching role (financial→DB, operation→email, technical→gateway)"
      "generateEncodedFiles(ctx) — encoded credentials/keys/memos per role"
      "applyContentPlan() — create dirs + files via FileService (Prisma-direct fallback)"
    ]
  }

  @ai_prompt_contracts {
    shared: "Reference only provided IPs/names, paths start /, content cap 3000 chars, must have directories[] + files[]"
    output: "{ directories: [{path, isHidden, isProtected}], files: [{path, content, isHidden, isEncrypted, isProtected}] }"
    fallback: "AI fail → role-based static templates with {placeholder} injection"
  }

  @role_content {
    note: "All role templates use 'peers' array (linkedServers with fallback to allNetworkServers excluding self). No more 0.0.0.0 or self-referencing IPs."
    gateway: "Firewall rules (real peer IPs), ACLs (employee names), connection logs, network map"
    router: "Routing table (real peer IPs via dev ethN), interface status, traffic logs"
    database: "User tables (employees), SQL exports, query logs, backup credentials (other servers)"
    email: "Emails between employees (mention IPs), maintenance notices, drafts with secrets"
    workstation: "Personal notes (ref other servers), .ssh/config (real hostnames+IPs), browser history, bash history"
    firewall: "ACL rules (protected server IPs), IDS signatures, blocked logs, alerts"
    dns: "Zone files (hostname→real IP), reverse DNS, query cache"
  }

  @faction_secrets {
    types: {
      financial: "Revenue projections, off-books → DB servers"
      operation: "Attack plans, schedules → email"
      personnel: "Agent identities, undercover → workstations"
      technical: "Credentials, keys → gateway/firewall"
      strategic: "Alliances, war plans → deep/classified"
      aida_fragment: "AIDA lore breadcrumbs → any server, hidden+encrypted"
    }
    intelligence_loop: "secrets → player explores → reads hidden file → FactionKnowledge.addEntry() → faction AI generates mission → player goes deeper → more secrets"
  }

  @content_variety {
    ratio: "~70% mundane/ambient, ~20% faction-relevant non-critical, ~10% genuinely important (lore, AIDA, strategic)"
    discovery_reward: "Thorough explorers find useful tidbits in noise — IP in passing, password in sticky note, gossip naming real operative. Signal-in-noise trains exploration."

    faction_coloring: {
      garrison: "Military-bureaucratic — duty rosters, requisitions, morale reports, fitness scores"
      dothackers: "Chaotic-personal — meme archives, mixtapes, philosophy rants, conspiracy threads"
      cybercorp: "Corporate-sterile — quarterly reports, synergy memos, satisfaction surveys, stock tickers"
      darknet: "Fragmented-eerie — corrupted logs, entries from nonexistent users, unsettling auto-poetry"
    }
  }

  @employee_rosters {
    description: "15 names per faction, reused consistently across network. Same 'Dr. Chen' in emails, DBs, workstations."
    garrison: ["Commander Steele" "Agent Voss" "Lt. Mora" "Sgt. Reeves" "Cpl. Park" "Major Blackwood" "..."]
    cybercorp: ["Dr. Sarah Chen" "Marcus Webb" "Yuki Tanaka" "R. Blackwell" "Elena Voss" "..."]
    dothackers: ["gh0st" "nullbyte" "sp1k3" "cr4sh" "z3r0day" "ph4ntom" "..."]
    darknet: ["[SIGNAL]" "[ECHO]" "[NULL]" "[VOID]" "[FRAGMENT]" "..."]
  }

  @passkey_auto_detection {
    flow: "FileService.readFile() → content returned → detectAndGrantAccessKeys() queries servers with accessKey → content.includes(accessKey) → grantAccessKey(userId, serverId)"
    result: "Player can 'connect' without hacking — file content WAS key"
  }
}

# ═══════════════════════════════════════════════════════════════════════════════
# MISSION SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

@mission_system {
  description: "Template-constrained missions with AI narrative. Knowledge-aware targeting fills objectives with real server/file IDs. Network-depth scales difficulty."

  @objective_types {
    total: 36
    file: "server/src/services/missionObjectiveTypes.ts"

    @categories {
      action: ["hack (count)" "hack_target (boolean, serverId)" "hack_stealth (count)" "hack_method (count, method)" "gain_access (boolean, serverId+accessLevel)" "install_backdoor (boolean, serverId)"]
      file: ["steal (boolean, fileId)" "steal_count (count, serverId)" "upload_file (boolean, serverId)" "delete_file (boolean, fileId)" "download_file (boolean)"]
      social: ["message (count)" "contact_player (boolean, targetUserId)"]
      forum: ["forum_post (count)" "forum_reply (boolean, threadId)" "forum_interaction (count)"]
      exploration: ["explore (count)" "connect_server (boolean, serverId)" "discover_server_type (count, serverType)"]
      progression: ["skill_level (boolean, skillName+targetLevel)" "gain_xp (count)" "earn_credits (count)" "spend_credits (count)"]
      faction: ["join_faction (boolean)" "faction_choice (boolean — join or neutral)" "faction_reputation (count, factionId)" "faction_mission (count, factionId)"]
      network: ["infiltrate_network (boolean, networkId)" "trace_connection (boolean, serverId)" "exfiltrate_data (boolean, serverId+fileId)"]
      intel: ["report_intel (count — server/file/mission reports)"]
      bonus: ["claim_bounty (boolean)" "survive_trace (count)" "scan_subnet (count)"]
      defense: ["defend_home (boolean, defenseType)" "decode_content (boolean, encoding)"]
    }

    integration_hooks: "14 hooks: onHackComplete (+install_backdoor), onFileOperation (+download_file, exfiltrate_data), onServerConnect (+infiltrate_network, trace_connection), onSkillUpdate, onCreditsTransaction, onFactionEvent (+faction_choice), onMessageSent, onForumActivity, onReportSubmitted (report_intel), onDecodeSuccess, onDefenseEvent, onBountyCompleted, onTraceEvaded, onSubnetUsed"
  }

  @templates {
    total: 39
    file: "server/src/services/missionTemplatePool.ts"

    @tiers {
      tier_1: "L1-5, D1-2 — 5 templates (first_blood, neighborhood_watch, message_runner, petty_theft, credit_hustle)"
      tier_2: "L5-15, D2-4 — 10 templates (silent_entry, data_heist, network_sweep, forum_operative, faction_recruit, xp_grinder, network_probe, data_extraction, home_fortification, network_cartographer)"
      tier_3: "L15-30, D4-6 — 10 templates (clean_sweep, chain_reaction, dead_drop, reputation_play, intel_gathering, credit_empire, deep_extraction, follow_the_trail, cipher_breaker, bounty_hunter)"
      tier_4: "L30-50, D6-8 — 8 templates (persistent_access, ghost_protocol, resource_war, double_agent, intelligence_sweep, surgical_strike, network_siege, ghost_run)"
      tier_5: "L50+, D8-10 — 6 templates (kingmaker, aida_trail, scorched_earth, zero_day, shadow_broker, endgame)"
    }

    reward_scaling: "RewardScaling { xp: {base, perLevel}, credits: {base, perLevel}, reputation?, skillPoints? } — final = base + perLevel * playerLevel"
    selection: "getEligibleTemplates(level, factionId?) → selectWeightedTemplate() — bell-curve bias toward level midpoint"
  }

  @generation_pipeline {
    file: "server/src/services/personaService.ts — generateDynamicMission()"
    steps: [
      "1. Find faction leader persona + faction profile (voice, themes, objectives, rewardBias)"
      "2. Load FactionKnowledge.getSnapshot(factionId) — known servers, files, players"
      "3. Estimate avg player level from faction members"
      "4. Select template via getEligibleTemplates() + selectWeightedTemplate()"
      "5. fillObjectivesFromKnowledge(template, snapshot) — fills IDs from known assets"
      "6. No known targets → fallback exploration objective"
      "7. computeRewards(template.rewards, level, factionBias) — 1.3x for preferred reward"
      "8. AI flavor: structured skeleton + KNOWN_TARGETS → AI returns title + description"
      "9. Validate: title ≤ 80 chars, description ≤ 500 chars. Fallback to template strings."
      "10. createMission() with real objectives, IDs, rewards"
    ]

    faction_profiles: {
      garrison: "voice: Military precision | themes: Defense, Patrol, Secure | bias: XP"
      dothackers: "voice: Anarchist leet-speak | themes: Expose, Leak, Liberate | bias: Reputation"
      cybercorp: "voice: Corporate calculated | themes: Acquisition, Intelligence | bias: Credits"
      darknet: "voice: Cryptic fragmented | themes: Signal, Fragment, Decode | bias: Unlocks"
    }
  }

  @tutorial_system {
    description: "Mail-driven mandatory tutorial. Architect (Game Master AI) guides via in-character emails. No 'tutorial' command — players interact by replying to training mails."
    service: "TutorialService (server/src/services/tutorialService.ts)"
    token: "TUTORIAL_SERVICE"

    @steps [
      "1. Terminal Basics — explore(3): connect 3 servers (connection challenges teach auth). 50 XP, 100c"
      "2. Data Recovery — download_file: download classified file from Training Archive. 75 XP, 150c"
      "3. Choose Your Path — faction_choice: join faction or remain neutral (faction leader recruitment emails). 100 XP, 250c"
      "4. Intel Delivery — report_intel(1): report file to a faction using report command. 75 XP, 150c"
      "5. Breach Protocol — hack(1): hack Training Firewall 10.10.10.30 (suggests backdoor). 100 XP, 200c"
      "6. Going Dark — forum_interaction(1): browse/post on a forum (mentions status/shop). 75 XP, 150c"
      "7. Graduation — earn_credits(200): earn credits via missions. 150 XP, 500c, 5 skill points"
    ]

    @flow [
      "1. Socket.IO connect → handleAuthentication() checks shouldStartTutorial()"
      "2. New player (no tutorial missions, level ≤ 5): startTutorial() creates step 1 + sends Architect mail"
      "3. Mission complete → mission:completed event → index.ts calls advanceTutorial()"
      "4. advanceTutorial() creates next step + mail. Step 3 also sends faction leader recruitment emails. After step 7: graduation mail."
      "5. Player replies to Architect → MessageService hook → tutorialService.handlePlayerReply() → AI hint"
    ]

    @context_filtering {
      checks: [
        "1. Recipient = Architect's AI account"
        "2. Message training-related (subject refs training mail or contains keywords)"
        "3. Sender has active tutorial mission"
        "4. All pass → AI in-character hint (ARCHITECT_SYSTEM_PROMPT: game-only responses)"
        "5. Any fail → silently ignored"
      ]
    }

    hooks: "Auto-start: handleAuthentication(). Advance: mission:completed listener. Reply: MessageService.onPrivateMessageSent → handlePlayerReply()"
    idempotent: "shouldStartTutorial returns false if tutorial missions exist"
  }

  @hardening {
    transaction_lock: "completeMission() uses prisma.$transaction"
    mission_cap: "Max 5 active per player"
    accept_states: "acceptMission() allows 'available' or 'assigned'"
    prerequisites: "Mission.prerequisiteTemplateIds (Json?) — checks completed prerequisites"
    bonus_objectives: "isBonus flag. Skipped in completion check. Each completed bonus +10% reward."
    expiration: "15-min interval checks, expires overdue"
    daily_generation: "Midnight CronJob: 3 missions/player for users active in last 7 days"
  }

  @commands {
    tutorial: "'tutorial [status|start|skip|hint]' — training progress panel with checklist, progress bar, mission info, hint"
    missions: "Lists grouped by status (ACTIVE → AVAILABLE → COMPLETED). Auto-generates when empty. Per-player index cached in-memory Map."
    mission: "'mission <id|N>' — full briefing: title, difficulty, type, issuer, rewards, time, description, per-objective progress"
    accept: "'accept <id|N>' — briefing, objectives with hints, time, rewards"
    abandon: "'abandon <id|N>' — confirms, warns faction rep penalty"
    progress: "Active missions with progress bars, time countdown"
    stories: "All player story arcs with status, faction, step progress"
    story: "'story <id>' — detailed step list. 'story abandon <id>' to abandon."
  }

  @story_arcs {
    description: "AI-driven multi-step narrative arcs. Faction leader plans 3-7 steps with branching on failure."
    service: "StoryMissionService (server/src/services/storyMissionService.ts)"
    schema: "StoryArc (id, title, description, factionId, issuedBy, assignedTo, status, currentStep, totalSteps, steps Json, narrativeContext Json, difficulty). Mission gains storyArcId + storyStep."

    @flow [
      "1. createStoryArc() — AI generates premise + step plan"
      "2. First step auto-created via generateStepMission()"
      "3. Complete/fail → missionService event → index.ts calls advanceStory()"
      "4. advanceStory() checks successBranch/failureBranch"
      "5. Success: next step with AI narrative referencing previous"
      "6. Failure with 'adapt': AI generates alternate step"
      "7. 'complete' → arc completed. 'fail' → arc failed."
    ]

    branching: "successBranch (next step # or 'complete'), failureBranch (step # skip, 'adapt' for AI alternate, 'fail' to end)"
    narrative_context: "Accumulates {premise, completedSteps[{step, outcome, summary}], playerLevel, factionName, leaderName}"
  }
}

